# Demo de math builtins en Zen v2.0
muestra "=== Math Demo ==="

muestra f"raiz(16) = {raiz(16)}"
muestra f"potencia(2, 10) = {potencia(2, 10)}"
muestra f"max(3, 7) = {max(3, 7)}"
muestra f"min(3, 7) = {min(3, 7)}"
muestra f"limitar(15, 0, 10) = {limitar(15, 0, 10)}"
muestra f"interpolar(0, 100, 0.5) = {interpolar(0, 100, 0.5)}"
muestra f"distancia(0, 0, 3, 4) = {distancia(0, 0, 3, 4)}"
muestra f"grados(3.14159) = {grados(3.14159)}"
muestra f"radianes(180) = {radianes(180)}"
muestra f"entero(3.7) = {entero(3.7)}"
muestra f"signo(-5) = {signo(-5)}"
muestra f"abs(-42) = {abs(-42)}"
muestra f"piso(3.7) = {piso(3.7)}"
muestra f"techo(3.2) = {techo(3.2)}"
muestra f"redondear(3.5) = {redondear(3.5)}"
muestra f"aleatorio(1, 100) = {aleatorio(1, 100)}"
muestra f"seno(0) = {seno(0)}"
muestra f"coseno(0) = {coseno(0)}"
