# builtins.zen — Builtins de Zen (stubs para futura migracion a Zen)
#
# NOTA IMPORTANTE:
#   Los builtins (muestra, longitud, numero, texto, leer_archivo, argv, etc.)
#   estan implementados NATIVAMENTE en el codegen C++ (codegen.cpp).
#   NO se pueden redefinir aqui porque el codegen los maneja por nombre.
#
#   Este archivo existe para que, conforme Zen sobre Zen madure, los builtins
#   se vayan migrando a Zen puro usando FFI a libc/libm.
#
#   Por ahora solo declaramos los FFI externs que otros modulos puedan necesitar.

# ============================================================
# FFI a libc (algunos modulos pueden necesitar estos externs)
# ============================================================

extern "libc" printf(str) -> int
extern "libc" strlen(str) -> int
extern "libc" puts(str) -> int
extern "libc" exit(int) -> void
extern "libc" fopen(str, str) -> ptr
extern "libc" fclose(ptr) -> int
extern "libc" fread(ptr, int, int, ptr) -> int
extern "libc" fwrite(ptr, int, int, ptr) -> int
extern "libc" fseek(ptr, int, int) -> int
extern "libc" ftell(ptr) -> int
extern "libc" time(ptr) -> int
extern "libc" rand() -> int
extern "libc" srand(int) -> void
extern "libc" system(str) -> int

# ============================================================
# FFI a libm
# ============================================================

extern "libm" sqrt(double) -> double
extern "libm" sin(double) -> double
extern "libm" cos(double) -> double
extern "libm" pow(double, double) -> double
extern "libm" floor(double) -> double
extern "libm" ceil(double) -> double
extern "libm" fabs(double) -> double

# Builtins nativos del codegen (NO redefinir aqui):
