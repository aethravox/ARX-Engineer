# codegen.zen — Generador de codigo LLVM IR de Zen escrito EN Zen
#
# 1:1 con codegen.cpp del C++. Mismos builtins, mismo type tracking,
# misma generacion de IR.
#
# Modulo: funciones codegen_* que toman el AST y producen LLVM IR.
# Importa: ast (structs Nodo)

importar "ast"

