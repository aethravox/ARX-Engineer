# ============================================================
# Estado de codegen (modulo-level)
# ============================================================

# Stack de (break_bb, continue_bb) para bucles anidados
loop_end_bb = 0
loop_cond_bb = 0
loop_stack_break = []   # lista de ptrs
loop_stack_cont = []    # lista de ptrs

# Type tracking: despues de llamar codegen_expresion, esto contiene
# el tipo del ultimo valor retornado (TIPO_NUMBER, TIPO_STRING, etc.)
last_expr_type = 0

# Registry de structs (1:1 con std::map<std::string, StructInfo> de C++)
struct_nombres = []   # lista de nombres de struct
struct_campos = []    # lista de listas de nombres de campos

# Registry de variables (scope actual)
var_nombres = []      # lista de nombres
var_ptrs = []         # lista de alloca/global ptrs (LLVMValueRef)
var_tipos = []        # lista de tipos (TIPO_*)

# Registry de funciones de usuario
func_nombres = []     # lista de nombres
func_ptrs = []        # lista de function ptrs

# Registry de externs declarados en el source
extern_nombres = []   # lista de nombres
extern_ptrs = []      # lista de function ptrs

# Funcion actual (para break/continue/ret saber dónde están)
current_func = 0

# ============================================================
# Helpers
# ============================================================

funcion estado_modulo(e)
    retorna e.modulo

funcion estado_builder(e)
    retorna e.builder

funcion i8ptr_type()
    retorna LLVMPointerType(LLVMInt8Type(), 0)

funcion i8ptrptr_type()
    retorna LLVMPointerType(i8ptr_type(), 0)

# ============================================================
# Type conversion helpers (1:1 con C++ toDouble/toString/toBool)
# ============================================================

# Convertir cualquier valor a double (i8* -> strtod; i1 -> uitofp)
funcion to_double_val(estado, val, tipo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    si tipo == TIPO_NUMBER
        retorna val
    si tipo == TIPO_BOOL
        retorna LLVMBuildUIToFP(b, val, LLVMDoubleType(), "tof")
    si tipo == TIPO_STRING
        # Si es i8*, usar zen_strtod_safe (no crashea con NULL)
        strtod_fn = LLVMGetNamedFunction(mod, "zen_strtod_safe")
        si strtod_fn == 0
            i8p = i8ptr_type()
            fty = zen_function_type_1(LLVMDoubleType(), i8p, 0)
            strtod_fn = LLVMAddFunction(mod, "zen_strtod_safe", fty)
        retorna zen_call1(b, strtod_fn, val, "s2d")
    retorna zen_constreal(LLVMDoubleType(), 0)

# Convertir cualquier valor a i8* (string)
# Numbers -> __zen_num_to_str; Bool -> "yes"/"no"; Null -> "nada"
funcion to_string_val(estado, val, tipo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    # Si ya es i8*, retornar tal cual
    si tipo == TIPO_STRING
        retorna val
    si tipo == TIPO_NUMBER
        num_str_fn = LLVMGetNamedFunction(mod, "__zen_num_to_str")
        retorna zen_call1(b, num_str_fn, val, "numstr")
    si tipo == TIPO_BOOL
        # Boxear como "1"/"0" (no "yes"/"no") para que strtod funcione:
        # strtod("1")=1.0=verdad, strtod("0")=0.0=falso
        one_str = LLVMConstString("1", 1, 0)
        one_g = LLVMAddGlobal(mod, LLVMInt8Type(), ".b1")
        LLVMSetInitializer(one_g, one_str)
        LLVMSetGlobalConstant(one_g, 1)
        LLVMSetLinkage(one_g, 0)
        zero_str = LLVMConstString("0", 1, 0)
        zero_g = LLVMAddGlobal(mod, LLVMInt8Type(), ".b0")
        LLVMSetInitializer(zero_g, zero_str)
        LLVMSetGlobalConstant(zero_g, 1)
        LLVMSetLinkage(zero_g, 0)
        one_ptr = LLVMBuildBitCast(b, one_g, i8ptr_type(), "b1ptr")
        zero_ptr = LLVMBuildBitCast(b, zero_g, i8ptr_type(), "b0ptr")
        retorna LLVMBuildSelect(b, val, one_ptr, zero_ptr, "boolstr")
    si tipo == TIPO_NULL
        nada_str = LLVMConstString("nada", 4, 0)
        nada_g = LLVMAddGlobal(mod, LLVMInt8Type(), ".nada")
        LLVMSetInitializer(nada_g, nada_str)
        LLVMSetGlobalConstant(nada_g, 1)
        LLVMSetLinkage(nada_g, 0)
        retorna LLVMBuildBitCast(b, nada_g, i8ptr_type(), "nadaptr")
    retorna val

# Convertir cualquier valor a i1 (bool)
funcion to_bool_val(estado, val, tipo)
    b = estado_builder(estado)
    si tipo == TIPO_BOOL
        retorna val
    si tipo == TIPO_NUMBER
        zero = zen_constreal(LLVMDoubleType(), 0)
        retorna LLVMBuildFCmp(b, 4, val, zero, "tobool")
    si tipo == TIPO_STRING
        nullp = LLVMConstPointerNull(i8ptr_type())
        retorna LLVMBuildICmp(b, 32, val, nullp, "tobool")
    retorna LLVMConstInt(LLVMInt1Type(), 0, 0)


# Helper para manejar el loop stack (break/continue)
# Usa un approach de save/restore porque Zen no tiene quitar_ultimo en listas
funcion push_loop(break_bb, cont_bb)
    agregar(loop_stack_break, break_bb)
    agregar(loop_stack_cont, cont_bb)
    retorna 0

funcion pop_loop()
    # Reconstruir la lista sin el ultimo elemento
    n = longitud(loop_stack_break)
    si n == 0
        retorna 0
    nueva_break = []
    nueva_cont = []
    i = 0
    mientras i < n - 1
        agregar(nueva_break, loop_stack_break[i])
        agregar(nueva_cont, loop_stack_cont[i])
        i = i + 1
    loop_stack_break = nueva_break
    loop_stack_cont = nueva_cont
    retorna 0

# ============================================================
# Init / Finalize
# ============================================================

funcion codegen_init()
    estado = CodeGenState {modulo: 0, builder: 0}
    estado.modulo = LLVMModuleCreateWithName("zen")
    estado.builder = LLVMCreateBuilder()
    codegen_declarar_runtime(estado)
    retorna estado

# Declarar las funciones runtime y libc que se usaran (printf, strlen, etc.)
# Estas son las mismas que codegen.cpp::declareExterns()
funcion codegen_declarar_runtime(estado)
    mod = estado_modulo(estado)
    i8p = i8ptr_type()
    i32t = LLVMInt32Type()
    i64t = LLVMInt64Type()
    voidt = LLVMVoidType()
    # printf(const char*, ...) -> int  (variadic!)
    # zen_function_type_1(retTy, paramTys, isVarArg)
    # Como no podemos pasar array de tipos facil, usamos LLVMAddFunction directo
    # con un LLVMFunctionType que tenga 1 param y isVarArg=1
    printf_ty = zen_function_type_1(i32t, i8p, 1)
    LLVMAddFunction(mod, "printf", printf_ty)
    # strlen(const char*) -> size_t (i64 en Linux)
    strlen_ty = zen_function_type_1(i64t, i8p, 0)
    LLVMAddFunction(mod, "strlen", strlen_ty)
    # strcmp(const char*, const char*) -> int
    strcmp_ty = zen_function_type_2(i32t, i8p, i8p, 0)
    LLVMAddFunction(mod, "strcmp", strcmp_ty)
    # strstr(const char*, const char*) -> char*
    strstr_ty = zen_function_type_2(i8p, i8p, i8p, 0)
    LLVMAddFunction(mod, "strstr", strstr_ty)
    # strncpy(char*, const char*, size_t) -> char*
    strncpy_ty = zen_function_type_3(i8p, i8p, i8p, i64t, 0)
    LLVMAddFunction(mod, "strncpy", strncpy_ty)
    # memcpy(void*, const void*, size_t) -> void*
    memcpy_ty = zen_function_type_3(i8p, i8p, i8p, i64t, 0)
    LLVMAddFunction(mod, "memcpy", memcpy_ty)
    # malloc(size_t) -> void*
    malloc_ty = zen_function_type_1(i8p, i64t, 0)
    LLVMAddFunction(mod, "malloc", malloc_ty)
    # fopen(const char*, const char*) -> FILE*
    fopen_ty = zen_function_type_2(i8p, i8p, i8p, 0)
    LLVMAddFunction(mod, "fopen", fopen_ty)
    # fclose(FILE*) -> int
    fclose_ty = zen_function_type_1(i32t, i8p, 0)
    LLVMAddFunction(mod, "fclose", fclose_ty)
    # fread(void*, size_t, size_t, FILE*) -> size_t
    fread_ty = zen_function_type_4(i64t, i8p, i64t, i64t, i8p, 0)
    LLVMAddFunction(mod, "fread", fread_ty)
    # fwrite(const void*, size_t, size_t, FILE*) -> size_t
    fwrite_ty = zen_function_type_4(i64t, i8p, i64t, i64t, i8p, 0)
    LLVMAddFunction(mod, "fwrite", fwrite_ty)
    # fseek(FILE*, long, int) -> int
    fseek_ty = zen_function_type_3(i32t, i8p, i64t, i32t, 0)
    LLVMAddFunction(mod, "fseek", fseek_ty)
    # ftell(FILE*) -> long
    ftell_ty = zen_function_type_1(i64t, i8p, 0)
    LLVMAddFunction(mod, "ftell", ftell_ty)
    # exit(int) -> void
    exit_ty = zen_function_type_1(voidt, i32t, 0)
    LLVMAddFunction(mod, "exit", exit_ty)
    # system(const char*) -> int
    system_ty = zen_function_type_1(i32t, i8p, 0)
    LLVMAddFunction(mod, "system", system_ty)
    # strtod(const char*, char**) -> double
    i8pp = LLVMPointerType(i8p, 0)
    strtod_ty = zen_function_type_2(LLVMDoubleType(), i8p, i8pp, 0)
    LLVMAddFunction(mod, "strtod", strtod_ty)
    # pow(double, double) -> double (libm)
    pow_ty = zen_function_type_2(LLVMDoubleType(), LLVMDoubleType(), LLVMDoubleType(), 0)
    LLVMAddFunction(mod, "pow", pow_ty)
    # sqrt, sin, cos, floor, ceil, fabs, round, tan (libm)
    math_ty = zen_function_type_1(LLVMDoubleType(), LLVMDoubleType(), 0)
    LLVMAddFunction(mod, "sqrt", math_ty)
    LLVMAddFunction(mod, "sin", math_ty)
    LLVMAddFunction(mod, "cos", math_ty)
    LLVMAddFunction(mod, "floor", math_ty)
    LLVMAddFunction(mod, "ceil", math_ty)
    LLVMAddFunction(mod, "fabs", math_ty)
    LLVMAddFunction(mod, "round", math_ty)
    LLVMAddFunction(mod, "tan", math_ty)
    # atan2(double, double) -> double
    atan2_ty = zen_function_type_2(LLVMDoubleType(), LLVMDoubleType(), LLVMDoubleType(), 0)
    LLVMAddFunction(mod, "atan2", atan2_ty)
    # rand() -> int
    rand_ty = zen_function_type_0(i32t, 0)
    LLVMAddFunction(mod, "rand", rand_ty)
    # srand(unsigned int) -> void
    srand_ty = zen_function_type_1(voidt, i32t, 0)
    LLVMAddFunction(mod, "srand", srand_ty)
    # time(NULL) -> time_t (i64)
    i64p = LLVMPointerType(i64t, 0)
    time_ty = zen_function_type_1(i64t, i64p, 0)
    LLVMAddFunction(mod, "time", time_ty)
    # usleep(useconds_t) -> int
    usleep_ty = zen_function_type_1(i32t, i32t, 0)
    LLVMAddFunction(mod, "usleep", usleep_ty)
    # free(void*) -> void
    free_ty = zen_function_type_1(voidt, i8p, 0)
    LLVMAddFunction(mod, "free", free_ty)
    # getchar() -> int
    getchar_ty = zen_function_type_0(i32t, 0)
    LLVMAddFunction(mod, "getchar", getchar_ty)
    # snprintf(char*, size_t, const char*, ...) -> int (variadic)
    snprintf_ty = zen_function_type_3(i32t, i8p, i64t, i8p, 1)
    LLVMAddFunction(mod, "snprintf", snprintf_ty)
    # Runtime de Zen (declarados como external)
    # __zen_num_to_str(double) -> char*
    nts_ty = zen_function_type_1(i8p, LLVMDoubleType(), 0)
    LLVMAddFunction(mod, "__zen_num_to_str", nts_ty)
    # zen_concat(char*, char*) -> char*
    concat_ty = zen_function_type_2(i8p, i8p, i8p, 0)
    LLVMAddFunction(mod, "zen_concat", concat_ty)
    # __zen_list_create(i64) -> ptr
    lc_ty = zen_function_type_1(i8p, i64t, 0)
    LLVMAddFunction(mod, "__zen_list_create", lc_ty)
    # __zen_list_push(ptr, ptr) -> void
    lp_ty = zen_function_type_2(voidt, i8p, i8p, 0)
    LLVMAddFunction(mod, "__zen_list_push", lp_ty)
    # __zen_list_get(ptr, i64) -> ptr
    lg_ty = zen_function_type_2(i8p, i8p, i64t, 0)
    LLVMAddFunction(mod, "__zen_list_get", lg_ty)
    # __zen_list_set(ptr, i64, ptr) -> void
    ls_ty = zen_function_type_3(voidt, i8p, i64t, i8p, 0)
    LLVMAddFunction(mod, "__zen_list_set", ls_ty)
    # __zen_list_len(ptr) -> i64
    ll_ty = zen_function_type_1(i64t, i8p, 0)
    LLVMAddFunction(mod, "__zen_list_len", ll_ty)
    # __zen_list_contains(ptr, ptr) -> i1
    lhc_ty = zen_function_type_2(LLVMInt1Type(), i8p, i8p, 0)
    LLVMAddFunction(mod, "__zen_list_contains", lhc_ty)
    # __zen_list_pop(ptr) -> ptr
    lpop_ty = zen_function_type_1(i8p, i8p, 0)
    LLVMAddFunction(mod, "__zen_list_pop", lpop_ty)
    # __zen_struct_create(i64) -> ptr
    sc_ty = zen_function_type_1(i8p, i64t, 0)
    LLVMAddFunction(mod, "__zen_struct_create", sc_ty)
    # __zen_struct_get(ptr, i64) -> ptr
    sg_ty = zen_function_type_2(i8p, i8p, i64t, 0)
    LLVMAddFunction(mod, "__zen_struct_get", sg_ty)
    # __zen_struct_set(ptr, i64, ptr) -> void
    ss_ty = zen_function_type_3(voidt, i8p, i64t, i8p, 0)
    LLVMAddFunction(mod, "__zen_struct_set", ss_ty)
    # toupper(int) -> int, tolower(int) -> int
    toupper_ty = zen_function_type_1(i32t, i32t, 0)
    LLVMAddFunction(mod, "toupper", toupper_ty)
    LLVMAddFunction(mod, "tolower", toupper_ty)
    retorna 0

funcion codegen_finalize(estado)
    LLVMDisposeBuilder(estado_builder(estado))
    LLVMDisposeModule(estado_modulo(estado))
    retorna 0

# ============================================================
# Struct registry helpers
# ============================================================

funcion registrar_struct(nombre, campos)
    agregar(struct_nombres, nombre)
    agregar(struct_campos, campos)
    retorna 0

# Busca el indice de un campo por nombre en todos los structs registrados
# Retorna -1 si no encuentra (1:1 con C++ generateMemberAccess)
funcion buscar_indice_campo(campo)
    # NULL check defensivo
    si zen_is_null(campo) == "1"
        retorna -1
    n = longitud(struct_nombres)
    i = 0
    mientras i < n
        campos = struct_campos[i]
        m = longitud(campos)
        j = 0
        mientras j < m
            c = campos[j]
            si zen_is_null(c) == "0"
                si c == campo
                    retorna j
            j = j + 1
        i = i + 1
    retorna -1

# ============================================================
# Variable scope helpers
# ============================================================

funcion buscar_variable(nombre)
    # NULL check defensivo
    si zen_is_null(nombre) == "1"
        retorna -1
    n = longitud(var_nombres)
    i = 0
    mientras i < n
        v = var_nombres[i]
        si zen_is_null(v) == "0"
            si v == nombre
                retorna i
        i = i + 1
    retorna -1

# Crear o reusar una variable global (para nivel superior)
# Todas las variables son i8* (boxed) — igual que el runtime
funcion get_o_crear_global(estado, nombre)
    # NULL check defensivo
    si zen_is_null(nombre) == "1"
        retorna LLVMConstPointerNull(i8ptr_type())
    mod = estado_modulo(estado)
    # Buscar global existente
    gvar = LLVMGetNamedGlobal(mod, "g_" + nombre)
    si zen_is_null(gvar) == "0"
        retorna gvar
    # Crear nueva
    i8p = i8ptr_type()
    nullp = LLVMConstPointerNull(i8p)
    g = LLVMAddGlobal(mod, i8p, "g_" + nombre)
    LLVMSetInitializer(g, nullp)
    LLVMSetLinkage(g, 0)
    retorna g

# ============================================================
# Codegen de expresiones (1:1 con C++ generateExpr)
# ============================================================


# ============================================================
# Helper: verificar si el bloque actual ya tiene terminator
# (evita agregar br despues de un ret/br/break/continue)
# ============================================================
funcion bloque_actual_tiene_terminator(b)
    bb = LLVMGetInsertBlock(b)
    si zen_is_null(bb) == "1"
        retorna falso
    term = LLVMGetBasicBlockTerminator(bb)
    si zen_is_null(term) == "1"
        retorna falso
    retorna verdad

funcion codegen_expresion(estado, nodo)
    si zen_is_null(nodo) == "1"
        last_expr_type = TIPO_NULL
        retorna LLVMConstPointerNull(i8ptr_type())
    tipo = nodo_tipo(nodo)
    si zen_is_null(tipo) == "1"
        last_expr_type = TIPO_NULL
        retorna LLVMConstPointerNull(i8ptr_type())
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    # NODO_NUMBER
    si tipo == NODO_NUMBER
        val_str = nodo_valor(nodo)
        last_expr_type = TIPO_NUMBER
        retorna zen_constreal(LLVMDoubleType(), numero(val_str))
    # NODO_STRING
    si tipo == NODO_STRING
        str_val = nodo_valor(nodo)
        cstr = LLVMConstString(str_val, 0, 0)
        gvar = LLVMAddGlobal(mod, LLVMInt8Type(), ".str")
        LLVMSetInitializer(gvar, cstr)
        LLVMSetGlobalConstant(gvar, 1)
        LLVMSetLinkage(gvar, 0)
        last_expr_type = TIPO_STRING
        retorna LLVMBuildBitCast(b, gvar, i8ptr_type(), "strptr")
    # NODO_BOOL
    si tipo == NODO_BOOL
        val_str = nodo_valor(nodo)
        si val_str == "verdad" o val_str == "yes" o val_str == "true"
            last_expr_type = TIPO_BOOL
            retorna LLVMConstInt(LLVMInt1Type(), 1, 0)
        last_expr_type = TIPO_BOOL
        retorna LLVMConstInt(LLVMInt1Type(), 0, 0)
    # NODO_NULL
    si tipo == NODO_NULL
        last_expr_type = TIPO_NULL
        retorna LLVMConstPointerNull(i8ptr_type())
    # NODO_IDENTIFIER
    si tipo == NODO_IDENTIFIER
        nombre = nodo_valor(nodo)
        # Buscar en scope local
        idx = buscar_variable(nombre)
        si idx >= 0
            var_ptr = var_ptrs[idx]
            var_ty = var_tipos[idx]
            si var_ty == TIPO_NUMBER
                dval = LLVMBuildLoad(b, var_ptr, nombre)
                last_expr_type = TIPO_NUMBER
                retorna dval
            si var_ty == TIPO_BOOL
                bval = LLVMBuildLoad(b, var_ptr, nombre)
                last_expr_type = TIPO_BOOL
                retorna bval
            # i8*
            sval = LLVMBuildLoad(b, var_ptr, nombre)
            last_expr_type = TIPO_STRING
            retorna sval
        # Buscar global
        gvar = LLVMGetNamedGlobal(mod, "g_" + nombre)
        si zen_is_null(gvar) == "0"
            sval = LLVMBuildLoad(b, gvar, nombre)
            last_expr_type = TIPO_STRING
            retorna sval
        # Variable no encontrada
        muestra "ERROR: Variable '" + nombre + "' no definida en linea " + texto(nodo_linea(nodo))
        salir(1)
    # NODO_BINARY_OP
    si tipo == NODO_BINARY_OP
        retorna codegen_binary_op(estado, nodo)
    # NODO_UNARY_OP
    si tipo == NODO_UNARY_OP
        retorna codegen_unary_op(estado, nodo)
    # NODO_TERNARY
    si tipo == NODO_TERNARY
        retorna codegen_ternary(estado, nodo)
    # NODO_FUNC_CALL / NODO_EXTERN_CALL
    si tipo == NODO_FUNC_CALL o tipo == NODO_EXTERN_CALL
        retorna codegen_func_call(estado, nodo)
    # NODO_LIST_LIT
    si tipo == NODO_LIST_LIT
        retorna codegen_list_lit(estado, nodo)
    # NODO_INDEX_ACCESS
    si tipo == NODO_INDEX_ACCESS
        retorna codegen_index_access(estado, nodo)
    # NODO_STRUCT_LIT
    si tipo == NODO_STRUCT_LIT
        retorna codegen_struct_lit(estado, nodo)
    # NODO_MEMBER_ACCESS
    si tipo == NODO_MEMBER_ACCESS
        retorna codegen_member_access(estado, nodo)
    # Desconocido
    muestra "ERROR: Tipo de expresion no soportado: " + tipo_nodo_string(tipo) + " en linea " + texto(nodo_linea(nodo))
    salir(1)
    retorna LLVMConstPointerNull(i8ptr_type())

# ============================================================
# Binary op (1:1 con C++ generateBinaryOp)
# ============================================================

funcion codegen_binary_op(estado, nodo)
    hijos = nodo_hijos(nodo)
    op = nodo_op(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    left = codegen_expresion(estado, hijos[0])
    lt = last_expr_type
    right = codegen_expresion(estado, hijos[1])
    rt = last_expr_type
    # AND / OR (logicos, devuelven i1)
    si op == "and" o op == "y"
        l_bool = to_bool_val(estado, left, lt)
        r_bool = to_bool_val(estado, right, rt)
        last_expr_type = TIPO_BOOL
        retorna LLVMBuildAnd(b, l_bool, r_bool, "and")
    si op == "or" o op == "o"
        l_bool = to_bool_val(estado, left, lt)
        r_bool = to_bool_val(estado, right, rt)
        last_expr_type = TIPO_BOOL
        retorna LLVMBuildOr(b, l_bool, r_bool, "or")
    # Comparaciones (==, !=, <, >, <=, >=)
    es_cmp = falso
    si op == "=="
        es_cmp = verdad
    si op == "!="
        es_cmp = verdad
    si op == "<"
        es_cmp = verdad
    si op == ">"
        es_cmp = verdad
    si op == "<="
        es_cmp = verdad
    si op == ">="
        es_cmp = verdad
    si es_cmp == verdad
        # Comparacion de strings con strcmp
        si lt == TIPO_STRING y rt == TIPO_STRING
            strcmp_fn = LLVMGetNamedFunction(mod, "strcmp")
            cmp_res = zen_call2(b, strcmp_fn, left, right, "strcmp")
            zero = zen_constint(LLVMInt32Type(), 0, 0)
            pred = 32  # ICMP_EQ default
            si op == "=="
                pred = 32
            si op == "!="
                pred = 33  # ICMP_NE
            si op == "<" 
                pred = 40  # ICMP_SLT
            si op == ">" 
                pred = 38  # ICMP_SGT
            si op == "<="
                pred = 41  # ICMP_SLE
            si op == ">="
                pred = 39  # ICMP_SGE
            last_expr_type = TIPO_BOOL
            retorna LLVMBuildICmp(b, pred, cmp_res, zero, "scmp")
        # Comparacion numerica
        l_d = to_double_val(estado, left, lt)
        r_d = to_double_val(estado, right, rt)
        pred = 2  # FCMP_OEQ
        si op == "=="
            pred = 2  # OEQ
        si op == "!="
            pred = 6  # ONE
        si op == "<" 
            pred = 4  # OLT
        si op == ">" 
            pred = 3  # OGT
        si op == "<="
            pred = 5  # OLE
        si op == ">="
            pred = 7  # OGE
        last_expr_type = TIPO_BOOL
        retorna LLVMBuildFCmp(b, pred, l_d, r_d, "cmp")
    # Concatenacion de strings: "a" + "b" (o string + numero)
    si op == "+" y (lt == TIPO_STRING o rt == TIPO_STRING)
        l_str = to_string_val(estado, left, lt)
        r_str = to_string_val(estado, right, rt)
        concat_fn = LLVMGetNamedFunction(mod, "zen_concat")
        last_expr_type = TIPO_STRING
        retorna zen_call2(b, concat_fn, l_str, r_str, "concat")
    # Aritmetica numerica
    l_d = to_double_val(estado, left, lt)
    r_d = to_double_val(estado, right, rt)
    si op == "+"
        last_expr_type = TIPO_NUMBER
        retorna zen_fadd(b, l_d, r_d, "add")
    si op == "-"
        last_expr_type = TIPO_NUMBER
        retorna zen_fsub(b, l_d, r_d, "sub")
    si op == "*"
        last_expr_type = TIPO_NUMBER
        retorna zen_fmul(b, l_d, r_d, "mul")
    si op == "/"
        last_expr_type = TIPO_NUMBER
        retorna zen_fdiv(b, l_d, r_d, "div")
    si op == "%"
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildFRem(b, l_d, r_d, "mod")
    si op == "^"
        pow_fn = LLVMGetNamedFunction(mod, "pow")
        last_expr_type = TIPO_NUMBER
        retorna zen_call2(b, pow_fn, l_d, r_d, "pow")
    muestra "ERROR: Operador desconocido '" + op + "' en linea " + texto(nodo_linea(nodo))
    salir(1)
    retorna zen_constreal(LLVMDoubleType(), 0)

# ============================================================
# Unary op (1:1 con C++ generateUnaryOp)
# ============================================================

funcion codegen_unary_op(estado, nodo)
    hijos = nodo_hijos(nodo)
    op = nodo_op(nodo)
    b = estado_builder(estado)
    operand = codegen_expresion(estado, hijos[0])
    t = last_expr_type
    si op == "not"
        b_val = to_bool_val(estado, operand, t)
        last_expr_type = TIPO_BOOL
        retorna LLVMBuildNot(b, b_val, "not")
    si op == "-"
        d_val = to_double_val(estado, operand, t)
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildFNeg(b, d_val, "neg")
    muestra "ERROR: Operador unario desconocido '" + op + "' en linea " + texto(nodo_linea(nodo))
    salir(1)
    retorna operand

# ============================================================
# Ternary (1:1 con C++ generateTernary) - select para simplicidad
# ============================================================

funcion codegen_ternary(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    cond = codegen_expresion(estado, hijos[0])
    ct = last_expr_type
    cond_bool = to_bool_val(estado, cond, ct)
    then_val = codegen_expresion(estado, hijos[1])
    tt = last_expr_type
    else_val = codegen_expresion(estado, hijos[2])
    et = last_expr_type
    # Decidir tipo resultante
    result_type = TIPO_NUMBER
    si tt == TIPO_STRING o et == TIPO_STRING
        result_type = TIPO_STRING
    sino
        si tt == TIPO_BOOL y et == TIPO_BOOL
            result_type = TIPO_BOOL
    # Convertir ambos al tipo resultante
    si result_type == TIPO_STRING
        t_final = to_string_val(estado, then_val, tt)
        e_final = to_string_val(estado, else_val, et)
    sino
        si result_type == TIPO_BOOL
            t_final = to_bool_val(estado, then_val, tt)
            e_final = to_bool_val(estado, else_val, et)
        sino
            t_final = to_double_val(estado, then_val, tt)
            e_final = to_double_val(estado, else_val, et)
    last_expr_type = result_type
    retorna LLVMBuildSelect(b, cond_bool, t_final, e_final, "tern")

# ============================================================
# Llamada a funcion / builtin (1:1 con C++ generateFuncCallExpr + tryBuiltinCall)
# ============================================================

funcion codegen_func_call(estado, nodo)
    nombre = nodo_nombre(nodo)
    hijos = nodo_hijos(nodo)
    num_args = longitud(hijos)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    # Intentar con builtins primero (igual que en C++)
    builtin_res = codegen_builtin(estado, nombre, hijos, num_args, nodo)
    # Usar zen_is_null para verificar (no != 0 porque strtod(NULL) crashea)
    si zen_is_null(builtin_res) == "0"
        retorna builtin_res
    # Funcion de usuario
    func = LLVMGetNamedFunction(mod, nombre)
    si zen_is_null(func) == "0"
        # Generar argumentos boxeados como i8*
        args = [0]
        i = 0
        mientras i < num_args
            arg_val = codegen_expresion(estado, hijos[i])
            arg_ty = last_expr_type
            boxed = to_string_val(estado, arg_val, arg_ty)
            agregar(args, boxed)
            i = i + 1
        last_expr_type = TIPO_STRING
        si num_args == 0
            retorna zen_call1(b, func, args[0], "call")
        si num_args == 1
            return zen_call1(b, func, args[0], "call")
        si num_args == 2
            return zen_call2(b, func, args[0], args[1], "call")
        si num_args == 3
            return zen_call3(b, func, args[0], args[1], args[2], "call")
        si num_args == 4
            return zen_call4(b, func, args[0], args[1], args[2], args[3], "call")
        si num_args == 5
            return zen_call5(b, func, args[0], args[1], args[2], args[3], args[4], "call")
        si num_args == 6
            return zen_call6(b, func, args[0], args[1], args[2], args[3], args[4], args[5], "call")
        # Mas de 6 args: fallback (no soportado por wrappers)
        muestra "ERROR: Mas de 6 argumentos en llamada a '" + nombre + "'"
        salir(1)
    muestra "ERROR: Funcion '" + nombre + "' no definida en linea " + texto(nodo_linea(nodo))
    salir(1)
    retorna LLVMConstPointerNull(i8ptr_type())

# ============================================================
# Builtins (1:1 con C++ tryBuiltinCall)
# ============================================================

funcion codegen_builtin(estado, nombre, hijos, num_args, nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    i8p = i8ptr_type()
    i64t = LLVMInt64Type()
    i32t = LLVMInt32Type()
    double_t = LLVMDoubleType()
    # ---- longitud(s) / length(s) / len(s) ----
    si nombre == "longitud" o nombre == "length" o nombre == "len"
        arg = codegen_expresion(estado, hijos[0])
        at = last_expr_type
        # Si es string, usar strlen
        s = to_string_val(estado, arg, at)
        strlen_fn = LLVMGetNamedFunction(mod, "strlen")
        args = [s]
        len_i64 = LLVMBuildCall(b, strlen_fn, args, 1, "len")
        len_d = LLVMBuildUIToFP(b, len_i64, double_t, "lend")
        last_expr_type = TIPO_NUMBER
        retorna len_d
    # ---- char_at(s, i) -> numero (codigo ASCII) ----
    si nombre == "char_at" o nombre == "char_codigo" o nombre == "char_code" o nombre == "ascii_de"
        s = codegen_expresion(estado, hijos[0])
        s_str = to_string_val(estado, s, last_expr_type)
        idx = codegen_expresion(estado, hijos[1])
        idx_d = to_double_val(estado, idx, last_expr_type)
        idx_i64 = LLVMBuildFPToSI(b, idx_d, i64t, "idx")
        # s[idx] via GEP
        # LLVMBuildGEP(builder, ptr, indices, num_indices, name)
        ptr = zen_gep_1(b, LLVMInt8Type(), s_str, idx_i64, "charptr")
        ch = LLVMBuildLoad(b, ptr, "ch")
        ch_d = LLVMBuildSIToFP(b, ch, double_t, "chd")
        last_expr_type = TIPO_NUMBER
        retorna ch_d
    # ---- char_to_str(codigo) -> string de 1 char ----
    si nombre == "char_to_str" o nombre == "caracter" o nombre == "chr" o nombre == "desde_ascii"
        n = codegen_expresion(estado, hijos[0])
        n_d = to_double_val(estado, n, last_expr_type)
        ch_i8 = LLVMBuildFPToSI(b, n_d, LLVMInt8Type(), "chr")
        # malloc(2)
        malloc_fn = LLVMGetNamedFunction(mod, "malloc")
        two = LLVMConstInt(i64t, 2, 0)
        buf = zen_call1(b, malloc_fn, two, "chrbuf")
        # buf[0] = ch
        LLVMBuildStore(b, ch_i8, buf)
        # buf[1] = 0
        one = LLVMConstInt(i64t, 1, 0)
        nullptr = zen_gep_1(b, LLVMInt8Type(), buf, one, "nullptr")
        zero_i8 = LLVMConstInt(LLVMInt8Type(), 0, 0)
        LLVMBuildStore(b, zero_i8, nullptr)
        last_expr_type = TIPO_STRING
        retorna buf
    # ---- subtexto(s, desde_v, hasta_v) -> string ----
    si nombre == "subtexto" o nombre == "substring" o nombre == "substr" o nombre == "slice" o nombre == "sub"
        s = codegen_expresion(estado, hijos[0])
        s_str = to_string_val(estado, s, last_expr_type)
        desde_v = codegen_expresion(estado, hijos[1])
        desde_d = to_double_val(estado, desde_v, last_expr_type)
        hasta_v = codegen_expresion(estado, hijos[2])
        hasta_d = to_double_val(estado, hasta_v, last_expr_type)
        desde_i64 = LLVMBuildFPToSI(b, desde_d, i64t, "desde_v")
        hasta_i64 = LLVMBuildFPToSI(b, hasta_d, i64t, "hasta_v")
        len_i64 = LLVMBuildSub(b, hasta_i64, desde_i64, "sublen")
        zero_i64 = LLVMConstInt(i64t, 0, 0)
        is_neg = LLVMBuildICmp(b, 40, len_i64, zero_i64, "neg")
        len_pos = LLVMBuildSelect(b, is_neg, zero_i64, len_i64, "sublenp")
        size_wnull = LLVMBuildAdd(b, len_pos, one, "sz")
        malloc_fn = LLVMGetNamedFunction(mod, "malloc")
        margs = [size_wnull]
        buf = LLVMBuildCall(b, malloc_fn, margs, 1, "buf")
        # src = s + desde_v
        src = zen_gep_1(b, LLVMInt8Type(), s_str, desde_i64, "src")
        strncpy_fn = LLVMGetNamedFunction(mod, "strncpy")
        cpargs = [buf, src, len_pos]
        LLVMBuildCall(b, strncpy_fn, cpargs, 3, "cp")
        # buf[len] = 0
        nullpos = zen_gep_1(b, LLVMInt8Type(), buf, len_pos, "npos")
        LLVMBuildStore(b, zero_i8, nullpos)
        last_expr_type = TIPO_STRING
        retorna buf
    # ---- buscar(s, sub) -> int ----
    si nombre == "buscar" o nombre == "find" o nombre == "index" o nombre == "indexOf"
        s = codegen_expresion(estado, hijos[0])
        s_str = to_string_val(estado, s, last_expr_type)
        sub = codegen_expresion(estado, hijos[1])
        sub_str = to_string_val(estado, sub, last_expr_type)
        strstr_fn = LLVMGetNamedFunction(mod, "strstr")
        sargs = [s_str, sub_str]
        found = LLVMBuildCall(b, strstr_fn, sargs, 2, "found")
        nullp = LLVMConstPointerNull(i8p)
        is_null = LLVMBuildICmp(b, 32, found, nullp, "isnull")
        neg_one = zen_constreal(double_t, -1)
        found_i = LLVMBuildPtrToInt(b, found, i64t, "fi")
        s_i = LLVMBuildPtrToInt(b, s_str, i64t, "si")
        idx_i = LLVMBuildSub(b, found_i, s_i, "idx")
        idx_d = LLVMBuildUIToFP(b, idx_i, double_t, "idxd")
        result = LLVMBuildSelect(b, is_null, neg_one, idx_d, "buscar_r")
        last_expr_type = TIPO_NUMBER
        retorna result
    # ---- numero(s) -> number ----
    si nombre == "numero" o nombre == "number" o nombre == "num" o nombre == "tonum"
        s = codegen_expresion(estado, hijos[0])
        s_str = to_string_val(estado, s, last_expr_type)
        strtod_fn = LLVMGetNamedFunction(mod, "zen_strtod_safe")
        si strtod_fn == 0
            i8p2 = i8ptr_type()
            fty2 = zen_function_type_1(LLVMDoubleType(), i8p2, 0)
            strtod_fn = LLVMAddFunction(mod, "zen_strtod_safe", fty2)
        result = zen_call1(b, strtod_fn, s_str, "num")
        last_expr_type = TIPO_NUMBER
        retorna result
    # ---- texto(n) -> string ----
    si nombre == "texto" o nombre == "text" o nombre == "str" o nombre == "tostr"
        v = codegen_expresion(estado, hijos[0])
        t = last_expr_type
        si t == TIPO_STRING
            retorna v
        s = to_string_val(estado, v, t)
        last_expr_type = TIPO_STRING
        retorna s
    # ---- leer_archivo(ruta) -> string ----
    si nombre == "leer_archivo" o nombre == "read_file" o nombre == "readfile"
        path = codegen_expresion(estado, hijos[0])
        path_str = to_string_val(estado, path, last_expr_type)
        mode_str = LLVMConstString("rb", 2, 0)
        mode_g = LLVMAddGlobal(mod, LLVMInt8Type(), ".rb")
        LLVMSetInitializer(mode_g, mode_str)
        LLVMSetGlobalConstant(mode_g, 1)
        LLVMSetLinkage(mode_g, 0)
        mode_ptr = LLVMBuildBitCast(b, mode_g, i8p, "rbptr")
        fopen_fn = LLVMGetNamedFunction(mod, "fopen")
        fargs = [path_str, mode_ptr]
        file = LLVMBuildCall(b, fopen_fn, fargs, 2, "file")
        nullp = LLVMConstPointerNull(i8p)
        is_null = LLVMBuildICmp(b, 32, file, nullp, "isnull")
        empty_str = LLVMConstString("", 0, 0)
        empty_g = LLVMAddGlobal(mod, LLVMInt8Type(), ".empty")
        LLVMSetInitializer(empty_g, empty_str)
        LLVMSetGlobalConstant(empty_g, 1)
        LLVMSetLinkage(empty_g, 0)
        empty_ptr = LLVMBuildBitCast(b, empty_g, i8p, "emptyptr")
        # open: fseek, ftell, fseek, malloc, fread, fclose
        fseek_fn = LLVMGetNamedFunction(mod, "fseek")
        ftell_fn = LLVMGetNamedFunction(mod, "ftell")
        malloc_fn = LLVMGetNamedFunction(mod, "malloc")
        fread_fn = LLVMGetNamedFunction(mod, "fread")
        fclose_fn = LLVMGetNamedFunction(mod, "fclose")
        # Elaboracion con bloques
        func = current_func
        open_bb = zen_appendbasicblock(func, "rf.open")
        end_bb = zen_appendbasicblock(func, "rf.end")
        zen_condbr(b, is_null, end_bb, open_bb)
        zen_positionbuilder(b, open_bb)
        seek_end = LLVMConstInt(i32t, 2, 0)
        zero_i64 = LLVMConstInt(i64t, 0, 0)
        sargs2 = [file, zero_i64, seek_end]
        LLVMBuildCall(b, fseek_fn, sargs2, 3, "se1")
        sargs3 = [file]
        size = LLVMBuildCall(b, ftell_fn, sargs3, 1, "size")
        seek_set = LLVMConstInt(i32t, 0, 0)
        sargs4 = [file, zero_i64, seek_set]
        LLVMBuildCall(b, fseek_fn, sargs4, 3, "se2")
        sp1 = LLVMBuildAdd(b, size, one, "sp1")
        margs = [sp1]
        buf = LLVMBuildCall(b, malloc_fn, margs, 1, "buf")
        one_i64 = LLVMConstInt(i64t, 1, 0)
        fargs2 = [buf, one_i64, size, file]
        LLVMBuildCall(b, fread_fn, fargs2, 4, "rd")
        # buf[size] = 0
        endpos = zen_gep_1(b, LLVMInt8Type(), buf, size, "ep")
        zero_i8 = LLVMConstInt(LLVMInt8Type(), 0, 0)
        LLVMBuildStore(b, zero_i8, endpos)
        cargs = [file]
        LLVMBuildCall(b, fclose_fn, cargs, 1, "fc")
        zen_br(b, end_bb)
        zen_positionbuilder(b, end_bb)
        # PHI entre empty_ptr y buf
        # Necesitamos capturar el BB actual antes de branchear para tener el predecessor correcto
        cur_bb_for_phi = LLVMGetInsertBlock(b)
        phi = LLVMBuildPhi(i8p, "rf_result")
        zen_add_incoming_2(phi, empty_ptr, cur_bb_for_phi, buf, open_bb)
        last_expr_type = TIPO_STRING
        retorna phi
    # ---- argumentos(i) -> string (argv[i]) ----
    si nombre == "argumentos" o nombre == "argv" o nombre == "args"
        idx = codegen_expresion(estado, hijos[0])
        idx_d = to_double_val(estado, idx, last_expr_type)
        idx_i32 = LLVMBuildFPToSI(b, idx_d, i32t, "argidx")
        argv_var = LLVMGetNamedGlobal(mod, "__zen_argv")
        si argv_var == 0
            last_expr_type = TIPO_STRING
            retorna LLVMConstPointerNull(i8p)
        argv_ptr_ty = LLVMPointerType(i8p, 0)
        argv = LLVMBuildLoad(b, argv_var, "argv")
        # argv[n] = GEP
        arg_ptr = zen_gep_1(b, i8p, argv, idx_i32, "arggep")
        arg_val = LLVMBuildLoad(b, arg_ptr, "argval")
        last_expr_type = TIPO_STRING
        retorna arg_val
    # ---- num_argumentos() -> number (argc) ----
    si nombre == "num_argumentos" o nombre == "argc" o nombre == "num_args"
        argc_var = LLVMGetNamedGlobal(mod, "__zen_argc")
        si argc_var == 0
            i32t2 = LLVMInt32Type()
            argc_var = LLVMAddGlobal(mod, i32t2, "__zen_argc")
            LLVMSetInitializer(argc_var, LLVMConstInt(i32t2, 0, 0))
            LLVMSetLinkage(argc_var, 0)
        argc = LLVMBuildLoad(b, argc_var, "argc")
        argc_d = LLVMBuildSIToFP(b, argc, double_t, "argcd")
        last_expr_type = TIPO_NUMBER
        retorna argc_d
    # ---- salir(codigo) ----
    si nombre == "salir" o nombre == "exit"
        code = codegen_expresion(estado, hijos[0])
        code_d = to_double_val(estado, code, last_expr_type)
        code_i32 = LLVMBuildFPToSI(b, code_d, i32t, "code")
        exit_fn = LLVMGetNamedFunction(mod, "exit")
        eargs = [code_i32]
        LLVMBuildCall(b, exit_fn, eargs, 1, "exit")
        LLVMBuildUnreachable(b)
        last_expr_type = TIPO_NUMBER
        retorna zen_constreal(double_t, 0)
    # ---- reloj() -> timestamp ----
    si nombre == "reloj" o nombre == "clock" o nombre == "time" o nombre == "now"
        time_fn = LLVMGetNamedFunction(mod, "time")
        i64p = LLVMPointerType(i64t, 0)
        nullp = LLVMConstPointerNull(i64p)
        targs = [nullp]
        t = LLVMBuildCall(b, time_fn, targs, 1, "t")
        t_d = LLVMBuildSIToFP(b, t, double_t, "td")
        last_expr_type = TIPO_NUMBER
        retorna t_d
    # ---- dormir(ms) ----
    si nombre == "dormir" o nombre == "sleep" o nombre == "esperar"
        ms = codegen_expresion(estado, hijos[0])
        ms_d = to_double_val(estado, ms, last_expr_type)
        us = zen_fmul(b, ms_d, zen_constreal(double_t, 1000), "us")
        us_i32 = LLVMBuildFPToSI(b, us, i32t, "us32")
        usleep_fn = LLVMGetNamedFunction(mod, "usleep")
        uargs = [us_i32]
        LLVMBuildCall(b, usleep_fn, uargs, 1, "slp")
        last_expr_type = TIPO_NUMBER
        retorna zen_constreal(double_t, 0)
    # ---- limpiar() ----
    si nombre == "limpiar" o nombre == "clear" o nombre == "cls"
        clear_str = LLVMConstString("\033[2J\033[H", 7, 0)
        clear_g = LLVMAddGlobal(mod, LLVMInt8Type(), ".clr")
        LLVMSetInitializer(clear_g, clear_str)
        LLVMSetGlobalConstant(clear_g, 1)
        LLVMSetLinkage(clear_g, 0)
        clear_ptr = LLVMBuildBitCast(b, clear_g, i8p, "clrptr")
        printf_fn = LLVMGetNamedFunction(mod, "printf")
        pargs = [clear_ptr]
        LLVMBuildCall(b, printf_fn, pargs, 1, "clr")
        last_expr_type = TIPO_NUMBER
        retorna zen_constreal(double_t, 0)
    # ---- azar(n) -> random 0..n-1 ----
    si nombre == "azar" o nombre == "random" o nombre == "rand"
        n = codegen_expresion(estado, hijos[0])
        n_d = to_double_val(estado, n, last_expr_type)
        n_i32 = LLVMBuildFPToSI(b, n_d, i32t, "n")
        rand_fn = LLVMGetNamedFunction(mod, "rand")
        r = LLVMBuildCall(b, rand_fn, [0], 0, "r")
        mod_v = LLVMBuildSRem(b, r, n_i32, "mod")
        mod_d = LLVMBuildSIToFP(b, mod_v, double_t, "az")
        last_expr_type = TIPO_NUMBER
        retorna mod_d
    # ---- agregar(lista, elem) ----
    si nombre == "agregar" o nombre == "push" o nombre == "append" o nombre == "add"
        lista = codegen_expresion(estado, hijos[0])
        lista_ptr = LLVMBuildBitCast(b, lista, i8p, "lst")
        elem = codegen_expresion(estado, hijos[1])
        elem_boxed = to_string_val(estado, elem, last_expr_type)
        push_fn = LLVMGetNamedFunction(mod, "__zen_list_push")
        pargs = [lista_ptr, elem_boxed]
        LLVMBuildCall(b, push_fn, pargs, 2, "push")
        last_expr_type = TIPO_NUMBER
        retorna zen_constreal(double_t, 0)
    # ---- contiene(lista, elem) -> bool ----
    si nombre == "contiene" o nombre == "contains"
        lista = codegen_expresion(estado, hijos[0])
        lista_ptr = LLVMBuildBitCast(b, lista, i8p, "lst")
        elem = codegen_expresion(estado, hijos[1])
        elem_boxed = to_string_val(estado, elem, last_expr_type)
        contains_fn = LLVMGetNamedFunction(mod, "__zen_list_contains")
        cargs = [lista_ptr, elem_boxed]
        result = LLVMBuildCall(b, contains_fn, cargs, 2, "has")
        last_expr_type = TIPO_BOOL
        retorna result
    # ---- quitar(lista) -> elem ----
    si nombre == "quitar" o nombre == "pop" o nombre == "remove_last"
        lista = codegen_expresion(estado, hijos[0])
        lista_ptr = LLVMBuildBitCast(b, lista, i8p, "lst")
        pop_fn = LLVMGetNamedFunction(mod, "__zen_list_pop")
        pargs = [lista_ptr]
        result = LLVMBuildCall(b, pop_fn, pargs, 1, "popped")
        last_expr_type = TIPO_STRING
        retorna result
    # ---- Math builtins ----
    si nombre == "raiz" o nombre == "sqrt" o nombre == "raiz_cuadrada"
        v = codegen_expresion(estado, hijos[0])
        d = to_double_val(estado, v, last_expr_type)
        sqrt_fn = LLVMGetNamedFunction(mod, "sqrt")
        sargs = [d]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, sqrt_fn, sargs, 1, "sqrt")
    si nombre == "seno" o nombre == "sin"
        v = codegen_expresion(estado, hijos[0])
        d = to_double_val(estado, v, last_expr_type)
        sin_fn = LLVMGetNamedFunction(mod, "sin")
        sargs = [d]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, sin_fn, sargs, 1, "sin")
    si nombre == "coseno" o nombre == "cos"
        v = codegen_expresion(estado, hijos[0])
        d = to_double_val(estado, v, last_expr_type)
        cos_fn = LLVMGetNamedFunction(mod, "cos")
        sargs = [d]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, cos_fn, sargs, 1, "cos")
    si nombre == "tangente" o nombre == "tan"
        v = codegen_expresion(estado, hijos[0])
        d = to_double_val(estado, v, last_expr_type)
        tan_fn = LLVMGetNamedFunction(mod, "tan")
        sargs = [d]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, tan_fn, sargs, 1, "tan")
    si nombre == "potencia" o nombre == "pow" o nombre == "power"
        v1 = codegen_expresion(estado, hijos[0])
        base = to_double_val(estado, v1, last_expr_type)
        v2 = codegen_expresion(estado, hijos[1])
        exp = to_double_val(estado, v2, last_expr_type)
        pow_fn = LLVMGetNamedFunction(mod, "pow")
        pargs = [base, exp]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, pow_fn, pargs, 2, "pow")
    si nombre == "piso" o nombre == "floor"
        v = codegen_expresion(estado, hijos[0])
        d = to_double_val(estado, v, last_expr_type)
        floor_fn = LLVMGetNamedFunction(mod, "floor")
        fargs = [d]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, floor_fn, fargs, 1, "floor")
    si nombre == "techo" o nombre == "ceil"
        v = codegen_expresion(estado, hijos[0])
        d = to_double_val(estado, v, last_expr_type)
        ceil_fn = LLVMGetNamedFunction(mod, "ceil")
        cargs = [d]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, ceil_fn, cargs, 1, "ceil")
    si nombre == "abs" o nombre == "valor_absoluto"
        v = codegen_expresion(estado, hijos[0])
        d = to_double_val(estado, v, last_expr_type)
        fabs_fn = LLVMGetNamedFunction(mod, "fabs")
        fargs = [d]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, fabs_fn, fargs, 1, "abs")
    si nombre == "redondear" o nombre == "round"
        v = codegen_expresion(estado, hijos[0])
        d = to_double_val(estado, v, last_expr_type)
        round_fn = LLVMGetNamedFunction(mod, "round")
        rargs = [d]
        last_expr_type = TIPO_NUMBER
        retorna LLVMBuildCall(b, round_fn, rargs, 1, "round")
    si nombre == "min" o nombre == "menor"
        v1 = codegen_expresion(estado, hijos[0])
        a = to_double_val(estado, v1, last_expr_type)
        v2 = codegen_expresion(estado, hijos[1])
        c = to_double_val(estado, v2, last_expr_type)
        cmp = LLVMBuildFCmp(b, 4, a, c, "cmp")
        result = LLVMBuildSelect(b, cmp, a, c, "min")
        last_expr_type = TIPO_NUMBER
        retorna result
    si nombre == "max" o nombre == "mayor"
        v1 = codegen_expresion(estado, hijos[0])
        a = to_double_val(estado, v1, last_expr_type)
        v2 = codegen_expresion(estado, hijos[1])
        c = to_double_val(estado, v2, last_expr_type)
        cmp = LLVMBuildFCmp(b, 3, a, c, "cmp")
        result = LLVMBuildSelect(b, cmp, a, c, "max")
        last_expr_type = TIPO_NUMBER
        retorna result
    # ---- muestra / show / print / mostrar / imprime ----
    # Solo si se usa como expresion; como statement va por NODO_PRINT
    si nombre == "muestra" o nombre == "show" o nombre == "print" o nombre == "mostrar" o nombre == "imprime"
        arg = codegen_expresion(estado, hijos[0])
        zen_printf_call(b, mod, arg)
        last_expr_type = TIPO_NUMBER
        retorna zen_constreal(double_t, 0)
    # No es un builtin conocido
    retorna 0

# ============================================================
# List / Struct literals
# ============================================================

funcion codegen_list_lit(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    i64t = LLVMInt64Type()
    num = longitud(hijos)
    # __zen_list_create(capacity)
    cap = num
    si cap < 4
        cap = 4
    list_fn = LLVMGetNamedFunction(mod, "__zen_list_create")
    cap_i64 = LLVMConstInt(i64t, 0, 0)
    cargs = [cap_i64]
    lista = LLVMBuildCall(b, list_fn, cargs, 1, "newlist")
    # Push each element
    push_fn = LLVMGetNamedFunction(mod, "__zen_list_push")
    i = 0
    mientras i < num
        elem = codegen_expresion(estado, hijos[i])
        elem_boxed = to_string_val(estado, elem, last_expr_type)
        pargs = [lista, elem_boxed]
        LLVMBuildCall(b, push_fn, pargs, 2, "push")
        i = i + 1
    last_expr_type = TIPO_LIST
    retorna lista

funcion codegen_struct_lit(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    i64t = LLVMInt64Type()
    num_campos = numero(nodo_valor(nodo))
    # __zen_struct_create(numFields)
    struct_fn = LLVMGetNamedFunction(mod, "__zen_struct_create")
    n_fields = LLVMConstInt(i64t, num_campos, 0)
    sargs = [n_fields]
    struct_v = LLVMBuildCall(b, struct_fn, sargs, 1, "newstruct")
    # Set each field
    set_fn = LLVMGetNamedFunction(mod, "__zen_struct_set")
    i = 0
    mientras i < num_campos
        # hijos[i] = nombre del campo (NODO_IDENTIFIER), hijos[i + num_campos] = valor
        campo_id = hijos[i]
        valor = codegen_expresion(estado, hijos[i + num_campos])
        valor_boxed = to_string_val(estado, valor, last_expr_type)
        idx = LLVMConstInt(i64t, i, 0)
        setargs = [struct_v, idx, valor_boxed]
        LLVMBuildCall(b, set_fn, setargs, 3, "sset")
        i = i + 1
    last_expr_type = TIPO_STRUCT
    retorna struct_v

funcion codegen_index_access(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    i64t = LLVMInt64Type()
    base = codegen_expresion(estado, hijos[0])
    base_ptr = LLVMBuildBitCast(b, base, i8ptr_type(), "idxbase")
    idx = codegen_expresion(estado, hijos[1])
    idx_d = to_double_val(estado, idx, last_expr_type)
    idx_i64 = LLVMBuildFPToSI(b, idx_d, i64t, "idxi64")
    get_fn = LLVMGetNamedFunction(mod, "__zen_list_get")
    gargs = [base_ptr, idx_i64]
    elem = LLVMBuildCall(b, get_fn, gargs, 2, "lget")
    last_expr_type = TIPO_STRING
    retorna elem

funcion codegen_member_access(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    i64t = LLVMInt64Type()
    base = codegen_expresion(estado, hijos[0])
    base_ptr = LLVMBuildBitCast(b, base, i8ptr_type(), "mbase")
    miembro = nodo_nombre(nodo)
    idx = buscar_indice_campo(miembro)
    si idx < 0
        # Hash fallback (1:1 con C++)
        idx = 0
    get_fn = LLVMGetNamedFunction(mod, "__zen_struct_get")
    idx_i64 = LLVMConstInt(i64t, idx, 0)
    gargs = [base_ptr, idx_i64]
    val = LLVMBuildCall(b, get_fn, gargs, 2, "mget")
    last_expr_type = TIPO_STRING
    retorna val

# ============================================================
# Codegen de statements (1:1 con C++ generateNode)
# ============================================================

funcion codegen_statement(estado, nodo)
    si zen_is_null(nodo) == "1"
        retorna 0
    tipo = nodo_tipo(nodo)
    si zen_is_null(tipo) == "1"
        retorna 0
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    # NODO_PRINT
    si tipo == NODO_PRINT
        hijos = nodo_hijos(nodo)
        arg = codegen_expresion(estado, hijos[0])
        at = last_expr_type
        # Convertir segun tipo
        si at == TIPO_NUMBER
            # printf("%g\n", num)
            zen_printf_call(b, mod, arg)
        sino
            si at == TIPO_STRING
                # printf("%s\n", str)
                zen_printf_call(b, mod, arg)
            sino
                # Bool: yes/no
                si at == TIPO_BOOL
                    str_v = to_string_val(estado, arg, at)
                    zen_printf_call(b, mod, str_v)
                sino
                    # Null: printf("nada\n")
                    zen_printf_call(b, mod, arg)
        retorna 0
    # NODO_ASSIGN
    si tipo == NODO_ASSIGN
        retorna codegen_assign(estado, nodo)
    # NODO_AUG_ASSIGN
    si tipo == NODO_AUG_ASSIGN
        retorna codegen_aug_assign(estado, nodo)
    # NODO_RETURN
    si tipo == NODO_RETURN
        hijos = nodo_hijos(nodo)
        si longitud(hijos) > 0
            v = codegen_expresion(estado, hijos[0])
            t = last_expr_type
            boxed = to_string_val(estado, v, t)
            zen_ret(b, boxed)
        sino
            zen_retval(b, LLVMConstPointerNull(i8ptr_type()))
        # Crear bb dead para que codigo siguiente no se agregue al bb terminado
        dead_bb = zen_appendbasicblock(current_func, "dead")
        zen_positionbuilder(b, dead_bb)
        retorna 0
    # NODO_FUNC_DECL
    si tipo == NODO_FUNC_DECL
        retorna codegen_func_decl(estado, nodo)
    # NODO_EXPR_STMT
    si tipo == NODO_EXPR_STMT
        hijos = nodo_hijos(nodo)
        codegen_expresion(estado, hijos[0])
        retorna 0
    # NODO_IF
    si tipo == NODO_IF
        retorna codegen_if(estado, nodo)
    # NODO_WHILE
    si tipo == NODO_WHILE
        retorna codegen_while(estado, nodo)
    # NODO_FOR_RANGE
    si tipo == NODO_FOR_RANGE
        retorna codegen_for_range(estado, nodo)
    # NODO_FOR_EACH
    si tipo == NODO_FOR_EACH
        retorna codegen_for_each(estado, nodo)
    # NODO_REPEAT
    si tipo == NODO_REPEAT
        retorna codegen_repeat(estado, nodo)
    # NODO_BREAK
    si tipo == NODO_BREAK
        # Tomar el ultimo break_bb del stack
        n = longitud(loop_stack_break)
        si n > 0
            bb = loop_stack_break[n - 1]
            zen_br(b, bb)
        # Crear bb dead
        dead_bb = zen_appendbasicblock(current_func, "dead.brk")
        zen_positionbuilder(b, dead_bb)
        retorna 0
    # NODO_CONTINUE
    si tipo == NODO_CONTINUE
        n = longitud(loop_stack_cont)
        si n > 0
            bb = loop_stack_cont[n - 1]
            zen_br(b, bb)
        # Crear bb dead
        dead_bb = zen_appendbasicblock(current_func, "dead.cont")
        zen_positionbuilder(b, dead_bb)
        retorna 0
    # NODO_PLATFORM
    si tipo == NODO_PLATFORM
        # En Zen-on-Zen, siempre generamos (no hay cross-compile aqui)
        hijos = nodo_hijos(nodo)
        para cada s en hijos
            codegen_statement(estado, s)
        retorna 0
    # NODO_STRUCT_DECL
    si tipo == NODO_STRUCT_DECL
        # Registrar struct
        nombre = nodo_nombre(nodo)
        hijos = nodo_hijos(nodo)
        campos = []
        n = longitud(hijos)
        i = 0
        mientras i < n
            agregar(campos, nodo_valor(hijos[i]))
            i = i + 1
        registrar_struct(nombre, campos)
        retorna 0
    # NODO_INDEX_ASSIGN
    si tipo == NODO_INDEX_ASSIGN
        retorna codegen_index_assign(estado, nodo)
    # NODO_MEMBER_ASSIGN
    si tipo == NODO_MEMBER_ASSIGN
        retorna codegen_member_assign(estado, nodo)
    # NODO_EXTERN_DECL
    si tipo == NODO_EXTERN_DECL
        # Registrar extern en el modulo (declarar la funcion C)
        retorna codegen_extern_decl(estado, nodo)
    # NODO_MATCH (stub por ahora)
    si tipo == NODO_MATCH
        retorna 0
    # Desconocido
    muestra "WARN: Statement no soportado: " + tipo_nodo_string(tipo) + " en linea " + texto(nodo_linea(nodo))
    retorna 0

# ============================================================
# Assign (1:1 con C++ generateAssign)
# ============================================================

funcion codegen_assign(estado, nodo)
    hijos = nodo_hijos(nodo)
    nombre = nodo_nombre(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    valor = codegen_expresion(estado, hijos[0])
    t = last_expr_type
    # Buscar variable existente en scope local
    idx = buscar_variable(nombre)
    si idx >= 0
        var_ptr = var_ptrs[idx]
        var_ty = var_tipos[idx]
        # Si la variable es i8* (boxed), boxear el valor
        si var_ty == TIPO_STRING
            boxed = to_string_val(estado, valor, t)
            LLVMBuildStore(b, boxed, var_ptr)
        sino
            si var_ty == TIPO_NUMBER
                d = to_double_val(estado, valor, t)
                LLVMBuildStore(b, d, var_ptr)
            sino
                si var_ty == TIPO_BOOL
                    bv = to_bool_val(estado, valor, t)
                    LLVMBuildStore(b, bv, var_ptr)
        retorna 0
    # Variable nueva a nivel superior: usar global (siempre i8* boxed)
    gvar = get_o_crear_global(estado, nombre)
    boxed = to_string_val(estado, valor, t)
    LLVMBuildStore(b, boxed, gvar)
    # Registrar en scope
    agregar(var_nombres, nombre)
    agregar(var_ptrs, gvar)
    agregar(var_tipos, TIPO_STRING)
    retorna 0

# ============================================================
# AugAssign (1:1 con C++ generateAugAssign)
# ============================================================

funcion codegen_aug_assign(estado, nodo)
    hijos = nodo_hijos(nodo)
    nombre = nodo_nombre(nodo)
    op = nodo_op(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    # Cargar valor actual
    idx = buscar_variable(nombre)
    si idx < 0
        muestra "ERROR: Variable '" + nombre + "' no definida en linea " + texto(nodo_linea(nodo))
        salir(1)
    var_ptr = var_ptrs[idx]
    var_ty = var_tipos[idx]
    # Cargar
    cur = LLVMBuildLoad(b, var_ptr, nombre)
    cur_t = var_ty
    # Generar RHS
    rhs = codegen_expresion(estado, hijos[0])
    rt = last_expr_type
    # String concat: x += "str"
    si var_ty == TIPO_STRING y op == "+"
        cur_str = to_string_val(estado, cur, cur_t)
        rhs_str = to_string_val(estado, rhs, rt)
        concat_fn = LLVMGetNamedFunction(mod, "zen_concat")
        cargs = [cur_str, rhs_str]
        result = LLVMBuildCall(b, concat_fn, cargs, 2, "concat")
        LLVMBuildStore(b, result, var_ptr)
        retorna 0
    # Aritmetica
    l_d = to_double_val(estado, cur, cur_t)
    r_d = to_double_val(estado, rhs, rt)
    si op == "+"
        result = zen_fadd(b, l_d, r_d, "add")
    sino
        si op == "-"
            result = zen_fsub(b, l_d, r_d, "sub")
        sino
            si op == "*"
                result = zen_fmul(b, l_d, r_d, "mul")
            sino
                si op == "/"
                    result = zen_fdiv(b, l_d, r_d, "div")
                sino
                    si op == "%"
                        result = LLVMBuildFRem(b, l_d, r_d, "mod")
                    sino
                        si op == "^"
                            pow_fn = LLVMGetNamedFunction(mod, "pow")
                            pargs = [l_d, r_d]
                            result = LLVMBuildCall(b, pow_fn, pargs, 2, "pow")
                        sino
                            muestra "ERROR: Operador desconocido '" + op + "'"
                            salir(1)
                            result = l_d
    # Si variable es Number, guardar como double
    si var_ty == TIPO_NUMBER
        LLVMBuildStore(b, result, var_ptr)
    sino
        # Boxear
        boxed = to_string_val(estado, result, TIPO_NUMBER)
        LLVMBuildStore(b, boxed, var_ptr)
    retorna 0

# ============================================================
# If (1:1 con C++ generateIf) - ahora usando valor=k para separar then/else
# ============================================================

funcion codegen_if(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    func = current_func
    # Generar condicion
    cond = codegen_expresion(estado, hijos[0])
    ct = last_expr_type
    cond_bool = to_bool_val(estado, cond, ct)
    # k = count de then-body (guardado en valor)
    k = numero(nodo_valor(nodo))
    n = longitud(hijos)
    # Crear bloques
    then_bb = zen_appendbasicblock(func, "then")
    # else_bb solo si hay body sino
    else_bb = 0
    si n > k + 1
        else_bb = zen_appendbasicblock(func, "else")
    merge_bb = zen_appendbasicblock(func, "endif")
    si zen_is_null(else_bb) == "0"
        zen_condbr(b, cond_bool, then_bb, else_bb)
    sino
        zen_condbr(b, cond_bool, then_bb, merge_bb)
    # Then body
    zen_positionbuilder(b, then_bb)
    i = 1
    mientras i <= k
        si bloque_actual_tiene_terminator(b) == verdad
            dead_bb = zen_appendbasicblock(current_func, "dead")
            zen_positionbuilder(b, dead_bb)
        codegen_statement(estado, hijos[i])
        i = i + 1
    si bloque_actual_tiene_terminator(b) == falso
        zen_br(b, merge_bb)
    # Else body
    si zen_is_null(else_bb) == "0"
        zen_positionbuilder(b, else_bb)
        i = k + 1
        mientras i < n
            si bloque_actual_tiene_terminator(b) == verdad
                romper
            codegen_statement(estado, hijos[i])
            i = i + 1
        si bloque_actual_tiene_terminator(b) == falso
            zen_br(b, merge_bb)
    zen_positionbuilder(b, merge_bb)
    retorna 0

# ============================================================
# While (1:1 con C++ generateWhile)
# ============================================================

funcion codegen_while(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    func = current_func
    cond_bb = zen_appendbasicblock(func, "while.cond")
    body_bb = zen_appendbasicblock(func, "while.body")
    end_bb = zen_appendbasicblock(func, "while.end")
    # Push break/continue
    push_loop(end_bb, cond_bb)
    zen_br(b, cond_bb)
    zen_positionbuilder(b, cond_bb)
    cond = codegen_expresion(estado, hijos[0])
    ct = last_expr_type
    cond_bool = to_bool_val(estado, cond, ct)
    zen_condbr(b, cond_bool, body_bb, end_bb)
    zen_positionbuilder(b, body_bb)
    n = longitud(hijos)
    i = 1
    mientras i < n
        si bloque_actual_tiene_terminator(b) == verdad
            dead_bb = zen_appendbasicblock(current_func, "dead")
            zen_positionbuilder(b, dead_bb)
        codegen_statement(estado, hijos[i])
        i = i + 1
    si bloque_actual_tiene_terminator(b) == falso
        zen_br(b, cond_bb)
    zen_positionbuilder(b, end_bb)
    # Pop: quitar el ultimo elemento del stack
    pop_loop()
    retorna 0

# ============================================================
# For range (1:1 con C++ generateForRange)
# ============================================================

funcion codegen_for_range(estado, nodo)
    hijos = nodo_hijos(nodo)
    var_name = nodo_nombre(nodo)
    b = estado_builder(estado)
    func = current_func
    desde_v = codegen_expresion(estado, hijos[0])
    desde_d = to_double_val(estado, desde_v, last_expr_type)
    hasta_v = codegen_expresion(estado, hijos[1])
    hasta_d = to_double_val(estado, hasta_v, last_expr_type)
    # Alloca para loop var
    double_t = LLVMDoubleType()
    loop_var = zen_alloca(b, double_t, var_name)
    LLVMBuildStore(b, desde_d, loop_var)
    cond_bb = zen_appendbasicblock(func, "for.cond")
    body_bb = zen_appendbasicblock(func, "for.body")
    end_bb = zen_appendbasicblock(func, "for.end")
    # Push break/continue
    push_loop(end_bb, cond_bb)
    # Registrar loop var en scope (como Number)
    idx_saved = buscar_variable(var_name)
    agregar(var_nombres, var_name)
    agregar(var_ptrs, loop_var)
    agregar(var_tipos, TIPO_NUMBER)
    zen_br(b, cond_bb)
    zen_positionbuilder(b, cond_bb)
    cur = LLVMBuildLoad(b, loop_var, var_name)
    cmp = LLVMBuildFCmp(b, 4, cur, hasta_d, "forcmp")
    zen_condbr(b, cmp, body_bb, end_bb)
    zen_positionbuilder(b, body_bb)
    n = longitud(hijos)
    i = 2
    mientras i < n
        si bloque_actual_tiene_terminator(b) == verdad
            dead_bb = zen_appendbasicblock(current_func, "dead")
            zen_positionbuilder(b, dead_bb)
        codegen_statement(estado, hijos[i])
        i = i + 1
    # inc: i++
    cur2 = LLVMBuildLoad(b, loop_var, var_name)
    one_d = zen_constreal(double_t, 1)
    next_v = zen_fadd(b, cur2, one_d, "forinc")
    LLVMBuildStore(b, next_v, loop_var)
    zen_br(b, cond_bb)
    zen_positionbuilder(b, end_bb)
    # Pop scope (restaurar) y loop stack
    pop_loop()
    retorna 0

# ============================================================
# For each (1:1 con C++ generateForEach)
# ============================================================

funcion codegen_for_each(estado, nodo)
    hijos = nodo_hijos(nodo)
    var_name = nodo_nombre(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    func = current_func
    i64t = LLVMInt64Type()
    i8p = i8ptr_type()
    double_t = LLVMDoubleType()
    iter = codegen_expresion(estado, hijos[0])
    iter_ptr = LLVMBuildBitCast(b, iter, i8p, "iter")
    # len = list_len(iter)
    len_fn = LLVMGetNamedFunction(mod, "__zen_list_len")
    largs = [iter_ptr]
    len = LLVMBuildCall(b, len_fn, largs, 1, "len")
    # i = 0 (alloca i64)
    i_alloca = zen_alloca(b, i64t, "i")
    zero_i64 = LLVMConstInt(i64t, 0, 0)
    LLVMBuildStore(b, zero_i64, i_alloca)
    # var = "" (alloca i8*)
    var_alloca = zen_alloca(b, i8p, var_name)
    nullp = LLVMConstPointerNull(i8p)
    LLVMBuildStore(b, nullp, var_alloca)
    cond_bb = zen_appendbasicblock(func, "fe.cond")
    body_bb = zen_appendbasicblock(func, "fe.body")
    inc_bb = zen_appendbasicblock(func, "fe.inc")
    end_bb = zen_appendbasicblock(func, "fe.end")
    # Push break/continue
    push_loop(end_bb, inc_bb)
    # Registrar var en scope
    agregar(var_nombres, var_name)
    agregar(var_ptrs, var_alloca)
    agregar(var_tipos, TIPO_STRING)
    zen_br(b, cond_bb)
    zen_positionbuilder(b, cond_bb)
    i_val = LLVMBuildLoad(b, i_alloca, "i")
    cmp = LLVMBuildICmp(b, 40, i_val, len, "cmp")
    zen_condbr(b, cmp, body_bb, end_bb)
    zen_positionbuilder(b, body_bb)
    # var = list_get(iter, i)
    get_fn = LLVMGetNamedFunction(mod, "__zen_list_get")
    gargs = [iter_ptr, i_val]
    elem = LLVMBuildCall(b, get_fn, gargs, 2, "elem")
    LLVMBuildStore(b, elem, var_alloca)
    n = longitud(hijos)
    i = 1
    mientras i < n
        codegen_statement(estado, hijos[i])
        i = i + 1
    zen_br(b, inc_bb)
    zen_positionbuilder(b, inc_bb)
    one_i64 = LLVMConstInt(i64t, 1, 0)
    next_v = LLVMBuildAdd(b, i_val, one_i64, "next")
    LLVMBuildStore(b, next_v, i_alloca)
    zen_br(b, cond_bb)
    zen_positionbuilder(b, end_bb)
    pop_loop()
    retorna 0

# ============================================================
# Repeat (1:1 con C++ generateRepeat)
# ============================================================

funcion codegen_repeat(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    func = current_func
    double_t = LLVMDoubleType()
    count = codegen_expresion(estado, hijos[0])
    count_d = to_double_val(estado, count, last_expr_type)
    counter = zen_alloca(b, double_t, "_rep_i")
    LLVMBuildStore(b, zen_constreal(double_t, 0), counter)
    cond_bb = zen_appendbasicblock(func, "repeat.cond")
    body_bb = zen_appendbasicblock(func, "repeat.body")
    inc_bb = zen_appendbasicblock(func, "repeat.inc")
    end_bb = zen_appendbasicblock(func, "repeat.end")
    push_loop(end_bb, inc_bb)
    zen_br(b, cond_bb)
    zen_positionbuilder(b, cond_bb)
    i_val = LLVMBuildLoad(b, counter, "i")
    cmp = LLVMBuildFCmp(b, 4, i_val, count_d, "cmp")
    zen_condbr(b, cmp, body_bb, end_bb)
    zen_positionbuilder(b, body_bb)
    n = longitud(hijos)
    i = 1
    mientras i < n
        si bloque_actual_tiene_terminator(b) == verdad
            dead_bb = zen_appendbasicblock(current_func, "dead")
            zen_positionbuilder(b, dead_bb)
        codegen_statement(estado, hijos[i])
        i = i + 1
    si bloque_actual_tiene_terminator(b) == falso
        zen_br(b, inc_bb)
    zen_positionbuilder(b, inc_bb)
    cur = LLVMBuildLoad(b, counter, "i")
    one_d = zen_constreal(double_t, 1)
    next_v = zen_fadd(b, cur, one_d, "next")
    LLVMBuildStore(b, next_v, counter)
    zen_br(b, cond_bb)
    zen_positionbuilder(b, end_bb)
    pop_loop()
    retorna 0

# ============================================================
# FuncDecl (1:1 con C++ registerFunction + generateFunctionBody)
# ============================================================

funcion codegen_func_decl(estado, nodo)
    nombre = nodo_nombre(nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    # Contar params (NODO_IDENTIFIER al inicio)
    n = longitud(hijos)
    num_params = 0
    mientras num_params < n
        si nodo_tipo(hijos[num_params]) == NODO_IDENTIFIER
            num_params = num_params + 1
        sino
            romper
    # Crear funcion: todos los params son i8*, return i8* (boxed)
    i8p = i8ptr_type()
    # zen_function_type_1(i8p, NULL, 0)
    # Pasamos cualquier ptr como paramTypes porque paramCount=0
    # Mejor: usar LLVMAddFunction con un function type creado con i8p como ejemplo
    # Declarar segun num_params (limitado a 4 por zen_function_type_4)
    si num_params == 0
        func_ty = zen_function_type_0(i8p, 0)
    si num_params == 1
        func_ty = zen_function_type_1(i8p, i8p, 0)
    si num_params == 2
        func_ty = zen_function_type_2(i8p, i8p, i8p, 0)
    si num_params == 3
        func_ty = zen_function_type_3(i8p, i8p, i8p, i8p, 0)
    si num_params == 4
        func_ty = zen_function_type_4(i8p, i8p, i8p, i8p, i8p, 0)
    si num_params > 4
        # Fallback: 4 params + variadic (los extras se pierden)
        func_ty = zen_function_type_4(i8p, i8p, i8p, i8p, i8p, 1)
    func = LLVMAddFunction(mod, nombre, func_ty)
    # Guardar builder position actual (para volver despues de generar el body)
    saved_bb = LLVMGetInsertBlock(b)
    # Crear entry BB dentro de la funcion
    entry_bb = zen_appendbasicblock(func, "entry")
    zen_positionbuilder(b, entry_bb)
    saved_func = current_func
    current_func = func
    # Guardar scope
    saved_var_nombres = var_nombres
    saved_var_ptrs = var_ptrs
    saved_var_tipos = var_tipos
    var_nombres = []
    var_ptrs = []
    var_tipos = []
    # Crear allocas para params
    i = 0
    mientras i < num_params
        param = LLVMGetParam(func, i)
        param_name = nodo_valor(hijos[i])
        alloca = zen_alloca(b, i8p, param_name)
        LLVMBuildStore(b, param, alloca)
        agregar(var_nombres, param_name)
        agregar(var_ptrs, alloca)
        agregar(var_tipos, TIPO_STRING)
        i = i + 1
    # Generar body
    body_idx = num_params
    mientras body_idx < n
        si bloque_actual_tiene_terminator(b) == verdad
            dead_bb = zen_appendbasicblock(current_func, "dead")
            zen_positionbuilder(b, dead_bb)
        codegen_statement(estado, hijos[body_idx])
        body_idx = body_idx + 1
    # Si el ultimo BB no tiene terminator, agregar ret null
    si bloque_actual_tiene_terminator(b) == falso
        zen_retval(b, LLVMConstPointerNull(i8p))
    # Restaurar scope
    var_nombres = saved_var_nombres
    var_ptrs = saved_var_ptrs
    var_tipos = saved_var_tipos
    current_func = saved_func
    # Volver al builder anterior
    zen_positionbuilder(b, saved_bb)
    retorna 0

# ============================================================
# IndexAssign / MemberAssign / ExternDecl
# ============================================================

funcion codegen_index_assign(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    i64t = LLVMInt64Type()
    base = codegen_expresion(estado, hijos[0])
    base_ptr = LLVMBuildBitCast(b, base, i8ptr_type(), "iabase")
    idx = codegen_expresion(estado, hijos[1])
    idx_d = to_double_val(estado, idx, last_expr_type)
    idx_i64 = LLVMBuildFPToSI(b, idx_d, i64t, "idx")
    val = codegen_expresion(estado, hijos[2])
    val_boxed = to_string_val(estado, val, last_expr_type)
    set_fn = LLVMGetNamedFunction(mod, "__zen_list_set")
    sargs = [base_ptr, idx_i64, val_boxed]
    LLVMBuildCall(b, set_fn, sargs, 3, "lset")
    retorna 0

funcion codegen_member_assign(estado, nodo)
    hijos = nodo_hijos(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    i64t = LLVMInt64Type()
    base = codegen_expresion(estado, hijos[0])
    base_ptr = LLVMBuildBitCast(b, base, i8ptr_type(), "mabase")
    miembro = nodo_nombre(nodo)
    idx = buscar_indice_campo(miembro)
    si idx < 0
        idx = 0
    val = codegen_expresion(estado, hijos[1])
    val_boxed = to_string_val(estado, val, last_expr_type)
    set_fn = LLVMGetNamedFunction(mod, "__zen_struct_set")
    idx_i64 = LLVMConstInt(i64t, idx, 0)
    sargs = [base_ptr, idx_i64, val_boxed]
    LLVMBuildCall(b, set_fn, sargs, 3, "sset")
    retorna 0

funcion codegen_extern_decl(estado, nodo)
    # No generamos IR para la declaracion extern en si.
    # Solo guardamos el nombre para que se pueda llamar despues.
    # La declaracion se hace lazy cuando se llama por primera vez.
    retorna 0

# ============================================================
# Programa (1:1 con C++ generate)
# ============================================================

funcion codegen_programa(estado, programa)
    mod = estado_modulo(estado)
    b = estado_builder(estado)
    # PASS 0: Registrar structs y externs
    n = longitud(programa)
    i = 0
    mientras i < n
        nodo = programa[i]
        si zen_is_null(nodo) == "1"
            printf("WARN: nodo NULL en programa[")
            printf(i)
            printf("] PASS 0\n")
        sino
            si nodo_tipo(nodo) == NODO_STRUCT_DECL
                nombre = nodo_nombre(nodo)
                hijos = nodo_hijos(nodo)
                campos = []
                nc = longitud(hijos)
                j = 0
                mientras j < nc
                    agregar(campos, nodo_valor(hijos[j]))
                    j = j + 1
                registrar_struct(nombre, campos)
            si nodo_tipo(nodo) == NODO_EXTERN_DECL
                codegen_statement(estado, nodo)
        i = i + 1
    # PASS 1: Pre-escanear variables globales (todas son i8* boxed)
    i = 0
    mientras i < n
        nodo = programa[i]
        si zen_is_null(nodo) == "1"
            # skip NULL
        sino
            si nodo_tipo(nodo) == NODO_ASSIGN
                nombre = nodo_nombre(nodo)
                get_o_crear_global(estado, nombre)
        i = i + 1
    # Crear main()
    i32t = LLVMInt32Type()
    i8p = i8ptr_type()
    # main(i32 argc, i8** argv) -> i32
    # zen_function_type_1(i32, i8p_como_param, 0)
    # Pero el segundo param es i8**, no i8*. Pasamos i8p y esperamos que LLVM no valide el tipo exacto.
    i8pp_main = LLVMPointerType(i8p, 0)
    main_ty = zen_function_type_2(i32t, i32t, i8pp_main, 0)
    main_func = LLVMAddFunction(mod, "main", main_ty)
    entry = zen_appendbasicblock(main_func, "entry")
    zen_positionbuilder(b, entry)
    saved_func = current_func
    current_func = main_func
    # Store argc/argv en globals __zen_argc y __zen_argv
    # __zen_argc = global i32
    argc_g = LLVMGetNamedGlobal(mod, "__zen_argc")
    si argc_g == 0
        argc_g = LLVMAddGlobal(mod, i32t, "__zen_argc")
        LLVMSetInitializer(argc_g, LLVMConstInt(i32t, 0, 0))
        LLVMSetLinkage(argc_g, 0)
    argc_param = LLVMGetParam(main_func, 0)
    LLVMBuildStore(b, argc_param, argc_g)
    # __zen_argv = global i8**
    argv_g = LLVMGetNamedGlobal(mod, "__zen_argv")
    i8pp = LLVMPointerType(i8p, 0)
    si argv_g == 0
        argv_g = LLVMAddGlobal(mod, i8pp, "__zen_argv")
        LLVMSetInitializer(argv_g, LLVMConstPointerNull(i8pp))
        LLVMSetLinkage(argv_g, 0)
    argv_param = LLVMGetParam(main_func, 1)
    LLVMBuildStore(b, argv_param, argv_g)
    # PASS 2: Generar cuerpos de funciones
    i = 0
    mientras i < n
        nodo = programa[i]
        si zen_is_null(nodo) == "1"
            # skip NULL
        sino
            si nodo_tipo(nodo) == NODO_FUNC_DECL
                codegen_func_decl(estado, nodo)
        i = i + 1
    # PASS 3: Generar resto del codigo de nivel superior
    i = 0
    mientras i < n
        nodo = programa[i]
        si zen_is_null(nodo) == "1"
            # skip NULL
        sino
            tipo = nodo_tipo(nodo)
            si tipo != NODO_FUNC_DECL y tipo != NODO_STRUCT_DECL y tipo != NODO_EXTERN_DECL
                codegen_statement(estado, nodo)
        i = i + 1
    # ret 0
    zen_retval(b, LLVMConstInt(i32t, 0, 0))
    current_func = saved_func
    retorna 0

# ============================================================
# Compilar / Nativo
# ============================================================

funcion codegen_compilar(estado, ruta_salida)
    LLVMPrintModuleToFile(estado_modulo(estado), ruta_salida, nada)
    retorna 0

funcion codegen_compilar_nativo(estado, ruta_obj)
    # Workaround: usar llc externo porque LLVMGetTargetFromTriple necesita
    # output parameters (ptr a ptr) que Zen no soporta bien
    # 1. Escribir IR a archivo temporal .ll
    ll_file = ruta_obj + ".ll"
    LLVMPrintModuleToFile(estado_modulo(estado), ll_file, nada)
    # 2. Ejecutar llc para compilar .ll a .o
    cmd = "llc-14 -filetype=obj " + ll_file + " -o " + ruta_obj
    system(cmd)
    # 3. Borrar el .ll temporal
    cmd2 = "rm -f " + ll_file
    system(cmd2)
    retorna 0
