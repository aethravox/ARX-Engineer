# parser.zen — Parser de Zen escrito EN Zen
#
# Modulo: funcion parsear(tokens) -> lista[Nodo]
#         construye el AST a partir de la lista de tokens producida por lexer.
#
# Importa: ast (structs Nodo + constantes), lexer (token accessors + tokenizar)

importar "ast"
importar "lexer"

extern "libLLVM" __zen_list_len(ptr) -> long
extern "libLLVM" __zen_list_get(ptr, long) -> ptr
extern "libc" printf(str) -> int
extern "libc" strcmp(str, str) -> int

# ============================================================
# Estado del parser (modulo-level)
# ============================================================

tokens_parser = []
pos_parser = 0

# ============================================================
# Helpers del parser
# ============================================================

funcion peek()
    idx = pos_parser
    n = __zen_list_len(tokens_parser)
    si idx >= n
        idx = n - 1
    retorna __zen_list_get(tokens_parser, idx)

funcion avanzar()
    idx = pos_parser
    n = __zen_list_len(tokens_parser)
    si idx >= n
        idx = n - 1
    t = __zen_list_get(tokens_parser, idx)
    si pos_parser < n - 1
        pos_parser = pos_parser + 1
    retorna t

funcion verificar(tipo)
    retorna token_tipo(peek()) == tipo

funcion match_token(tipo)
    si token_tipo(peek()) == tipo
        avanzar()
        retorna verdad
    retorna falso

# Salta todos los NEWLINE seguidos (lineas vacias y de comentario generan uno cada una)
funcion saltar_nuevas_lineas()
    mientras token_tipo(peek()) == 67
        avanzar()

# Salta NEWLINE y DEDENT sueltos (solo a nivel superior)
funcion saltar_separadores()
    seguir = verdad
    mientras seguir == verdad
        seguir = falso
        si token_tipo(peek()) == 67
            avanzar()
            seguir = verdad
        si token_tipo(peek()) == 69
            avanzar()
            seguir = verdad

# Si el token no es el esperado: error y salir.
# (Antes solo imprimia y seguia SIN avanzar, y los bucles del parser giraban para siempre)
funcion consumir(tipo, msg)
    si token_tipo(peek()) == tipo
        retorna avanzar()
    muestra "ERROR: " + msg + " en linea " + token_linea(peek())
    salir(1)

# ============================================================
# Bloques y statements
# ============================================================

funcion es_fin_bloque(tipo)
    si tipo == 69
        retorna verdad
    si tipo == 0
        retorna verdad
    si tipo == 5
        retorna verdad
    si tipo == 6
        retorna verdad
    si tipo == 25
        retorna verdad
    si tipo == 26
        retorna verdad
    retorna falso

funcion parsear_bloque()
    stmts = []
    saltar_nuevas_lineas()
    mientras es_fin_bloque(token_tipo(peek())) == falso
        s = parsear_statement()
        agregar(stmts, s)
        saltar_nuevas_lineas()
    si token_tipo(peek()) == 69
        avanzar()
    retorna stmts

# Parsea: extern "lib" nombre(args) -> tipo
# Lee y descarta la declaracion extern (no genera nodo AST)
# Salta todos los tokens hasta encontrar NEWLINE o EOF
funcion parsear_extern()
    avanzar()
    mientras token_tipo(peek()) != 67
        si token_tipo(peek()) == 0
            retorna nada
        avanzar()
    # Saltar NEWLINE y DEDENT
    mientras token_tipo(peek()) == 67
        avanzar()
    mientras token_tipo(peek()) == 69
        avanzar()
    retorna nada

funcion parsear_statement()
    # Saltar DEDENTs sueltos
    mientras token_tipo(peek()) == 69
        avanzar()
    t = peek()
    si token_tipo(t) == 19
        return parsear_print()
    si token_tipo(t) == 4
        return parsear_si()
    si token_tipo(t) == 7
        return parsear_para()
    si token_tipo(t) == 10
        return parsear_mientras()
    si token_tipo(t) == 13
        return parsear_repetir()
    si token_tipo(t) == 17
        return parsear_funcion()
    # extern: detectar con strcmp
    si strcmp(token_valor(t), "extern") == 0
        return parsear_extern()
    si token_tipo(t) == 18
        avanzar()
        expr = parsear_expresion()
        n_ret = crear_nodo(21, "", token_linea(t))
        agregar(n_ret.hijos, expr)
        return n_ret
    si token_tipo(t) == 15
        avanzar()
        return crear_nodo(18, "", token_linea(t))
    si token_tipo(t) == 16
        avanzar()
        return crear_nodo(19, "", token_linea(t))
    return parsear_expr_stmt()

funcion parsear_print()
    t = avanzar()
    expr = parsear_expresion()
    n = crear_nodo(12, "", token_linea(t))
    agregar(n.hijos, expr)
    retorna n

funcion parsear_si()
    t = avanzar()
    cond = parsear_expresion()
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    sino_cuerpo = []
    # sino / else
    es_sino = falso
    si token_tipo(peek()) == 5
        es_sino = verdad
    si token_tipo(peek()) == 6
        es_sino = verdad
    si es_sino == verdad
        avanzar()
        # sino si / elif
        es_elif = falso
        si token_tipo(peek()) == 4
            es_elif = verdad
        si token_tipo(peek()) == 6
            es_elif = verdad
        si es_elif == verdad
            elif_stmt = parsear_si()
            agregar(sino_cuerpo, elif_stmt)
        sino
            saltar_nuevas_lineas()
            si token_tipo(peek()) == 68
                avanzar()
            sino_cuerpo = parsear_bloque()
    n = crear_nodo(13, "", token_linea(t))
    agregar(n.hijos, cond)
    para cada s en cuerpo
        agregar(n.hijos, s)
    n.nombre = "sino"
    para cada s in sino_cuerpo
        agregar(n.hijos, s)
    retorna n

funcion parsear_mientras()
    t = avanzar()
    cond = parsear_expresion()
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    n = crear_nodo(16, "", token_linea(t))
    agregar(n.hijos, cond)
    para cada s en cuerpo
        agregar(n.hijos, s)
    retorna n

funcion parsear_repetir()
    t = avanzar()
    cuenta = parsear_expresion()
    si token_tipo(peek()) == 14
        avanzar()
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    n = crear_nodo(17, "", token_linea(t))
    agregar(n.hijos, cuenta)
    para cada s en cuerpo
        agregar(n.hijos, s)
    retorna n

funcion parsear_funcion()
    t = avanzar()
    nombre_tok = avanzar()
    consumir(57, "Se esperaba ( despues de funcion")
    params = []
    si token_tipo(peek()) != 58
        agregar(params, token_valor(avanzar()))
        mientras token_tipo(peek()) == 63
            avanzar()
            agregar(params, token_valor(avanzar()))
    consumir(58, "Se esperaba ) ")
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    n = crear_nodo(20, "", token_linea(t))
    n.nombre = nombre_tok.valor
    para cada p en params
        agregar(n.hijos, crear_nodo(5, p, token_linea(t)))
    para cada s en cuerpo
        agregar(n.hijos, s)
    retorna n

funcion parsear_para()
    t = avanzar()
    var_tok = avanzar()
    si token_tipo(peek()) == 8
        avanzar()
        desde_expr = parsear_expresion()
        si token_tipo(peek()) == 9
            avanzar()
            hasta_expr = parsear_expresion()
        saltar_nuevas_lineas()
        si token_tipo(peek()) == 68
            avanzar()
        cuerpo = parsear_bloque()
        n = crear_nodo(14, "", token_linea(t))
        n.nombre = var_tok.valor
        agregar(n.hijos, desde_expr)
        agregar(n.hijos, hasta_expr)
        para cada s en cuerpo
            agregar(n.hijos, s)
        retorna n
    retorna crear_nodo(22, "", token_linea(t))

funcion parsear_expr_stmt()
    expr = parsear_expresion()
    # asignacion: identificador = valor o identificador += valor
    es_assign = falso
    si nodo_tipo(expr) == 5
        si token_tipo(peek()) == 49
            es_assign = verdad
        si token_tipo(peek()) == 50
            es_assign = verdad
    si es_assign == verdad
        op = "="
        si token_tipo(peek()) == 50
            op = "+"
        avanzar()
        valor = parsear_expresion()
        n = crear_nodo(10, "", nodo_linea(expr))
        n.nombre = nodo_valor(expr)
        agregar(n.hijos, valor)
        retorna n
    n = crear_nodo(22, "", nodo_linea(expr))
    agregar(n.hijos, expr)
    retorna n

# ============================================================
# Expresiones (precedencia descendente)
# ============================================================

funcion parsear_expresion()
    expr = parsear_or()
    si token_tipo(peek()) == 66
        avanzar()
        then_expr = parsear_expresion()
        consumir(65, "Se esperaba :")
        else_expr = parsear_expresion()
        n = crear_nodo(8, "", nodo_linea(expr))
        agregar(n.hijos, expr)
        agregar(n.hijos, then_expr)
        agregar(n.hijos, else_expr)
        retorna n
    retorna expr

funcion parsear_or()
    left = parsear_and()
    mientras token_tipo(peek()) == 21
        t = avanzar()
        right = parsear_and()
        n = crear_nodo_op(6, "or", token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
    retorna left

funcion parsear_and()
    left = parsear_comparacion()
    mientras token_tipo(peek()) == 20
        t = avanzar()
        right = parsear_comparacion()
        n = crear_nodo_op(6, "and", token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
    retorna left

funcion parsear_comparacion()
    left = parsear_suma_resta()
    # mientras token_tipo(peek()) >= 43 y <= 48
    en_rango = falso
    si token_tipo(peek()) >= 43
        si token_tipo(peek()) <= 48
            en_rango = verdad
    mientras en_rango == verdad
        t = avanzar()
        right = parsear_suma_resta()
        n = crear_nodo_op(6, token_valor(t), token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
        # recalcular en_rango
        en_rango = falso
        si token_tipo(peek()) >= 43
            si token_tipo(peek()) <= 48
                en_rango = verdad
    retorna left

funcion parsear_suma_resta()
    left = parsear_mul_div()
    es_suma = falso
    si token_tipo(peek()) == 37
        es_suma = verdad
    si token_tipo(peek()) == 38
        es_suma = verdad
    mientras es_suma == verdad
        t = avanzar()
        right = parsear_mul_div()
        n = crear_nodo_op(6, token_valor(t), token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
        es_suma = falso
        si token_tipo(peek()) == 37
            es_suma = verdad
        si token_tipo(peek()) == 38
            es_suma = verdad
    retorna left

funcion parsear_mul_div()
    left = parsear_potencia()
    es_mul = falso
    si token_tipo(peek()) == 39
        es_mul = verdad
    si token_tipo(peek()) == 40
        es_mul = verdad
    si token_tipo(peek()) == 41
        es_mul = verdad
    mientras es_mul == verdad
        t = avanzar()
        right = parsear_potencia()
        n = crear_nodo_op(6, token_valor(t), token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
        es_mul = falso
        si token_tipo(peek()) == 39
            es_mul = verdad
        si token_tipo(peek()) == 40
            es_mul = verdad
        si token_tipo(peek()) == 41
            es_mul = verdad
    retorna left

funcion parsear_potencia()
    left = parsear_unario()
    si token_tipo(peek()) == 42
        t = avanzar()
        right = parsear_potencia()
        n = crear_nodo_op(6, "^", token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        retorna n
    retorna left

funcion parsear_unario()
    si token_tipo(peek()) == 38
        t = avanzar()
        operand = parsear_unario()
        n = crear_nodo_op(7, "-", token_linea(t))
        agregar(n.hijos, operand)
        retorna n
    retorna parsear_primario()

funcion parsear_primario()
    t = peek()
    # verdad / yes
    si token_tipo(t) == 34
        avanzar()
        return crear_nodo(3, token_valor(t), token_linea(t))
    # falso / no
    si token_tipo(t) == 35
        avanzar()
        return crear_nodo(3, token_valor(t), token_linea(t))
    si token_tipo(t) == 36
        avanzar()
        return crear_nodo(4, "nada", token_linea(t))
    si token_tipo(t) == 1
        avanzar()
        return crear_nodo(1, token_valor(t), token_linea(t))
    si token_tipo(t) == 2
        avanzar()
        return crear_nodo(2, token_valor(t), token_linea(t))
    si token_tipo(t) == 59
        avanzar()
        elementos = []
        si token_tipo(peek()) != 60
            agregar(elementos, parsear_expresion())
            mientras token_tipo(peek()) == 63
                avanzar()
                agregar(elementos, parsear_expresion())
        consumir(60, "Se esperaba ]")
        n = crear_nodo(23, "", token_linea(t))
        para cada e en elementos
            agregar(n.hijos, e)
        retorna n
    si token_tipo(t) == 57
        avanzar()
        expr = parsear_expresion()
        consumir(58, "Se esperaba )")
        retorna expr
    # identificador o keyword seguido de ( → funcion call
    es_id = falso
    si token_tipo(t) == 3
        es_id = verdad
    si token_tipo(t) == 20
        es_id = verdad
    si token_tipo(t) == 21
        es_id = verdad
    si token_tipo(t) == 23
        es_id = verdad
    si token_tipo(t) == 11
        es_id = verdad
    si es_id == verdad
        avanzar()
        si token_tipo(peek()) == 57
            avanzar()
            args = []
            si token_tipo(peek()) != 58
                agregar(args, parsear_expresion())
                mientras token_tipo(peek()) == 63
                    avanzar()
                    agregar(args, parsear_expresion())
            consumir(58, "Se esperaba )")
            n = crear_nodo(9, "", token_linea(t))
            n.nombre = token_valor(t)
            para cada a en args
                agregar(n.hijos, a)
            retorna n
        return crear_nodo(5, token_valor(t), token_linea(t))
    # Este token no puede empezar una expresion. Antes se devolvia un nodo vacio
    # SIN consumir el token y los bucles del parser giraban para siempre.
    muestra "ERROR: Token inesperado '" + token_valor(t) + "' (tipo " + token_tipo(t) + ") en linea " + token_linea(t)
    salir(1)

# ============================================================
# Entry point del parser
# ============================================================

funcion parsear(lista_tokens)
    tokens_parser = lista_tokens
    pos_parser = 0
    programa = []
    saltar_separadores()
    mientras token_tipo(peek()) != 0
        s = parsear_statement()
        agregar(programa, s)
        saltar_separadores()
    retorna programa
