# parser.zen — Parser de Zen escrito EN Zen (1:1 con C++)
#
# Modulo: funcion parsear(tokens) -> lista[Nodo]
#         construye el AST a partir de la lista de tokens producida por lexer.
#
# Importa: ast (structs Nodo + constantes), lexer (token accessors + tokenizar)

importar "ast"
importar "lexer"

extern "libLLVM" __zen_list_len(ptr) -> long
extern "libLLVM" __zen_list_get(ptr, long) -> ptr
extern "libc" printf(str) -> int
extern "libc" strcmp(str, str) -> int

# ============================================================
# Estado del parser (modulo-level)
# ============================================================

tokens_parser = []
pos_parser = 0

# ============================================================
# Helpers del parser
# ============================================================

funcion peek()
    idx = pos_parser
    n = __zen_list_len(tokens_parser)
    si idx >= n
        idx = n - 1
    retorna __zen_list_get(tokens_parser, idx)

funcion avanzar()
    idx = pos_parser
    n = __zen_list_len(tokens_parser)
    si idx >= n
        idx = n - 1
    t = __zen_list_get(tokens_parser, idx)
    si pos_parser < n - 1
        pos_parser = pos_parser + 1
    retorna t

funcion verificar(tipo)
    retorna token_tipo(peek()) == tipo

funcion match_token(tipo)
    si token_tipo(peek()) == tipo
        avanzar()
        retorna verdad
    retorna falso

# Salta todos los NEWLINE seguidos
funcion saltar_nuevas_lineas()
    mientras token_tipo(peek()) == 67
        avanzar()

# Salta NEWLINE y DEDENT sueltos (solo a nivel superior)
funcion saltar_separadores()
    seguir = verdad
    mientras seguir == verdad
        seguir = falso
        si token_tipo(peek()) == 67
            avanzar()
            seguir = verdad
        si token_tipo(peek()) == 69
            avanzar()
            seguir = verdad

funcion consumir(tipo, msg)
    si token_tipo(peek()) == tipo
        retorna avanzar()
    muestra "ERROR: " + msg + " en linea " + token_linea(peek())
    salir(1)

# ============================================================
# Bloques y statements
# ============================================================

funcion es_fin_bloque(tipo)
    si tipo == 69
        retorna "1"
    si tipo == 0
        retorna "1"
    si tipo == 5
        retorna "1"
    si tipo == 6
        retorna "1"
    retorna "0"

funcion parsear_bloque()
    stmts = []
    saltar_nuevas_lineas()
    mientras es_fin_bloque(token_tipo(peek())) == "0"
        s = parsear_statement()
        agregar(stmts, s)
        saltar_nuevas_lineas()
    si token_tipo(peek()) == 69
        avanzar()
    retorna stmts

# Parsea: extern "lib" nombre(tipo1, tipo2, ...) -> tipo_ret
# Genera un NODO_EXTERN_DECL con valor="ret|tipo1,tipo2,..."
# C types: int, long, double, float, void, str, ptr, char
funcion parsear_extern()
    ln = token_linea(peek())
    avanzar()  # 'extern'
    # String con nombre de libreria
    si token_tipo(peek()) != 2
        muestra "ERROR: Se esperaba string con libreria despues de 'extern' en linea " + texto(ln)
        salir(1)
    lib = token_valor(avanzar())
    # Nombre de funcion
    nombre = token_valor(avanzar())
    consumir(57, "Se esperaba ( despues de funcion externa")
    # Parsear tipos de params
    param_tipos = []
    si token_tipo(peek()) != 58
        agregar(param_tipos, token_valor(avanzar()))
        # Si sigue *, es ptr: lo marcamos con sufijo
        si strcmp(token_valor(peek()), "*") == 0
            avanzar()
        mientras token_tipo(peek()) == 63
            avanzar()
            agregar(param_tipos, token_valor(avanzar()))
            si strcmp(token_valor(peek()), "*") == 0
                avanzar()
    consumir(58, "Se esperaba ) al final de params externos")
    # Flecha -> tipo
    si token_tipo(peek()) != 56
        muestra "ERROR: Se esperaba -> despues de params en linea " + texto(ln)
        salir(1)
    avanzar()
    ret_tipo = token_valor(avanzar())
    si strcmp(token_valor(peek()), "*") == 0
        avanzar()
    # Saltar NEWLINE y DEDENT
    mientras token_tipo(peek()) == 67
        avanzar()
    mientras token_tipo(peek()) == 69
        avanzar()
    retorna nodo_extern_decl(lib, nombre, ret_tipo, param_tipos, ln)

funcion parsear_statement()
    # Saltar DEDENTs sueltos
    mientras token_tipo(peek()) == 69
        avanzar()
    t = peek()
    si token_tipo(t) == 19
        retorna parsear_print()
    si token_tipo(t) == 4
        retorna parsear_si()
    si token_tipo(t) == 7
        retorna parsear_para()
    si token_tipo(t) == 10
        retorna parsear_mientras()
    si token_tipo(t) == 13
        retorna parsear_repetir()
    si token_tipo(t) == 17
        retorna parsear_funcion()
    # extern: detectar con strcmp (no es keyword)
    si strcmp(token_valor(t), "extern") == 0
        retorna parsear_extern()
    si token_tipo(t) == 18
        avanzar()
        expr = parsear_expresion()
        n_ret = crear_nodo(NODO_RETURN, "", token_linea(t))
        agregar(n_ret.hijos, expr)
        retorna n_ret
    si token_tipo(t) == 15
        avanzar()
        retorna crear_nodo(NODO_BREAK, "", token_linea(t))
    si token_tipo(t) == 16
        avanzar()
        retorna crear_nodo(NODO_CONTINUE, "", token_linea(t))
    # plataforma: detectar con strcmp
    si strcmp(token_valor(t), "plataforma") == 0 o strcmp(token_valor(t), "platform") == 0
        retorna parsear_plataforma()
    # estructura: detectar con strcmp
    si strcmp(token_valor(t), "estructura") == 0 o strcmp(token_valor(t), "struct") == 0
        retorna parsear_estructura_decl()
    # importar: detectar con strcmp (importar es keyword pero no tiene tipo fijo en parser)
    si strcmp(token_valor(t), "importar") == 0 o strcmp(token_valor(t), "import") == 0
        # Avanzar y consumir el string del nombre del modulo
        avanzar()
        # Esperar un string con el nombre del modulo
        si token_tipo(peek()) == 2
            nombre_modulo = token_valor(avanzar())
            # Crear un nodo vacio (los imports se resuelven en main.zen, no en codegen)
            retorna crear_nodo(NODO_EXPR_STMT, "", token_linea(t))
        # Si no es string, crear nodo vacio y dejar que continue
        retorna crear_nodo(NODO_EXPR_STMT, "", token_linea(t))
    # estructura implicita: Nombre { campo, campo, ... }
    si token_tipo(t) == 3
        # lookahead: si el siguiente es '{'
        # (lo manejamos en parsear_expr_stmt para no romper otras cosas)
        retorna parsear_expr_stmt()
    retorna parsear_expr_stmt()

funcion parsear_print()
    t = avanzar()
    expr = parsear_expresion()
    retorna nodo_print(expr, token_linea(t))

funcion parsear_si()
    t = avanzar()  # 'si'/'if'
    cond = parsear_expresion()
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    sino_cuerpo = []
    # sino / else
    es_sino = "0"
    si token_tipo(peek()) == 5
        es_sino = "1"
    si es_sino == "1"
        avanzar()
        # sino si / elif
        es_elif = "0"
        si token_tipo(peek()) == 4
            es_elif = "1"
        si token_tipo(peek()) == 6
            es_elif = "1"
        si es_elif == "1"
            # Generar un if anidado como cuerpo del sino
            elif_stmt = parsear_si()
            agregar(sino_cuerpo, elif_stmt)
        sino
            saltar_nuevas_lineas()
            si token_tipo(peek()) == 68
                avanzar()
            sino_cuerpo = parsear_bloque()
    retorna nodo_if(cond, cuerpo, sino_cuerpo, token_linea(t))

funcion parsear_mientras()
    t = avanzar()
    cond = parsear_expresion()
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    retorna nodo_while(cond, cuerpo, token_linea(t))

funcion parsear_repetir()
    t = avanzar()
    cuenta = parsear_expresion()
    si token_tipo(peek()) == 14  # 'veces'/'times'
        avanzar()
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    retorna nodo_repeat(cuenta, cuerpo, token_linea(t))

funcion parsear_funcion()
    t = avanzar()
    nombre_tok = avanzar()
    consumir(57, "Se esperaba ( despues de funcion")
    params = []
    si token_tipo(peek()) != 58
        agregar(params, token_valor(avanzar()))
        mientras token_tipo(peek()) == 63
            avanzar()
            agregar(params, token_valor(avanzar()))
    consumir(58, "Se esperaba ) ")
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    retorna nodo_func_decl(nombre_tok.valor, params, cuerpo, token_linea(t))

funcion parsear_para()
    t = avanzar()  # 'para'/'for'
    var_tok = avanzar()
    # para cada x en expr  → for-each
    si token_tipo(peek()) == 12  # 'cada'/'each'
        avanzar()
        # siguiente: var_tok ya fue consumido, sera el nombre del loop var
        # pero 'cada' espera el var antes, aqui reorganizamos:
        # patrón correcto: para cada <var> en <iter>
        var_name = var_tok.valor
        # esperar 'en'/'in'
        consumir(11, "Se esperaba 'en' despues de 'cada <var>'")
        iterable = parsear_expresion()
        saltar_nuevas_lineas()
        si token_tipo(peek()) == 68
            avanzar()
        cuerpo = parsear_bloque()
        retorna nodo_for_each(var_name, iterable, cuerpo, token_linea(t))
    # para <var> desde <expr> hasta <expr>
    si token_tipo(peek()) == 8  # 'desde'/'from'
        avanzar()
        desde_expr = parsear_expresion()
        si token_tipo(peek()) == 9  # 'hasta'/'to'
            avanzar()
            hasta_expr = parsear_expresion()
        saltar_nuevas_lineas()
        si token_tipo(peek()) == 68
            avanzar()
        cuerpo = parsear_bloque()
        retorna nodo_for_range(var_tok.valor, desde_expr, hasta_expr, cuerpo, token_linea(t))
    retorna crear_nodo(NODO_EXPR_STMT, "", token_linea(t))

funcion parsear_plataforma()
    t = avanzar()  # 'plataforma'/'platform'
    nombre_plat = token_valor(avanzar())
    saltar_nuevas_lineas()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    # Esperar fin_plataforma / end_platform (opcional)
    si strcmp(token_valor(peek()), "fin_plataforma") == 0
        avanzar()
    si strcmp(token_valor(peek()), "end_platform") == 0
        avanzar()
    retorna nodo_platform(nombre_plat, cuerpo, token_linea(t))

funcion parsear_estructura_decl()
    t = avanzar()  # 'estructura'/'struct'
    nombre = token_valor(avanzar())
    # Esperar { campo, campo, ... }
    consumir(61, "Se esperaba { despues de struct")
    campos = []
    saltar_nuevas_lineas()
    si token_tipo(peek()) != 62  # no es '}' inmediato
        agregar(campos, token_valor(avanzar()))
        mientras token_tipo(peek()) == 63
            avanzar()
            saltar_nuevas_lineas()
            agregar(campos, token_valor(avanzar()))
    consumir(62, "Se esperaba } al final de struct")
    retorna nodo_struct_decl(nombre, campos, token_linea(t))

funcion parsear_expr_stmt()
    # Detectar struct literal implicito: Nombre { campo: valor, ... }
    t = peek()
    si token_tipo(t) == 3  # IDENTIFIER
        # lookahead: siguiente token
        # (no podemos mirar sin avanzar; workaround: avanzar y ver)
        # Para simplicidad, dejamos que parsear_expresion lo maneje
        # (cuando vea '{' intentara StructLit)
        ""
    expr = parsear_expresion()
    # asignacion: identificador = valor o identificador += valor
    es_assign = falso
    es_aug = falso
    aug_op = ""
    si nodo_tipo(expr) == NODO_IDENTIFIER
        si token_tipo(peek()) == 49  # '='
            es_assign = verdad
        si token_tipo(peek()) == 50  # '+='
            es_aug = verdad
            aug_op = "+"
        si token_tipo(peek()) == 51  # '-='
            es_aug = verdad
            aug_op = "-"
        si token_tipo(peek()) == 52  # '*='
            es_aug = verdad
            aug_op = "*"
        si token_tipo(peek()) == 53  # '/='
            es_aug = verdad
            aug_op = "/"
        si token_tipo(peek()) == 54  # '%='
            es_aug = verdad
            aug_op = "%"
        si token_tipo(peek()) == 55  # '^='
            es_aug = verdad
            aug_op = "^"
    si es_assign == verdad
        avanzar()
        valor = parsear_expresion()
        retorna nodo_assign(nodo_valor(expr), valor, nodo_linea(expr))
    si es_aug == verdad
        avanzar()
        valor = parsear_expresion()
        retorna nodo_aug_assign(nodo_valor(expr), aug_op, valor, nodo_linea(expr))
    # IndexAssign: lista[0] = valor
    si nodo_tipo(expr) == NODO_INDEX_ACCESS
        si token_tipo(peek()) == 49
            avanzar()
            valor = parsear_expresion()
            hijos = nodo_hijos(expr)
            base = hijos[0]
            idx = hijos[1]
            ln = nodo_linea(expr)
            retorna nodo_index_assign(base, idx, valor, ln)
    # MemberAssign: obj.campo = valor
    si nodo_tipo(expr) == NODO_MEMBER_ACCESS
        si token_tipo(peek()) == 49
            avanzar()
            valor = parsear_expresion()
            hijos = nodo_hijos(expr)
            base = hijos[0]
            miembro = nodo_nombre(expr)
            ln = nodo_linea(expr)
            retorna nodo_member_assign(base, miembro, valor, ln)
    n = crear_nodo(NODO_EXPR_STMT, "", nodo_linea(expr))
    agregar(n.hijos, expr)
    retorna n

# ============================================================
# Expresiones (precedencia descendente)
# ============================================================

funcion parsear_expresion()
    expr = parsear_or()
    si token_tipo(peek()) == 66  # '?'
        avanzar()
        then_expr = parsear_expresion()
        consumir(65, "Se esperaba :")
        else_expr = parsear_expresion()
        n = nodo_ternary(expr, then_expr, else_expr, nodo_linea(expr))
        retorna n
    retorna expr

funcion parsear_or()
    left = parsear_and()
    mientras token_tipo(peek()) == 21  # 'o'/'or'
        t = avanzar()
        right = parsear_and()
        n = nodo_binary_op("or", left, right, token_linea(t))
        left = n
    retorna left

funcion parsear_and()
    left = parsear_comparacion()
    mientras token_tipo(peek()) == 20  # 'y'/'and'
        t = avanzar()
        right = parsear_comparacion()
        n = nodo_binary_op("and", left, right, token_linea(t))
        left = n
    retorna left

funcion parsear_comparacion()
    left = parsear_suma_resta()
    en_rango = falso
    si token_tipo(peek()) >= 43
        si token_tipo(peek()) <= 48
            en_rango = verdad
    mientras en_rango == verdad
        t = avanzar()
        right = parsear_suma_resta()
        n = nodo_binary_op(token_valor(t), left, right, token_linea(t))
        left = n
        en_rango = falso
        si token_tipo(peek()) >= 43
            si token_tipo(peek()) <= 48
                en_rango = verdad
    retorna left

funcion parsear_suma_resta()
    left = parsear_mul_div()
    es_suma = falso
    si token_tipo(peek()) == 37
        es_suma = verdad
    si token_tipo(peek()) == 38
        es_suma = verdad
    mientras es_suma == verdad
        t = avanzar()
        right = parsear_mul_div()
        n = nodo_binary_op(token_valor(t), left, right, token_linea(t))
        left = n
        es_suma = falso
        si token_tipo(peek()) == 37
            es_suma = verdad
        si token_tipo(peek()) == 38
            es_suma = verdad
    retorna left

funcion parsear_mul_div()
    left = parsear_potencia()
    es_mul = falso
    si token_tipo(peek()) == 39
        es_mul = verdad
    si token_tipo(peek()) == 40
        es_mul = verdad
    si token_tipo(peek()) == 41
        es_mul = verdad
    mientras es_mul == verdad
        t = avanzar()
        right = parsear_potencia()
        n = nodo_binary_op(token_valor(t), left, right, token_linea(t))
        left = n
        es_mul = falso
        si token_tipo(peek()) == 39
            es_mul = verdad
        si token_tipo(peek()) == 40
            es_mul = verdad
        si token_tipo(peek()) == 41
            es_mul = verdad
    retorna left

funcion parsear_potencia()
    left = parsear_unario()
    si token_tipo(peek()) == 42  # '^'
        t = avanzar()
        right = parsear_potencia()
        n = nodo_binary_op("^", left, right, token_linea(t))
        retorna n
    retorna left

funcion parsear_unario()
    # unary '-'
    si token_tipo(peek()) == 38
        t = avanzar()
        operand = parsear_unario()
        n = nodo_unary_op("-", operand, token_linea(t))
        retorna n
    # unary 'no' / 'not'
    si token_tipo(peek()) == 22
        t = avanzar()
        operand = parsear_unario()
        n = nodo_unary_op("not", operand, token_linea(t))
        retorna n
    retorna parsear_primario()

funcion parsear_primario()
    t = peek()
    # verdad / yes
    si token_tipo(t) == 34
        avanzar()
        retorna nodo_bool("verdad", token_linea(t))
    # falso
    si token_tipo(t) == 35
        avanzar()
        retorna nodo_bool("falso", token_linea(t))
    si token_tipo(t) == 36  # nada / nothing
        avanzar()
        retorna nodo_null(token_linea(t))
    si token_tipo(t) == 1  # NUMBER
        avanzar()
        retorna nodo_number(token_valor(t), token_linea(t))
    si token_tipo(t) == 2  # STRING
        avanzar()
        retorna nodo_string(token_valor(t), token_linea(t))
    si token_tipo(t) == 59  # '['
        avanzar()
        elementos = []
        si token_tipo(peek()) != 60
            agregar(elementos, parsear_expresion())
            mientras token_tipo(peek()) == 63
                avanzar()
                agregar(elementos, parsear_expresion())
        consumir(60, "Se esperaba ]")
        retorna nodo_list_lit(elementos, token_linea(t))
    si token_tipo(t) == 57  # '('
        avanzar()
        expr = parsear_expresion()
        consumir(58, "Se esperaba )")
        retorna expr
    # StructLit implicito: Nombre { campo: valor, ... }
    si token_tipo(t) == 3  # IDENTIFIER
        # lookahead: si siguiente es '{' y los elementos son 'campo: valor', es StructLit
        # No podemos mirar sin avanzar. Avanzar, ver, y backtrackear si no era.
        save_pos = pos_parser
        avanzar()  # IDENTIFIER
        si token_tipo(peek()) == 61  # '{'
            # Intentar StructLit
            struct_name = token_valor(t)
            avanzar()  # '{'
            saltar_nuevas_lineas()
            campos = []
            valores = []
            # Si siguiente es '}', struct vacio
            si token_tipo(peek()) != 62
                # Parsear primer campo: nombre ':' valor  O  solo nombre
                si token_tipo(peek()) == 3
                    nombre_campo = token_valor(avanzar())
                    agregar(campos, nombre_campo)
                    si token_tipo(peek()) == 65  # ':'
                        avanzar()
                        agregar(valores, parsear_expresion())
                    sino
                        # solo nombre, valor vacio
                        agregar(valores, nodo_null(token_linea(t)))
                    mientras token_tipo(peek()) == 63
                        avanzar()
                        saltar_nuevas_lineas()
                        nombre_campo = token_valor(avanzar())
                        agregar(campos, nombre_campo)
                        si token_tipo(peek()) == 65
                            avanzar()
                            agregar(valores, parsear_expresion())
                        sino
                            agregar(valores, nodo_null(token_linea(t)))
                sino
                    # no es StructLit, restaurar
                    pos_parser = save_pos
                    retorna parsear_func_call_o_id()
            consumir(62, "Se esperaba } en struct lit")
            retorna nodo_struct_lit(struct_name, campos, valores, token_linea(t))
        sino
            # no era '{', restaurar y manejar como func call o id
            pos_parser = save_pos
            retorna parsear_func_call_o_id()
    # identificador o keyword seguido de ( → funcion call
    es_id = falso
    si token_tipo(t) == 3
        es_id = verdad
    si token_tipo(t) == 20
        es_id = verdad
    si token_tipo(t) == 21
        es_id = verdad
    si token_tipo(t) == 23
        es_id = verdad
    si token_tipo(t) == 11
        es_id = verdad
    si es_id == verdad
        retorna parsear_func_call_o_id()
    # Este token no puede empezar una expresion
    muestra "ERROR: Token inesperado '" + token_valor(t) + "' (tipo " + texto(token_tipo(t)) + ") en linea " + texto(token_linea(t))
    salir(1)

# Parsea un identificador o llamada a funcion: foo, foo(a, b), foo.campo, foo[0]
funcion parsear_func_call_o_id()
    t = peek()
    avanzar()  # IDENTIFIER
    # Si sigue '(', es FuncCall
    si token_tipo(peek()) == 57
        avanzar()
        args = []
        si token_tipo(peek()) != 58
            agregar(args, parsear_expresion())
            mientras token_tipo(peek()) == 63
                avanzar()
                agregar(args, parsear_expresion())
        consumir(58, "Se esperaba )")
        # Postfix: .campo o [indice]
        base = nodo_func_call(token_valor(t), args, token_linea(t))
        retorna parsear_postfix(base)
    # Si sigue '.', es MemberAccess
    si token_tipo(peek()) == 64  # '.'
        avanzar()
        miembro_tok = avanzar()
        base = nodo_member_access(nodo_identifier(token_valor(t), token_linea(t)), miembro_tok.valor, token_linea(t))
        retorna parsear_postfix(base)
    # Si sigue '[', es IndexAccess
    si token_tipo(peek()) == 59
        avanzar()
        idx = parsear_expresion()
        consumir(60, "Se esperaba ]")
        base = nodo_index_access(nodo_identifier(token_valor(t), token_linea(t)), idx, token_linea(t))
        retorna parsear_postfix(base)
    # Es solo un identifier
    retorna nodo_identifier(token_valor(t), token_linea(t))

# Maneja postfix .campo, [idx] encadenados
funcion parsear_postfix(base)
    mientras verdad
        si token_tipo(peek()) == 64  # '.'
            avanzar()
            miembro_tok = avanzar()
            base = nodo_member_access(base, miembro_tok.valor, token_linea(miembro_tok))
        sino
            si token_tipo(peek()) == 59  # '['
                avanzar()
                idx = parsear_expresion()
                consumir(60, "Se esperaba ]")
                base = nodo_index_access(base, idx, token_linea(idx))
            sino
                retorna base

# ============================================================
# Entry point del parser
# ============================================================

funcion parsear(lista_tokens)
    tokens_parser = lista_tokens
    pos_parser = 0
    programa = []
    saltar_separadores()
    mientras token_tipo(peek()) != 0
        s = parsear_statement()
        agregar(programa, s)
        saltar_separadores()
    retorna programa
