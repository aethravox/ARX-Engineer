# main.zen — Entry point del compilador Zen escrito EN Zen
#
# Este es el punto de entrada del "Zen sobre Zen" (bootstrap stage-2).
# Al compilarlo con el zen C++ produce un binario `./main` que es capaz
# de compilar archivos .zen — incluyendo este propio archivo.
#
# Uso:
#   ./main <archivo.zen> [opciones]
#
# Opciones:
#   --ir        Mostrar LLVM IR
#   --obj       Generar .o (codigo objeto)
#   --build     Compilar a ejecutable nativo
#   --run       Compilar y ejecutar

importar "ast"
importar "lexer"
importar "parser"
importar "codegen"
importar "builtins"

# ============================================================
# FFI a runtime de Zen (para contar listas correctamente)
# ============================================================

extern "libLLVM" __zen_list_len(ptr) -> long
extern "libLLVM" LLVMDumpModule(ptr) -> void

# ============================================================
# Banner y ayuda
# ============================================================

funcion mostrar_banner()
    printf("\n")
    printf("  Zen sobre Zen - Bootstrap Stage-2\n")
    printf("  Compilador Zen escrito en Zen\n")
    printf("\n")

funcion mostrar_ayuda()
    printf("Uso: main <archivo.zen> [opciones]\n\n")
    printf("Opciones:\n")
    printf("  --ir        Mostrar el LLVM IR generado\n")
    printf("  --obj       Generar archivo objeto (.o)\n")
    printf("  --build     Compilar a ejecutable nativo\n")
    printf("  --run       Compilar y ejecutar\n")
    printf("\n")

# ============================================================
# Base name (sin extension ni directorio)
# ============================================================

funcion base_name(ruta)
    len = longitud(ruta)
    i = len - 1
    inicio = 0
    mientras i >= 0
        c = char_at(ruta, i)
        si c == 47 o c == 92
            inicio = i + 1
            romper
        i = i - 1
    fin = len
    j = len - 1
    mientras j >= inicio
        c = char_at(ruta, j)
        si c == 46
            fin = j
            romper
        j = j - 1
    retorna subtexto(ruta, inicio, fin)

# ============================================================
# CLI principal
# ============================================================

funcion principal()
    mostrar_banner()
    argc = num_argumentos()
    si argc < 2
        mostrar_ayuda()
        retorna 1
    archivo = argumentos(1)
    mostrar_ir = falso
    ejecutar = falso
    compilar_exe = falso
    emitir_obj = falso
    i = 2
    mientras i < argc
        arg = argumentos(i)
        si arg == "--ir"
            mostrar_ir = verdad
        si arg == "--run"
            ejecutar = verdad
        si arg == "--build"
            compilar_exe = verdad
        si arg == "--obj"
            emitir_obj = verdad
        i = i + 1
    printf("[1/4] Leyendo: ")
    printf(archivo)
    printf("\n")
    codigo = leer_archivo(archivo)
    si codigo == ""
        printf("ERROR: no se pudo leer el archivo\n")
        retorna 1
    printf("[2/4] Tokenizando...\n")
    tokens = tokenizar(codigo)
    n_tokens = __zen_list_len(tokens)
    printf("      ")
    printf(n_tokens)
    printf(" tokens generados\n")
    printf("[3/4] Parseando...\n")
    ast = parsear(tokens)
    n_nodos = __zen_list_len(ast)
    printf("      ")
    printf(n_nodos)
    printf(" nodos en el AST\n")
    printf("[4/4] Generando LLVM IR...\n")
    estado = codegen_init()
    codegen_programa(estado, ast)
    base = base_name(archivo)
    # Estructura de carpetas: build/<plat>/{o,ll,bin}/
    # Plataforma por defecto: linux (cuando se implemente 'plataforma X' tomara de ahi)
    plat = "linux"
    dir_build = "build/" + plat
    dir_o = dir_build + "/o"
    dir_ll = dir_build + "/ll"
    dir_bin = dir_build + "/bin"
    # Crear carpetas si no existen
    system("mkdir -p " + dir_o + " " + dir_ll + " " + dir_bin)
    # --- Modo --ir: mostrar IR por stdout (no escribir .ll al disco) ---
    si mostrar_ir
        printf("--- LLVM IR ---\n")
        LLVMDumpModule(estado_modulo(estado))
        printf("--- Fin IR ---\n\n")
        retorna 0
    # --- Modo --obj: generar .o en build/<plat>/o/ ---
    si emitir_obj
        obj_file = dir_o + "/" + base + ".o"
        printf("Generando codigo objeto nativo...\n")
        codegen_compilar_nativo(estado, obj_file)
        printf("   OK: ")
        printf(obj_file)
        printf(" generado\n")
        retorna 0
    # --- Modo --build / --run: generar .o + ejecutable ---
    si compilar_exe o ejecutar
        obj_file = dir_o + "/" + base + ".o"
        printf("Compilando a codigo objeto nativo...\n")
        codegen_compilar_nativo(estado, obj_file)
        printf("   OK: ")
        printf(obj_file)
        printf(" generado\n")
        exe_file = dir_bin + "/" + base
        # Linkear con libzen.a + LLVM + libc/libm
        link_cmd = "cc " + obj_file + " -o " + exe_file
        link_cmd = link_cmd + " build/libzen.a"
        link_cmd = link_cmd + " -L/usr/lib/llvm-14/lib -lLLVM-14 -lstdc++ -lpthread -lm"
        printf("Linkeando: ")
        printf(link_cmd)
        printf("\n")
        system(link_cmd)
        printf("   Compilado exitosamente: ")
        printf(exe_file)
        printf("\n")
        si ejecutar
            printf("--- Ejecutando ---\n")
            run_cmd = exe_file
            system(run_cmd)
            printf("--- Fin ejecucion ---\n")
    retorna 0

# ============================================================
# Entry point
# ============================================================

principal()
