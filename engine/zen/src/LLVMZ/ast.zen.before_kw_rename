NODO_STRING        = 2
NODO_BOOL          = 3
NODO_NULL          = 4
NODO_IDENTIFIER    = 5
NODO_BINARY_OP     = 6
NODO_UNARY_OP      = 7
NODO_TERNARY       = 8
NODO_FUNC_CALL     = 9
NODO_ASSIGN        = 10
NODO_AUG_ASSIGN    = 11
NODO_PRINT         = 12
NODO_IF            = 13
NODO_FOR_RANGE     = 14
NODO_FOR_EACH      = 15
NODO_WHILE         = 16
NODO_REPEAT        = 17
NODO_BREAK         = 18
NODO_CONTINUE      = 19
NODO_FUNC_DECL     = 20
NODO_RETURN        = 21
NODO_EXPR_STMT     = 22
NODO_LIST_LIT      = 23
NODO_INDEX_ACCESS  = 24
NODO_INDEX_ASSIGN  = 25
NODO_STRUCT_DECL   = 26
NODO_STRUCT_LIT    = 27
NODO_MEMBER_ACCESS = 28
NODO_MEMBER_ASSIGN = 29
NODO_MATCH         = 30
# Nuevos tipos (Fase 1+):
NODO_FSTRING       = 31
NODO_PLATFORM      = 32
NODO_EXTERN_DECL   = 33
NODO_EXTERN_CALL   = 34

# ============================================================
# Tipos de valores Zen (1:1 con enum ZenType de C++)
# ============================================================

TIPO_NUMBER = 1
TIPO_STRING = 2
TIPO_BOOL   = 3
TIPO_VOID   = 4
TIPO_NULL   = 5
TIPO_LIST   = 6
TIPO_STRUCT = 7

# ============================================================
# Constructores especificos por tipo de nodo
# ============================================================

funcion nodo_number(valor, linea)
    retorna Nodo {tipo: NODO_NUMBER, valor: valor, linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_string(valor, linea)
    retorna Nodo {tipo: NODO_STRING, valor: valor, linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_bool(valor, linea)
    retorna Nodo {tipo: NODO_BOOL, valor: valor, linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_null(linea)
    retorna Nodo {tipo: NODO_NULL, valor: "nada", linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_identifier(nombre, linea)
    retorna Nodo {tipo: NODO_IDENTIFIER, valor: nombre, linea: linea, hijos: [0], nombre: nombre, op: ""}

funcion nodo_binary_op(op, left, right, linea)
    retorna Nodo {tipo: NODO_BINARY_OP, valor: "", linea: linea, hijos: [left, right], nombre: "", op: op}

funcion nodo_unary_op(op, operand, linea)
    retorna Nodo {tipo: NODO_UNARY_OP, valor: "", linea: linea, hijos: [operand], nombre: "", op: op}

funcion nodo_ternary(cond, then_expr, else_expr, linea)
    retorna Nodo {tipo: NODO_TERNARY, valor: "", linea: linea, hijos: [cond, then_expr, else_expr], nombre: "", op: ""}

funcion nodo_func_call(nombre, args, linea)
    retorna Nodo {tipo: NODO_FUNC_CALL, valor: "", linea: linea, hijos: args, nombre: nombre, op: ""}

funcion nodo_assign(var_name, value, linea)
    retorna Nodo {tipo: NODO_ASSIGN, valor: "", linea: linea, hijos: [value], nombre: var_name, op: ""}

funcion nodo_aug_assign(var_name, op, value, linea)
    retorna Nodo {tipo: NODO_AUG_ASSIGN, valor: op, linea: linea, hijos: [value], nombre: var_name, op: op}

funcion nodo_print(expr, linea)
    retorna Nodo {tipo: NODO_PRINT, valor: "", linea: linea, hijos: [expr], nombre: "", op: ""}

# IF: hijos[0] = cond, hijos[1..k+1] = then-body (k statements),
#     hijos[k+1..] = else-body.
# valor = texto(k) para que el codegen sepa dónde termina el then-body.
funcion nodo_if(cond, then_body, else_body, linea)
    hijos = [cond]
    para cada s en then_body
        agregar(hijos, s)
    k = longitud(then_body)
    para cada s en else_body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_IF, valor: texto(k), linea: linea, hijos: hijos, nombre: "", op: ""}

funcion nodo_for_range(var_name, desde, hasta, body, linea)
    hijos = [desde, hasta]
    para cada s en body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_FOR_RANGE, valor: "", linea: linea, hijos: hijos, nombre: var_name, op: ""}

funcion nodo_for_each(var_name, iterable, body, linea)
    hijos = [iterable]
    para cada s en body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_FOR_EACH, valor: "", linea: linea, hijos: hijos, nombre: var_name, op: ""}

funcion nodo_while(cond, body, linea)
    hijos = [cond]
    para cada s en body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_WHILE, valor: "", linea: linea, hijos: hijos, nombre: "", op: ""}

funcion nodo_repeat(count, body, linea)
    hijos = [count]
    para cada s en body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_REPEAT, valor: "", linea: linea, hijos: hijos, nombre: "", op: ""}

funcion nodo_break(linea)
    retorna Nodo {tipo: NODO_BREAK, valor: "", linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_continue(linea)
    retorna Nodo {tipo: NODO_CONTINUE, valor: "", linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_platform(platform, body, linea)
    hijos = []
    para cada s en body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_PLATFORM, valor: "", linea: linea, hijos: hijos, nombre: platform, op: ""}

# FUNC_DECL: hijos[0..p-1] = params (NODO_IDENTIFIER), hijos[p..] = body
funcion nodo_func_decl(nombre, params, body, linea)
    hijos = []
    para cada p en params
        agregar(hijos, nodo_identifier(p, linea))
    para cada s en body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_FUNC_DECL, valor: "", linea: linea, hijos: hijos, nombre: nombre, op: ""}

funcion nodo_return(expr, linea)
    retorna Nodo {tipo: NODO_RETURN, valor: "", linea: linea, hijos: [expr], nombre: "", op: ""}

funcion nodo_expr_stmt(expr, linea)
    retorna Nodo {tipo: NODO_EXPR_STMT, valor: "", linea: linea, hijos: [expr], nombre: "", op: ""}

funcion nodo_list_lit(elementos, linea)
    retorna Nodo {tipo: NODO_LIST_LIT, valor: "", linea: linea, hijos: elementos, nombre: "", op: ""}

funcion nodo_index_access(base, index, linea)
    retorna Nodo {tipo: NODO_INDEX_ACCESS, valor: "", linea: linea, hijos: [base, index], nombre: "", op: ""}

funcion nodo_index_assign(base, index, value, linea)
    retorna Nodo {tipo: NODO_INDEX_ASSIGN, valor: "", linea: linea, hijos: [base, index, value], nombre: "", op: ""}

# STRUCT_DECL: hijos = [nodo_identifier(campo), ...] para cada campo
funcion nodo_struct_decl(nombre, campos, linea)
    hijos = []
    para cada c en campos
        agregar(hijos, nodo_identifier(c, linea))
    retorna Nodo {tipo: NODO_STRUCT_DECL, valor: "", linea: linea, hijos: hijos, nombre: nombre, op: ""}

# STRUCT_LIT: valor = texto(num_campos), hijos[0..k-1] = identifiers de campos,
#   hijos[k..] = valores. El codegen usa valor para saber el split.
funcion nodo_struct_lit(nombre, campos, valores, linea)
    hijos = []
    k = longitud(campos)
    para cada c en campos
        agregar(hijos, nodo_identifier(c, linea))
    para cada v en valores
        agregar(hijos, v)
    retorna Nodo {tipo: NODO_STRUCT_LIT, valor: texto(k), linea: linea, hijos: hijos, nombre: nombre, op: ""}

funcion nodo_member_access(base, member, linea)
    retorna Nodo {tipo: NODO_MEMBER_ACCESS, valor: "", linea: linea, hijos: [base], nombre: member, op: ""}

funcion nodo_member_assign(base, member, value, linea)
    retorna Nodo {tipo: NODO_MEMBER_ASSIGN, valor: "", linea: linea, hijos: [base, value], nombre: member, op: ""}

funcion nodo_match(subject, cases, linea)
    # Stub: solo subject por ahora. Match completo es complejo.
    retorna Nodo {tipo: NODO_MATCH, valor: "", linea: linea, hijos: [subject], nombre: "", op: ""}

# EXTERN_DECL: op = libreria ("libc", "libm", etc.), nombre = nombre de funcion
#   valor = "ret_tipo|tipo1,tipo2,..." para que el codegen sepa los tipos C
funcion nodo_extern_decl(lib, nombre, ret_tipo, param_tipos, linea)
    tipos_str = ret_tipo + "|"
    n = longitud(param_tipos)
    i = 0
    mientras i < n
        tipos_str = tipos_str + param_tipos[i]
        si i + 1 < n
            tipos_str = tipos_str + ","
        i = i + 1
    retorna Nodo {tipo: NODO_EXTERN_DECL, valor: tipos_str, linea: linea, hijos: [0], nombre: nombre, op: lib}

# EXTERN_CALL: igual que FUNC_CALL pero marcado como extern
funcion nodo_extern_call(nombre, args, linea)
    retorna Nodo {tipo: NODO_EXTERN_CALL, valor: "", linea: linea, hijos: args, nombre: nombre, op: ""}

# ============================================================
# Constructores genericos
# ============================================================

funcion crear_nodo(tipo, valor, linea)
    retorna Nodo {tipo: tipo, valor: valor, linea: linea, hijos: [], nombre: "", op: ""}

funcion crear_nodo_op(tipo, op, linea)
    retorna Nodo {tipo: tipo, valor: "", linea: linea, hijos: [], nombre: "", op: op}

