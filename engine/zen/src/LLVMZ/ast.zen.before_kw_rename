# ast.zen — Definiciones del AST de Zen escrito EN Zen
#
# 1:1 con ast.h del C++. Mismos tipos de nodos, mismos constructores.
#
# Codificacion de Nodo:
#   tipo   : int  (NODO_*)
#   valor  : string/numero (depende del tipo; para IF guarda el count del then-body)
#   linea  : int
#   hijos  : lista de Nodo
#   nombre : string (identificador, nombre de funcion, etc.)
#   op     : string (operador: "+", "==", "and", etc.)

# ============================================================
# Structs
# ============================================================

Nodo {tipo, valor, linea, hijos, nombre, op}
Token {tipo, valor, linea, col}
CodeGenState {modulo, builder}

# ============================================================
# Constantes — Tipos de Nodos del AST (1:1 con C++ NodeType)
# Mantengo la numeracion original para no romper el parser existente.
# Nuevos tipos se agregan al final.
# ============================================================

