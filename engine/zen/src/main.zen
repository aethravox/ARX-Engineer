# main.zen — Entry point del compilador Zen escrito EN Zen
#
# Este es el punto de entrada del "Zen sobre Zen" (bootstrap stage-2).
# Al compilarlo con el zen C++ produce un binario `./main` que es capaz
# de compilar archivos .zen — incluyendo este propio archivo.
#
# Uso:
#   ./main <archivo.zen> [opciones]
#
# Opciones:
#   --ir        Mostrar LLVM IR
#   --obj       Generar .o (codigo objeto)
#   --build     Compilar a ejecutable nativo
#   --run       Compilar y ejecutar

importar "ast"
importar "lexer"
importar "parser"
importar "codegen"
importar "builtins"

# ============================================================
# Banner y ayuda
# ============================================================

funcion mostrar_banner()
    printf("\n")
    printf("  Zen sobre Zen - Bootstrap Stage-2\n")
    printf("  Compilador Zen escrito en Zen\n")
    printf("\n")

funcion mostrar_ayuda()
    printf("Uso: main <archivo.zen> [opciones]\n\n")
    printf("Opciones:\n")
    printf("  --ir        Mostrar el LLVM IR generado\n")
    printf("  --obj       Generar archivo objeto (.o)\n")
    printf("  --build     Compilar a ejecutable nativo\n")
    printf("  --run       Compilar y ejecutar\n")
    printf("\n")

# ============================================================
# Base name (sin extension ni directorio)
# ============================================================

funcion base_name(ruta)
    len = longitud(ruta)
    i = len - 1
    inicio = 0
    mientras i >= 0
        c = char_at(ruta, i)
        si c == 47 o c == 92
            inicio = i + 1
            romper
        i = i - 1
    fin = len
    j = len - 1
    mientras j >= inicio
        c = char_at(ruta, j)
        si c == 46
            fin = j
            romper
        j = j - 1
    retorna subtexto(ruta, inicio, fin)

# ============================================================
# CLI principal
# ============================================================

funcion principal()
    mostrar_banner()
    argc = num_argumentos()
    si argc < 2
        mostrar_ayuda()
        retorna 1
    archivo = argumentos(1)
    mostrar_ir = falso
    ejecutar = falso
    compilar_exe = falso
    emitir_obj = falso
    i = 2
    mientras i < argc
        arg = argumentos(i)
        si arg == "--ir"
            mostrar_ir = verdad
        si arg == "--run"
            ejecutar = verdad
        si arg == "--build"
            compilar_exe = verdad
        si arg == "--obj"
            emitir_obj = verdad
        i = i + 1
    printf("[1/4] Leyendo: ")
    printf(archivo)
    printf("\n")
    codigo = leer_archivo(archivo)
    si codigo == ""
        printf("ERROR: no se pudo leer el archivo\n")
        retorna 1
    printf("[2/4] Tokenizando...\n")
    tokens = tokenizar(codigo)
    n_tokens = longitud(tokens)
    printf("      ")
    printf(n_tokens)
    printf(" tokens generados\n")
    printf("[3/4] Parseando...\n")
    ast = parsear(tokens)
    n_nodos = longitud(ast)
    printf("      ")
    printf(n_nodos)
    printf(" nodos en el AST\n")
    printf("[4/4] Generando LLVM IR...\n")
    estado = codegen_init()
    codegen_programa(estado, ast)
    base = base_name(archivo)
    ll_file = base + ".ll"
    si mostrar_ir
        codegen_compilar(estado, ll_file)
        printf("--- LLVM IR generado en ")
        printf(ll_file)
        printf(" ---\n")
        codegen_finalize(estado)
        retorna 0
    codegen_compilar(estado, ll_file)
    printf("   OK: ")
    printf(ll_file)
    printf(" generado\n")
    si emitir_obj
        obj_file = base + ".o"
        printf("Generando codigo objeto nativo...\n")
        codegen_compilar_nativo(estado, obj_file)
        printf("   OK: ")
        printf(obj_file)
        printf(" generado\n")
        codegen_finalize(estado)
        retorna 0
    si compilar_exe o ejecutar
        obj_file = base + ".o"
        printf("Compilando a codigo objeto nativo...\n")
        codegen_compilar_nativo(estado, obj_file)
        printf("   OK: ")
        printf(obj_file)
        printf(" generado\n")
        link_cmd = "cc " + obj_file + " -o " + base + " -lm"
        printf("Linkeando: ")
        printf(link_cmd)
        printf("\n")
        system(link_cmd)
        printf("   Compilado exitosamente: ")
        printf(base)
        printf("\n")
        si ejecutar
            printf("--- Ejecutando ---\n")
            run_cmd = "./" + base
            system(run_cmd)
            printf("--- Fin ejecucion ---\n")
    codegen_finalize(estado)
    retorna 0

# ============================================================
# Entry point
# ============================================================

principal()
