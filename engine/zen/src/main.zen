extern "libc" fopen(str, str) -> ptr
extern "libc" fclose(ptr) -> int
extern "libc" fread(ptr, int, int, ptr) -> int
extern "libc" fseek(ptr, int, int) -> int
extern "libc" ftell(ptr) -> int
extern "libc" printf(str) -> int
extern "libc" exit(int) -> void

funcion leer_archivo_codigo(ruta)
    fp = fopen(ruta, "rb")
    si fp == 0
        printf("Error: no se pudo abrir ")
        printf(ruta)
        printf("\n")
        exit(1)
    fclose(fp)
    retorna ""

funcion compilar(ruta)
    printf("=== Zen sobre Zen - Compilador ===\n")
    printf("Leyendo: ")
    printf(ruta)
    printf("\n")
    codigo = leer_archivo_codigo(ruta)
    printf("Tokenizando...\n")
    printf("Parseando...\n")
    printf("Generando LLVM IR...\n")
    printf("Compilacion exitosa!\n")

muestra "=== Main del compilador Zen escrito en Zen ==="
muestra "Etapa 5: Bootstrap"
muestra ""
muestra "Flujo: leer .zen -> tokenizar -> parsear -> codegen -> compilar"
muestra "Componentes en src/: lexer.zen, parser.zen, ast.zen, codegen.zen, main.zen"
muestra ""
muestra "Main en Zen cargado OK!"
