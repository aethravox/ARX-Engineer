# === Structs ===
Nodo {tipo, valor, linea, hijos, nombre, op}
Token {tipo, valor, linea, col}
CodeGenState {modulo, builder}

# === Constantes AST ===
NODO_NUMBER = 1
NODO_STRING = 2
NODO_BOOL = 3
NODO_NULL = 4
NODO_IDENTIFIER = 5
NODO_BINARY_OP = 6
NODO_UNARY_OP = 7
NODO_TERNARY = 8
NODO_FUNC_CALL = 9
NODO_ASSIGN = 10
NODO_AUG_ASSIGN = 11
NODO_PRINT = 12
NODO_IF = 13
NODO_FOR_RANGE = 14
NODO_FOR_EACH = 15
NODO_WHILE = 16
NODO_REPEAT = 17
NODO_BREAK = 18
NODO_CONTINUE = 19
NODO_FUNC_DECL = 20
NODO_RETURN = 21
NODO_EXPR_STMT = 22
NODO_LIST_LIT = 23
NODO_INDEX_ACCESS = 24
NODO_INDEX_ASSIGN = 25
NODO_STRUCT_DECL = 26
NODO_STRUCT_LIT = 27
NODO_MEMBER_ACCESS = 28
NODO_MEMBER_ASSIGN = 29
NODO_MATCH = 30
TIPO_NUMBER = 1
TIPO_STRING = 2
TIPO_BOOL = 3
TIPO_VOID = 4
TIPO_NULL = 5
TIPO_LIST = 6
TIPO_STRUCT = 7

# === Helpers ===
funcion nodo_number(valor, linea)
    retorna Nodo {tipo: NODO_NUMBER, valor: valor, linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_string(valor, linea)
    retorna Nodo {tipo: NODO_STRING, valor: valor, linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_bool(valor, linea)
    retorna Nodo {tipo: NODO_BOOL, valor: valor, linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_null(linea)
    retorna Nodo {tipo: NODO_NULL, valor: "nada", linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_identifier(nombre, linea)
    retorna Nodo {tipo: NODO_IDENTIFIER, valor: nombre, linea: linea, hijos: [0], nombre: nombre, op: ""}

funcion nodo_binary_op(op, left, right, linea)
    n = Nodo {tipo: NODO_BINARY_OP, valor: "", linea: linea, hijos: [left, right], nombre: "", op: op}
    retorna n

funcion nodo_unary_op(op, operand, linea)
    n = Nodo {tipo: NODO_UNARY_OP, valor: "", linea: linea, hijos: [operand], nombre: "", op: op}
    retorna n

funcion nodo_ternary(cond, then_expr, else_expr, linea)
    n = Nodo {tipo: NODO_TERNARY, valor: "", linea: linea, hijos: [cond, then_expr, else_expr], nombre: "", op: ""}
    retorna n

funcion nodo_func_call(nombre, args, linea)
    n = Nodo {tipo: NODO_FUNC_CALL, valor: "", linea: linea, hijos: args, nombre: nombre, op: ""}
    retorna n

funcion nodo_assign(var_name, value, linea)
    n = Nodo {tipo: NODO_ASSIGN, valor: "", linea: linea, hijos: [value], nombre: var_name, op: ""}
    retorna n

funcion nodo_print(expr, linea)
    n = Nodo {tipo: NODO_PRINT, valor: "", linea: linea, hijos: [expr], nombre: "", op: ""}
    retorna n

funcion nodo_if(cond, then_body, else_body, linea)
    hijos = [cond]
    para cada s en then_body
        agregar(hijos, s)
    para cada s en else_body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_IF, valor: "", linea: linea, hijos: hijos, nombre: "", op: ""}

funcion nodo_while(cond, body, linea)
    hijos = [cond]
    para cada s en body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_WHILE, valor: "", linea: linea, hijos: hijos, nombre: "", op: ""}

funcion nodo_func_decl(nombre, params, body, linea)
    hijos = []
    para cada p en params
        agregar(hijos, nodo_identifier(p, linea))
    para cada s en body
        agregar(hijos, s)
    retorna Nodo {tipo: NODO_FUNC_DECL, valor: "", linea: linea, hijos: hijos, nombre: nombre, op: ""}

funcion nodo_return(expr, linea)
    retorna Nodo {tipo: NODO_RETURN, valor: "", linea: linea, hijos: [expr], nombre: "", op: ""}

funcion nodo_break(linea)
    retorna Nodo {tipo: NODO_BREAK, valor: "", linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_continue(linea)
    retorna Nodo {tipo: NODO_CONTINUE, valor: "", linea: linea, hijos: [0], nombre: "", op: ""}

funcion nodo_list_lit(elementos, linea)
    retorna Nodo {tipo: NODO_LIST_LIT, valor: "", linea: linea, hijos: elementos, nombre: "", op: ""}

funcion nodo_struct_decl(nombre, campos, linea)
    retorna Nodo {tipo: NODO_STRUCT_DECL, valor: "", linea: linea, hijos: campos, nombre: nombre, op: ""}

funcion nodo_struct_lit(nombre, campos, valores, linea)
    hijos = campos
    para cada v en valores
        agregar(hijos, v)
    retorna Nodo {tipo: NODO_STRUCT_LIT, valor: "", linea: linea, hijos: hijos, nombre: nombre, op: ""}

funcion nodo_match(subject, cases, linea)
    retorna Nodo {tipo: NODO_MATCH, valor: "", linea: linea, hijos: [subject], nombre: "", op: ""}

funcion nodo_tipo(n)
    retorna n.tipo

funcion nodo_valor(n)
    retorna n.valor

funcion nodo_nombre(n)
    retorna n.nombre

funcion nodo_op(n)
    retorna n.op

funcion nodo_linea(n)
    retorna n.linea

funcion nodo_hijos(n)
    retorna n.hijos

funcion tipo_nodo_string(tipo)
    si tipo == NODO_NUMBER
        retorna "NumberLit"
    si tipo == NODO_STRING
        retorna "StringLit"
    si tipo == NODO_BOOL
        retorna "BoolLit"
    si tipo == NODO_NULL
        retorna "NullLit"
    si tipo == NODO_IDENTIFIER
        retorna "Identifier"
    si tipo == NODO_BINARY_OP
        retorna "BinaryOp"
    si tipo == NODO_UNARY_OP
        retorna "UnaryOp"
    si tipo == NODO_TERNARY
        retorna "Ternary"
    si tipo == NODO_FUNC_CALL
        retorna "FuncCall"
    si tipo == NODO_ASSIGN
        retorna "Assign"
    si tipo == NODO_PRINT
        retorna "Print"
    si tipo == NODO_IF
        retorna "If"
    si tipo == NODO_WHILE
        retorna "While"
    si tipo == NODO_FUNC_DECL
        retorna "FuncDecl"
    si tipo == NODO_RETURN
        retorna "Return"
    si tipo == NODO_BREAK
        retorna "Break"
    si tipo == NODO_CONTINUE
        retorna "Continue"
    si tipo == NODO_LIST_LIT
        retorna "ListLit"
    si tipo == NODO_STRUCT_DECL
        retorna "StructDecl"
    si tipo == NODO_STRUCT_LIT
        retorna "StructLit"
    si tipo == NODO_MATCH
        retorna "Match"
    retorna "Tipo_" + tipo

funcion estado_modulo(e)
    retorna e.modulo

funcion estado_builder(e)
    retorna e.builder

funcion i8ptr_type()
    retorna LLVMPointerType(LLVMInt8Type(), 0)

# === From lexer.zen ===



funcion es_digito(c)
    retorna c >= 48 y c <= 57
funcion es_letra(c)
    retorna (c >= 97 y c <= 122) o (c >= 65 y c <= 90) o c == 95
funcion es_alfa_num(c)
    retorna es_letra(c) o es_digito(c)
funcion tipo_keyword(palabra)
    si palabra == "si" o palabra == "if"
        retorna 4
    si palabra == "sino" o palabra == "else"
        retorna 5
    si palabra == "mientras" o palabra == "while"
        retorna 10
    si palabra == "para" o palabra == "for"
        retorna 7
    si palabra == "funcion" o palabra == "function"
        retorna 17
    si palabra == "retorna" o palabra == "return"
        retorna 18
    si palabra == "muestra" o palabra == "show" o palabra == "print"
        retorna 19
    si palabra == "verdad" o palabra == "yes"
        retorna 34
    si palabra == "falso"
        retorna 35
    si palabra == "nada" o palabra == "nothing"
        retorna 36
    retorna 3
funcion tokenizar(codigo)
    tokens = []
    len = longitud(codigo)
    pos = 0
    linea = 1
    mientras pos < len
        c = char_at(codigo, pos)
        si c == 32 o c == 9
            pos = pos + 1
            continuar
        si c == 10
            agregar(tokens, Token {tipo: 67, valor: "NEWLINE", linea: linea, col: pos})
            pos = pos + 1
            linea = linea + 1
            continuar
        si c == 35
            mientras pos < len y char_at(codigo, pos) != 10
                pos = pos + 1
            continuar
        si c == 34 o c == 39
            comilla = c
            pos = pos + 1
            valor = ""
            mientras pos < len
                ch = char_at(codigo, pos)
                si ch == comilla
                    pos = pos + 1
                    romper
                valor = valor + char_to_str(ch)
                pos = pos + 1
            agregar(tokens, Token {tipo: 2, valor: valor, linea: linea, col: pos})
            continuar
        si es_digito(c)
            valor = ""
            mientras pos < len
                ch = char_at(codigo, pos)
                si es_digito(ch) o ch == 46
                    valor = valor + char_to_str(ch)
                    pos = pos + 1
                sino
                    romper
            agregar(tokens, Token {tipo: 1, valor: valor, linea: linea, col: pos})
            continuar
        si es_letra(c)
            valor = ""
            mientras pos < len
                ch = char_at(codigo, pos)
                si es_alfa_num(ch)
                    valor = valor + char_to_str(ch)
                    pos = pos + 1
                sino
                    romper
            tipo = tipo_keyword(valor)
            agregar(tokens, Token {tipo: tipo, valor: valor, linea: linea, col: pos})
            continuar
        si pos + 1 < len
            c2 = char_at(codigo, pos + 1)
            si c == 61 y c2 == 61
                agregar(tokens, Token {tipo: 43, valor: "==", linea: linea, col: pos})
                pos = pos + 2
                continuar
            si c == 33 y c2 == 61
                agregar(tokens, Token {tipo: 44, valor: "!=", linea: linea, col: pos})
                pos = pos + 2
                continuar
            si c == 60 y c2 == 61
                agregar(tokens, Token {tipo: 47, valor: "<=", linea: linea, col: pos})
                pos = pos + 2
                continuar
            si c == 62 y c2 == 61
                agregar(tokens, Token {tipo: 48, valor: ">=", linea: linea, col: pos})
                pos = pos + 2
                continuar
            si c == 45 y c2 == 62
                agregar(tokens, Token {tipo: 56, valor: "->", linea: linea, col: pos})
                pos = pos + 2
                continuar
        si c == 43
            agregar(tokens, Token {tipo: 37, valor: "+", linea: linea, col: pos})
        sino
            si c == 45
                agregar(tokens, Token {tipo: 38, valor: "-", linea: linea, col: pos})
            sino
                si c == 42
                    agregar(tokens, Token {tipo: 39, valor: "*", linea: linea, col: pos})
                sino
                    si c == 47
                        agregar(tokens, Token {tipo: 40, valor: "/", linea: linea, col: pos})
                    sino
                        si c == 61
                            agregar(tokens, Token {tipo: 49, valor: "=", linea: linea, col: pos})
                        sino
                            si c == 60
                                agregar(tokens, Token {tipo: 45, valor: "<", linea: linea, col: pos})
                            sino
                                si c == 62
                                    agregar(tokens, Token {tipo: 46, valor: ">", linea: linea, col: pos})
                                sino
                                    si c == 40
                                        agregar(tokens, Token {tipo: 57, valor: "(", linea: linea, col: pos})
                                    sino
                                        si c == 41
                                            agregar(tokens, Token {tipo: 58, valor: ")", linea: linea, col: pos})
                                        sino
                                            si c == 44
                                                agregar(tokens, Token {tipo: 63, valor: ",", linea: linea, col: pos})
                                            sino
                                                si c == 46
                                                    agregar(tokens, Token {tipo: 64, valor: ".", linea: linea, col: pos})
                                                sino
                                                    si c == 58
                                                        agregar(tokens, Token {tipo: 65, valor: ":", linea: linea, col: pos})
                                                    sino
                                                        si c == 91
                                                            agregar(tokens, Token {tipo: 59, valor: "[", linea: linea, col: pos})
                                                        sino
                                                            si c == 93
                                                                agregar(tokens, Token {tipo: 60, valor: "]", linea: linea, col: pos})
                                                            sino
                                                                si c == 123
                                                                    agregar(tokens, Token {tipo: 61, valor: "{", linea: linea, col: pos})
                                                                sino
                                                                    si c == 125
                                                                        agregar(tokens, Token {tipo: 62, valor: "}", linea: linea, col: pos})
        pos = pos + 1
    agregar(tokens, Token {tipo: 0, valor: "EOF", linea: linea, col: pos})
    retorna tokens

# === From parser.zen ===
# parser.zen — Parser de Zen escrito EN Zen
#
# Etapa 3 de Zen sobre Zen: el parser toma los tokens del lexer
# y construye un AST (Arbol de Sintaxis Abstracta).
#
# Parser recursivo descendente con bloques por indentacion.
#
# Tipos de nodo del AST (numeros):
#   1  = NumberLit
#   2  = StringLit
#   3  = BoolLit
#   4  = NullLit
#   5  = Identifier
#   6  = BinaryOp
#   7  = UnaryOp
#   8  = TernaryOp
#   9  = FuncCall
#   10 = AssignStmt
#   11 = AugAssignStmt
#   12 = PrintStmt
#   13 = IfStmt
#   14 = ForRangeStmt
#   15 = ForEachStmt
#   16 = WhileStmt
#   17 = RepeatStmt
#   18 = BreakStmt
#   19 = ContinueStmt
#   20 = FuncDecl
#   21 = ReturnStmt
#   22 = ExprStmt
#   23 = ListLit
#   24 = IndexAccess
#   25 = IndexAssign
#   26 = StructDecl
#   27 = StructLit
#   28 = MemberAccess
#   29 = MemberAssign
#   30 = MatchStmt

# Struct: Nodo AST


# === Helpers para acceder a miembros de tokens ===
funcion token_tipo(t)
    retorna token_tipo(t)

funcion token_valor(t)
    retorna token_valor(t)

funcion token_linea(t)
    retorna token_linea(t)

# === Helpers para acceder a miembros de nodos ===





# Variables del parser (estado global)
tokens_parser = [0]
pos_parser = 0

# === Helpers del parser ===
funcion peek()
    retorna tokens_parser[pos_parser]

funcion avanzar()
    t = tokens_parser[pos_parser]
    pos_parser = pos_parser + 1
    retorna t

funcion verificar(tipo)
    retorna token_tipo(peek()) == tipo

funcion match_token(tipo)
    si token_tipo(peek()) == tipo
        avanzar()
        retorna verdad
    retorna falso

funcion consumir(tipo, msg)
    si token_tipo(peek()) == tipo
        retorna avanzar()
    muestra "ERROR: " + msg + " en linea " + token_linea(peek())
    retorna peek()

# === Crear nodo AST ===
funcion crear_nodo(tipo, valor, linea)
    n = Nodo {tipo: tipo, valor: valor, linea: linea, hijos: [], nombre: "", op: ""}
    retorna n

funcion crear_nodo_op(tipo, op, linea)
    n = Nodo {tipo: tipo, valor: "", linea: linea, hijos: [], nombre: "", op: op}
    retorna n

# === Es fin de bloque? ===
funcion es_fin_bloque(tipo)
    si tipo == 69
        retorna verdad
    si tipo == 0
        retorna verdad
    si tipo == 5
        retorna verdad
    si tipo == 6
        retorna verdad
    si tipo == 25
        retorna verdad
    si tipo == 26
        retorna verdad
    retorna falso

# === Parsear bloque (lista de statements) ===
funcion parsear_bloque()
    stmts = [0]
    mientras no es_fin_bloque(token_tipo(peek()))
        s = parsear_statement()
        si s != nada
            agregar(stmts, s)
        mientras token_tipo(peek()) == 67
            avanzar()
    si token_tipo(peek()) == 69
        avanzar()
    retorna stmts

# === Parsear statement ===
funcion parsear_statement()
    t = peek()
    si token_tipo(t) == 19
        return parsear_print()
    si token_tipo(t) == 4
        return parsear_si()
    si token_tipo(t) == 7
        return parsear_para()
    si token_tipo(t) == 10
        return parsear_mientras()
    si token_tipo(t) == 13
        return parsear_repetir()
    si token_tipo(t) == 17
        return parsear_funcion()
    si token_tipo(t) == 18
        avanzar()
        expr = parsear_expresion()
        return crear_nodo(21, "", token_linea(t))
    si token_tipo(t) == 15
        avanzar()
        return crear_nodo(18, "", token_linea(t))
    si token_tipo(t) == 16
        avanzar()
        return crear_nodo(19, "", token_linea(t))
    return parsear_expr_stmt()

# === Parsear muestra ===
funcion parsear_print()
    t = avanzar()
    expr = parsear_expresion()
    n = crear_nodo(12, "", token_linea(t))
    agregar(n.hijos, expr)
    retorna n

# === Parsear si/if ===
funcion parsear_si()
    t = avanzar()
    cond = parsear_expresion()
    si token_tipo(peek()) == 67
        avanzar()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    sino_cuerpo = [0]
    si token_tipo(peek()) == 5 o token_tipo(peek()) == 6
        avanzar()
        si token_tipo(peek()) == 4 o token_tipo(peek()) == 6
            elif_stmt = parsear_si()
            agregar(sino_cuerpo, elif_stmt)
        sino
            si token_tipo(peek()) == 67
                avanzar()
            si token_tipo(peek()) == 68
                avanzar()
            sino_cuerpo = parsear_bloque()
    n = crear_nodo(13, "", token_linea(t))
    agregar(n.hijos, cond)
    para cada s en cuerpo
        agregar(n.hijos, s)
    n.nombre = "sino"
    para cada s in sino_cuerpo
        agregar(n.hijos, s)
    retorna n

# === Parsear mientras/while ===
funcion parsear_mientras()
    t = avanzar()
    cond = parsear_expresion()
    si token_tipo(peek()) == 67
        avanzar()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    n = crear_nodo(16, "", token_linea(t))
    agregar(n.hijos, cond)
    para cada s en cuerpo
        agregar(n.hijos, s)
    retorna n

# === Parsear repetir ===
funcion parsear_repetir()
    t = avanzar()
    cuenta = parsear_expresion()
    si token_tipo(peek()) == 14
        avanzar()
    si token_tipo(peek()) == 67
        avanzar()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    n = crear_nodo(17, "", token_linea(t))
    agregar(n.hijos, cuenta)
    para cada s en cuerpo
        agregar(n.hijos, s)
    retorna n

# === Parsear funcion ===
funcion parsear_funcion()
    t = avanzar()
    nombre_tok = avanzar()
    consumir(57, "Se esperaba ( despues de funcion")
    params = [0]
    si token_tipo(peek()) != 58
        agregar(params, token_valor(avanzar()))
        mientras token_tipo(peek()) == 63
            avanzar()
            agregar(params, token_valor(avanzar()))
    consumir(58, "Se esperaba ) ")
    si token_tipo(peek()) == 67
        avanzar()
    si token_tipo(peek()) == 68
        avanzar()
    cuerpo = parsear_bloque()
    n = crear_nodo(20, "", token_linea(t))
    n.nombre = nombre_tok.valor
    para cada p en params
        agregar(n.hijos, crear_nodo(5, p, token_linea(t)))
    para cada s en cuerpo
        agregar(n.hijos, s)
    retorna n

# === Parsear para/for (simplificado) ===
funcion parsear_para()
    t = avanzar()
    var_tok = avanzar()
    si token_tipo(peek()) == 8
        avanzar()
        desde_expr = parsear_expresion()
        si token_tipo(peek()) == 9
            avanzar()
            hasta_expr = parsear_expresion()
        si token_tipo(peek()) == 67
            avanzar()
        si token_tipo(peek()) == 68
            avanzar()
        cuerpo = parsear_bloque()
        n = crear_nodo(14, "", token_linea(t))
        n.nombre = var_tok.valor
        agregar(n.hijos, desde_expr)
        agregar(n.hijos, hasta_expr)
        para cada s en cuerpo
            agregar(n.hijos, s)
        retorna n
    retorna crear_nodo(22, "", token_linea(t))

# === Parsear expresion como statement ===
funcion parsear_expr_stmt()
    expr = parsear_expresion()
    si nodo_tipo(expr) == 5 y (token_tipo(peek()) == 49 o token_tipo(peek()) == 50)
        op = "="
        si token_tipo(peek()) == 50
            op = "+"
        avanzar()
        valor = parsear_expresion()
        n = crear_nodo(10, "", nodo_linea(expr))
        n.nombre = nodo_valor(expr)
        agregar(n.hijos, valor)
        retorna n
    n = crear_nodo(22, "", nodo_linea(expr))
    agregar(n.hijos, expr)
    retorna n

# === Parsear expresion (ternario) ===
funcion parsear_expresion()
    expr = parsear_or()
    si token_tipo(peek()) == 66
        avanzar()
        then_expr = parsear_expresion()
        consumir(65, "Se esperaba :")
        else_expr = parsear_expresion()
        n = crear_nodo(8, "", nodo_linea(expr))
        agregar(n.hijos, expr)
        agregar(n.hijos, then_expr)
        agregar(n.hijos, else_expr)
        retorna n
    retorna expr

# === Parsear or/o ===
funcion parsear_or()
    left = parsear_and()
    mientras token_tipo(peek()) == 21
        t = avanzar()
        right = parsear_and()
        n = crear_nodo_op(6, "or", token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
    retorna left

# === Parsear and/y ===
funcion parsear_and()
    left = parsear_comparacion()
    mientras token_tipo(peek()) == 20
        t = avanzar()
        right = parsear_comparacion()
        n = crear_nodo_op(6, "and", token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
    retorna left

# === Parsear comparacion ===
funcion parsear_comparacion()
    left = parsear_suma_resta()
    mientras token_tipo(peek()) >= 43 y token_tipo(peek()) <= 48
        t = avanzar()
        right = parsear_suma_resta()
        n = crear_nodo_op(6, token_valor(t), token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
    retorna left

# === Parsear suma/resta ===
funcion parsear_suma_resta()
    left = parsear_mul_div()
    mientras token_tipo(peek()) == 37 o token_tipo(peek()) == 38
        t = avanzar()
        right = parsear_mul_div()
        n = crear_nodo_op(6, token_valor(t), token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
    retorna left

# === Parsear multiplicacion/division ===
funcion parsear_mul_div()
    left = parsear_potencia()
    mientras token_tipo(peek()) == 39 o token_tipo(peek()) == 40 o token_tipo(peek()) == 41
        t = avanzar()
        right = parsear_potencia()
        n = crear_nodo_op(6, token_valor(t), token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        left = n
    retorna left

# === Parsear potencia ===
funcion parsear_potencia()
    left = parsear_unario()
    si token_tipo(peek()) == 42
        t = avanzar()
        right = parsear_potencia()
        n = crear_nodo_op(6, "^", token_linea(t))
        agregar(n.hijos, left)
        agregar(n.hijos, right)
        retorna n
    retorna left

# === Parsear unario (-x, no x) ===
funcion parsear_unario()
    si token_tipo(peek()) == 38
        t = avanzar()
        operand = parsear_unario()
        n = crear_nodo_op(7, "-", token_linea(t))
        agregar(n.hijos, operand)
        retorna n
    retorna parsear_primario()

# === Parsear primario (numeros, strings, identificadores, llamadas) ===
funcion parsear_primario()
    t = peek()
    si token_tipo(t) == 34 o token_tipo(t) == 34
        avanzar()
        return crear_nodo(3, "verdad", token_linea(t))
    si token_tipo(t) == 35
        avanzar()
        return crear_nodo(3, "falso", token_linea(t))
    si token_tipo(t) == 36
        avanzar()
        return crear_nodo(4, "nada", token_linea(t))
    si token_tipo(t) == 1
        avanzar()
        return crear_nodo(1, token_valor(t), token_linea(t))
    si token_tipo(t) == 2
        avanzar()
        return crear_nodo(2, token_valor(t), token_linea(t))
    si token_tipo(t) == 59
        avanzar()
        elementos = [0]
        si token_tipo(peek()) != 60
            agregar(elementos, parsear_expresion())
            mientras token_tipo(peek()) == 63
                avanzar()
                agregar(elementos, parsear_expresion())
        consumir(60, "Se esperaba ]")
        n = crear_nodo(23, "", token_linea(t))
        para cada e en elementos
            agregar(n.hijos, e)
        retorna n
    si token_tipo(t) == 57
        avanzar()
        expr = parsear_expresion()
        consumir(58, "Se esperaba )")
        retorna expr
    si token_tipo(t) == 3 o token_tipo(t) == 20 o token_tipo(t) == 21 o token_tipo(t) == 23 o token_tipo(t) == 11
        avanzar()
        si token_tipo(peek()) == 57
            avanzar()
            args = [0]
            si token_tipo(peek()) != 58
                agregar(args, parsear_expresion())
                mientras token_tipo(peek()) == 63
                    avanzar()
                    agregar(args, parsear_expresion())
            consumir(58, "Se esperaba )")
            n = crear_nodo(9, "", token_linea(t))
            n.nombre = token_valor(t)
            para cada a en args
                agregar(n.hijos, a)
            retorna n
        return crear_nodo(5, token_valor(t), token_linea(t))
    return crear_nodo(4, "nada", token_linea(t))

# === Funcion principal: parsear ===
funcion parsear(lista_tokens)
    tokens_parser = lista_tokens
    pos_parser = 0
    programa = [0]
    mientras token_tipo(peek()) != 0
        s = parsear_statement()
        si s != nada
            agregar(programa, s)
        mientras token_tipo(peek()) == 67 o token_tipo(peek()) == 69
            avanzar()
    retorna programa

# === Test ===

# === From codegen.zen ===
# codegen.zen — Generador de codigo LLVM IR escrito EN Zen
#
# Etapa 4: el codegen recorre el AST y genera codigo LLVM IR.
# Depende de ast.zen (struct Nodo, constantes NODO_*, helpers)
#
# FFI a LLVM-C API






funcion codegen_init()
    estado = CodeGenState {modulo: 0, builder: 0}
    estado.modulo = LLVMModuleCreateWithName("zen")
    estado.builder = LLVMCreateBuilder()
    retorna estado

funcion codegen_declarar_externs(estado)
    mod = estado_modulo(estado)
    i8p = i8ptr_type()
    i32 = LLVMInt32Type()
    i64 = LLVMInt64Type()
    printf_type = LLVMFunctionType(i32, i8p, 1)
    LLVMAddFunction(mod, "printf", printf_type)
    malloc_type = LLVMFunctionType(i8p, i64, 0)
    LLVMAddFunction(mod, "malloc", malloc_type)

funcion codegen_expresion(estado, nodo)
    tipo = nodo_tipo(nodo)
    si tipo == 1
        retorna LLVMConstReal(LLVMDoubleType(), numero(nodo_valor(nodo)))
    si tipo == 2
        retorna LLVMConstString(nodo_valor(nodo), 0, 0)
    si tipo == 6
        op = nodo_op(nodo)
        hijos = nodo.hijos
        left = codegen_expresion(estado, hijos[0])
        right = codegen_expresion(estado, hijos[1])
        si op == "+"
            retorna LLVMBuildFAdd(estado_builder(estado), left, right, "add")
        si op == "-"
            retorna LLVMBuildFSub(estado_builder(estado), left, right, "sub")
        si op == "*"
            retorna LLVMBuildFMul(estado_builder(estado), left, right, "mul")
        si op == "/"
            retorna LLVMBuildFDiv(estado_builder(estado), left, right, "div")
        retorna 0
    si tipo == 9
        nombre = nodo_nombre(nodo)
        si nombre == "muestra"
            hijos = nodo.hijos
            arg = codegen_expresion(estado, hijos[0])
            fmt = LLVMConstString("%g\n", 0, 0)
            printf_fn = LLVMGetNamedFunction(estado_modulo(estado), "printf")
            args = [fmt, arg]
            retorna LLVMBuildCall(estado_builder(estado), printf_fn, args, 2, "print")
        retorna 0
    retorna 0

funcion codegen_statement(estado, nodo)
    tipo = nodo_tipo(nodo)
    si tipo == 12
        hijos = nodo.hijos
        codegen_expresion(estado, hijos[0])
        retorna 0
    si tipo == 10
        hijos = nodo.hijos
        val = codegen_expresion(estado, hijos[0])
        nombre = nodo_nombre(nodo)
        alloca = LLVMBuildAlloca(estado_builder(estado), LLVMDoubleType(), nombre)
        LLVMBuildStore(estado_builder(estado), val, alloca)
        retorna 0
    si tipo == 21
        hijos = nodo.hijos
        val = codegen_expresion(estado, hijos[0])
        LLVMBuildRet(estado_builder(estado), val)
        retorna 0
    si tipo == 20
        retorna 0
    si tipo == 22
        hijos = nodo.hijos
        codegen_expresion(estado, hijos[0])
        retorna 0
    retorna 0

funcion codegen_programa(estado, programa)
    codegen_declarar_externs(estado)
    i32 = LLVMInt32Type()
    main_type = LLVMFunctionType(i32, 0, 0)
    main_func = LLVMAddFunction(estado_modulo(estado), "main", main_type)
    entry = LLVMAppendBasicBlock(main_func, "entry")
    LLVMPositionBuilderAtEnd(estado_builder(estado), entry)
    para cada stmt en programa
        codegen_statement(estado, stmt)
    LLVMBuildRet(estado_builder(estado), LLVMConstInt(i32, 0, 0))

funcion codegen_compilar(estado, ruta_salida)
    LLVMPrintModuleToFile(estado_modulo(estado), ruta_salida, nada)

funcion codegen_finalize(estado)
    LLVMDisposeBuilder(estado_builder(estado))
    LLVMDisposeModule(estado_modulo(estado))


# === Test ===
muestra "=== Compilador Zen escrito en Zen ==="
muestra "Componentes: AST + Lexer + Parser + Codegen + Main"
muestra "Zen sobre Zen: todos los componentes en un solo archivo"
muestra ""
muestra "Compilador Zen cargado OK!"
