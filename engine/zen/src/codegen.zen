# codegen.zen — Generador de codigo LLVM IR de Zen escrito EN Zen
#
# Modulo: funciones codegen_* que toman el AST y producen LLVM IR.
#
# Importa: ast (structs Nodo)
# No contiene statements de nivel superior (solo definiciones y externs).

importar "ast"

# ============================================================
# Externs LLVM C API
# ============================================================

extern "libLLVM" LLVMModuleCreateWithName(str) -> ptr
extern "libLLVM" LLVMCreateBuilder() -> ptr
extern "libLLVM" LLVMDisposeBuilder(ptr) -> void
extern "libLLVM" LLVMDisposeModule(ptr) -> void
extern "libLLVM" LLVMDumpModule(ptr) -> void
extern "libLLVM" LLVMPrintModuleToFile(ptr, str, ptr) -> int
extern "libLLVM" LLVMInt1Type() -> ptr
extern "libLLVM" LLVMInt8Type() -> ptr
extern "libLLVM" LLVMInt32Type() -> ptr
extern "libLLVM" LLVMInt64Type() -> ptr
extern "libLLVM" LLVMFloatType() -> ptr
extern "libLLVM" LLVMDoubleType() -> ptr
extern "libLLVM" LLVMVoidType() -> ptr
extern "libLLVM" LLVMPointerType(ptr, uint) -> ptr
extern "libLLVM" LLVMFunctionType(ptr, ptr, int) -> ptr
extern "libLLVM" LLVMAddFunction(ptr, str, ptr) -> ptr
extern "libLLVM" LLVMGetParam(ptr, int) -> ptr
extern "libLLVM" LLVMAppendBasicBlock(ptr, str) -> ptr
extern "libLLVM" LLVMPositionBuilderAtEnd(ptr, ptr) -> void
extern "libLLVM" LLVMBuildRet(ptr, ptr) -> ptr
extern "libLLVM" LLVMBuildRetVoid(ptr) -> ptr
extern "libLLVM" LLVMBuildFAdd(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildFSub(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildFMul(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildFDiv(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildFRem(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildAlloca(ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildStore(ptr, ptr, ptr) -> ptr
extern "libLLVM" LLVMBuildLoad(ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildCall(ptr, ptr, ptr, int, str) -> ptr
extern "libLLVM" LLVMConstReal(ptr, double) -> ptr
extern "libLLVM" LLVMConstString(str, int, int) -> ptr
extern "libLLVM" LLVMConstInt(ptr, int, int) -> ptr
extern "libLLVM" LLVMGetNamedFunction(ptr, str) -> ptr
extern "libLLVM" LLVMBuildFCmp(ptr, int, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildBr(ptr, ptr) -> ptr
extern "libLLVM" LLVMBuildCondBr(ptr, ptr, ptr, ptr) -> ptr
extern "libLLVM" LLVMBuildNeg(ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildNot(ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildUIToFP(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildFPToSI(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildIntToPtr(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildBitCast(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMConstPointerNull(ptr) -> ptr
extern "libLLVM" LLVMConstArray(ptr, ptr, int) -> ptr
extern "libLLVM" LLVMAddGlobal(ptr, ptr, str) -> ptr
extern "libLLVM" LLVMSetInitializer(ptr, ptr) -> void
extern "libLLVM" LLVMSetGlobalConstant(ptr, int) -> void
extern "libLLVM" LLVMSetLinkage(ptr, int) -> void
extern "libLLVM" LLVMGetNamedGlobal(ptr, str) -> ptr
extern "libLLVM" zen_concat(ptr, ptr) -> ptr
extern "libLLVM" __zen_num_to_str(double) -> ptr
extern "libLLVM" __zen_list_create(long) -> ptr
extern "libLLVM" __zen_list_push(ptr, ptr) -> void
extern "libLLVM" __zen_list_get(ptr, long) -> ptr
extern "libLLVM" __zen_struct_create(long) -> ptr
extern "libLLVM" __zen_struct_set(ptr, long, ptr) -> void
extern "libLLVM" __zen_struct_get(ptr, long) -> ptr
extern "libLLVM" LLVMBuildPhi(ptr, str) -> ptr
extern "libLLVM" LLVMAddIncoming(ptr, ptr, ptr, int, ptr) -> void
extern "libLLVM" LLVMGetInsertBlock(ptr) -> ptr
extern "libLLVM" LLVMBuildCast(ptr, int, ptr, str) -> ptr
extern "libLLVM" LLVMConstBitCast(ptr, ptr) -> ptr
extern "libLLVM" LLVMBuildGEP(ptr, ptr, ptr, int, str) -> ptr
extern "libLLVM" LLVMTypeOf(ptr) -> ptr
extern "libLLVM" LLVMBuildAnd(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildOr(ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMBuildSelect(ptr, ptr, ptr, ptr, str) -> ptr
extern "libLLVM" LLVMInitializeX86Target() -> void
extern "libLLVM" LLVMInitializeX86AsmPrinter() -> void
extern "libLLVM" LLVMInitializeX86TargetInfo() -> void
extern "libLLVM" LLVMInitializeX86TargetMC() -> void
extern "libLLVM" LLVMGetDefaultTargetTriple() -> str
extern "libLLVM" LLVMGetTargetFromTriple(str, ptr, ptr) -> int
extern "libLLVM" LLVMCreateTargetMachine(ptr, str, str, ptr, int, int, int) -> ptr
extern "libLLVM" LLVMTargetMachineEmitToFile(ptr, ptr, str, int, ptr) -> int
extern "libLLVM" LLVMDisposeTargetMachine(ptr) -> void

# Externs libc
extern "libc" printf(str) -> int
extern "libc" malloc(int) -> ptr
extern "libc" strlen(str) -> int
extern "libc" strcpy(ptr, ptr) -> ptr
extern "libc" strcat(ptr, ptr) -> ptr
extern "libc" sprintf(ptr, str, double) -> int
extern "libc" strtod(ptr, ptr) -> double

# ============================================================
# Estado de codegen (modulo-level)
# ============================================================

loop_end_bb = 0
loop_cond_bb = 0

# ============================================================
# Helpers
# ============================================================

funcion estado_modulo(e)
    retorna e.modulo

funcion estado_builder(e)
    retorna e.builder

funcion i8ptr_type()
    retorna LLVMPointerType(LLVMInt8Type(), 0)

# ============================================================
# Init / Finalize
# ============================================================

funcion codegen_init()
    estado = CodeGenState {modulo: 0, builder: 0}
    estado.modulo = LLVMModuleCreateWithName("zen")
    estado.builder = LLVMCreateBuilder()
    retorna estado

funcion codegen_declarar_externs(estado)
    mod = estado_modulo(estado)
    i8p = i8ptr_type()
    i32 = LLVMInt32Type()
    i64 = LLVMInt64Type()
    dty = LLVMDoubleType()
    void_type = LLVMVoidType()
    # libc
    printf_type = LLVMFunctionType(i32, i8p, 1)
    LLVMAddFunction(mod, "printf", printf_type)
    malloc_type = LLVMFunctionType(i8p, i64, 0)
    LLVMAddFunction(mod, "malloc", malloc_type)
    strlen_type = LLVMFunctionType(i64, i8p, 0)
    LLVMAddFunction(mod, "strlen", strlen_type)
    sprintf_type = LLVMFunctionType(i32, i8p, 0)
    LLVMAddFunction(mod, "sprintf", sprintf_type)
    strtod_type = LLVMFunctionType(dty, i8p, 0)
    LLVMAddFunction(mod, "strtod", strtod_type)
    strcpy_type = LLVMFunctionType(i8p, i8p, 0)
    LLVMAddFunction(mod, "strcpy", strcpy_type)
    strcat_type = LLVMFunctionType(i8p, i8p, 0)
    LLVMAddFunction(mod, "strcat", strcat_type)
    # __zen_list_* runtime (i64 por compatibilidad con LLVM C API)
    list_create_type = LLVMFunctionType(i8p, i64, 0)
    LLVMAddFunction(mod, "__zen_list_create", list_create_type)
    list_push_type = LLVMFunctionType(void_type, i8p, 1)
    LLVMAddFunction(mod, "__zen_list_push", list_push_type)
    list_get_type = LLVMFunctionType(i8p, dty, 0)
    LLVMAddFunction(mod, "__zen_list_get", list_get_type)
    # __zen_struct_* runtime
    struct_create_type = LLVMFunctionType(i8p, dty, 0)
    LLVMAddFunction(mod, "__zen_struct_create", struct_create_type)
    struct_set_type = LLVMFunctionType(void_type, i8p, 2)
    LLVMAddFunction(mod, "__zen_struct_set", struct_set_type)
    struct_get_type = LLVMFunctionType(i8p, i8p, 1)
    LLVMAddFunction(mod, "__zen_struct_get", struct_get_type)
    # runtime helpers
    num_to_str_type = LLVMFunctionType(i8p, dty, 0)
    LLVMAddFunction(mod, "__zen_num_to_str", num_to_str_type)
    concat_type = LLVMFunctionType(i8p, i8p, 1)
    LLVMAddFunction(mod, "zen_concat", concat_type)

funcion codegen_finalize(estado)
    LLVMDisposeBuilder(estado_builder(estado))
    LLVMDisposeModule(estado_modulo(estado))

# ============================================================
# Codegen de expresiones
# ============================================================

funcion codegen_expresion(estado, nodo)
    tipo = nodo_tipo(nodo)
    si tipo == 1
        retorna LLVMConstReal(LLVMDoubleType(), numero(nodo_valor(nodo)))
    si tipo == 2
        str_val = nodo_valor(nodo)
        ret = LLVMConstString(str_val, 0, 0)
        gvar = LLVMAddGlobal(estado_modulo(estado), LLVMInt8Type(), ".str")
        LLVMSetInitializer(gvar, ret)
        LLVMSetGlobalConstant(gvar, 1)
        LLVMSetLinkage(gvar, 0)
        retorna LLVMBuildBitCast(estado_builder(estado), gvar, i8ptr_type(), "strptr")
    si tipo == 3
        val = numero(nodo_valor(nodo))
        si val == 0
            retorna LLVMConstInt(LLVMInt1Type(), 0, 0)
        retorna LLVMConstInt(LLVMInt1Type(), 1, 0)
    si tipo == 4
        retorna LLVMConstPointerNull(i8ptr_type())
    si tipo == 5
        nombre = nodo_valor(nodo)
        func = LLVMGetNamedFunction(estado_modulo(estado), nombre)
        si func != 0
            args = [0]
            retorna LLVMBuildCall(estado_builder(estado), func, args, 0, "call")
        # Variable global o local — buscar como global
        gvar = LLVMGetNamedGlobal(estado_modulo(estado), "g_" + nombre)
        si gvar != 0
            b = estado_builder(estado)
            retorna LLVMBuildLoad(b, gvar, nombre)
        retorna 0
    si tipo == 6
        op = nodo_op(nodo)
        hijos = nodo.hijos
        left = codegen_expresion(estado, hijos[0])
        right = codegen_expresion(estado, hijos[1])
        b = estado_builder(estado)
        si op == "+"
            # String concat si ambos son strings: usar zen_concat
            concat_fn = LLVMGetNamedFunction(estado_modulo(estado), "zen_concat")
            si concat_fn != 0
                args = [left, right]
                retorna LLVMBuildCall(b, concat_fn, args, 2, "concat")
            retorna LLVMBuildFAdd(b, left, right, "add")
        si op == "-"
            retorna LLVMBuildFSub(b, left, right, "sub")
        si op == "*"
            retorna LLVMBuildFMul(b, left, right, "mul")
        si op == "/"
            retorna LLVMBuildFDiv(b, left, right, "div")
        si op == "%"
            retorna LLVMBuildFRem(b, left, right, "mod")
        si op == "=="
            retorna LLVMBuildFCmp(b, 1, left, right, "eq")
        si op == "!="
            retorna LLVMBuildFCmp(b, 4, left, right, "ne")
        si op == "<"
            retorna LLVMBuildFCmp(b, 2, left, right, "lt")
        si op == ">"
            retorna LLVMBuildFCmp(b, 3, left, right, "gt")
        si op == "<="
            retorna LLVMBuildFCmp(b, 6, left, right, "le")
        si op == ">="
            retorna LLVMBuildFCmp(b, 5, left, right, "ge")
        si op == "and"
            retorna LLVMBuildAnd(b, left, right, "and")
        si op == "or"
            retorna LLVMBuildOr(b, left, right, "or")
        retorna 0
    si tipo == 7
        op = nodo_op(nodo)
        hijos = nodo.hijos
        operand = codegen_expresion(estado, hijos[0])
        b = estado_builder(estado)
        si op == "-"
            retorna LLVMBuildNeg(b, operand, "neg")
        si op == "not"
            retorna LLVMBuildNot(b, operand, "not")
        retorna operand
    si tipo == 8
        # Ternary: cond ? then : else
        # Simplificado: evaluar ambos y seleccionar en runtime (sin Phi nodes)
        hijos = nodo.hijos
        b = estado_builder(estado)
        cond = codegen_expresion(estado, hijos[0])
        then_val = codegen_expresion(estado, hijos[1])
        else_val = codegen_expresion(estado, hijos[2])
        # select(cond, then, else)
        retorna LLVMBuildSelect(b, cond, then_val, else_val, "ternary")
    si tipo == 9
        # FuncCall
        nombre = nodo_nombre(nodo)
        hijos = nodo.hijos
        b = estado_builder(estado)
        mod = estado_modulo(estado)
        # Builtins nativos del codegen C++
        si nombre == "muestra" o nombre == "show" o nombre == "mostrar" o nombre == "imprime"
            arg = codegen_expresion(estado, hijos[0])
            fmt = LLVMConstString("%g\n", 0, 0)
            gvar = LLVMAddGlobal(mod, LLVMInt8Type(), ".fmt")
            LLVMSetInitializer(gvar, fmt)
            LLVMSetGlobalConstant(gvar, 1)
            LLVMSetLinkage(gvar, 0)
            fmt_ptr = LLVMBuildBitCast(b, gvar, i8ptr_type(), "fmtptr")
            printf_fn = LLVMGetNamedFunction(mod, "printf")
            args = [fmt_ptr, arg]
            retorna LLVMBuildCall(b, printf_fn, args, 2, "print")
        si nombre == "longitud" o nombre == "length" o nombre == "len"
            arg = codegen_expresion(estado, hijos[0])
            strlen_fn = LLVMGetNamedFunction(mod, "strlen")
            args = [arg]
            ret = LLVMBuildCall(b, strlen_fn, args, 1, "len")
            retorna LLVMBuildUIToFP(b, ret, LLVMDoubleType(), "lend")
        si nombre == "numero" o nombre == "number" o nombre == "num"
            arg = codegen_expresion(estado, hijos[0])
            strtod_fn = LLVMGetNamedFunction(mod, "strtod")
            nullp = LLVMConstPointerNull(LLVMPointerType(i8ptr_type(), 0))
            args = [arg, nullp]
            retorna LLVMBuildCall(b, strtod_fn, args, 2, "num")
        si nombre == "texto" o nombre == "text" o nombre == "str"
            arg = codegen_expresion(estado, hijos[0])
            num_to_str_fn = LLVMGetNamedFunction(mod, "__zen_num_to_str")
            args = [arg]
            retorna LLVMBuildCall(b, num_to_str_fn, args, 1, "txt")
        si nombre == "agregar" o nombre == "push" o nombre == "append"
            lista = codegen_expresion(estado, hijos[0])
            elem = codegen_expresion(estado, hijos[1])
            push_fn = LLVMGetNamedFunction(mod, "__zen_list_push")
            args = [lista, elem]
            LLVMBuildCall(b, push_fn, args, 2, "push")
            retorna lista
        si nombre == "char_at" o nombre == "char_codigo"
            arg = codegen_expresion(estado, hijos[0])
            idx = codegen_expresion(estado, hijos[1])
            # Simplificado: retorna 0
            retorna LLVMConstPointerNull(i8ptr_type())
        # User-defined function call
        func = LLVMGetNamedFunction(mod, nombre)
        si func != 0
            num_args = longitud(hijos)
            args = [0]
            idx = 0
            mientras idx < num_args
                arg_val = codegen_expresion(estado, hijos[idx])
                agregar(args, arg_val)
                idx = idx + 1
            retorna LLVMBuildCall(b, func, args, num_args, "call")
        retorna 0
    si tipo == 23
        # ListLit
        retorna codegen_list_lit(estado, nodo)
    si tipo == 24
        # IndexAccess: lista[indice]
        retorna codegen_index_access(estado, nodo)
    si tipo == 27
        # StructLit
        retorna codegen_struct_lit(estado, nodo)
    si tipo == 28
        # MemberAccess: struct.campo
        retorna codegen_member_access(estado, nodo)
    retorna 0

# ============================================================
# Codegen de statements
# ============================================================

funcion codegen_statement(estado, nodo)
    tipo = nodo_tipo(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    si tipo == 12
        hijos = nodo.hijos
        codegen_expresion(estado, hijos[0])
        retorna 0
    si tipo == 10
        hijos = nodo.hijos
        val = codegen_expresion(estado, hijos[0])
        nombre = nodo_nombre(nodo)
        alloca = LLVMBuildAlloca(b, LLVMDoubleType(), nombre)
        LLVMBuildStore(b, val, alloca)
        retorna 0
    si tipo == 21
        hijos = nodo.hijos
        val = codegen_expresion(estado, hijos[0])
        LLVMBuildRet(b, val)
        retorna 0
    si tipo == 20
        nombre = nodo_nombre(nodo)
        hijos = nodo.hijos
        num_hijos = longitud(hijos)
        num_params = 0
        idx = 0
        mientras idx < num_hijos
            si nodo_tipo(hijos[idx]) == 5
                num_params = num_params + 1
                idx = idx + 1
            sino
                romper
        double_ty = LLVMDoubleType()
        func_type = LLVMFunctionType(double_ty, 0, 0)
        func = LLVMAddFunction(mod, nombre, func_type)
        entry_bb = LLVMAppendBasicBlock(func, "entry")
        LLVMPositionBuilderAtEnd(b, entry_bb)
        body_idx = num_params
        mientras body_idx < num_hijos
            codegen_statement(estado, hijos[body_idx])
            body_idx = body_idx + 1
        LLVMPositionBuilderAtEnd(b, LLVMAppendBasicBlock(LLVMGetNamedFunction(mod, "main"), "resume"))
        retorna 0
    si tipo == 22
        hijos = nodo.hijos
        codegen_expresion(estado, hijos[0])
        retorna 0
    si tipo == 13
        hijos = nodo.hijos
        cond = codegen_expresion(estado, hijos[0])
        main_fn = LLVMGetNamedFunction(mod, "main")
        then_bb = LLVMAppendBasicBlock(main_fn, "then")
        else_bb = LLVMAppendBasicBlock(main_fn, "else")
        merge_bb = LLVMAppendBasicBlock(main_fn, "merge")
        LLVMBuildCondBr(b, cond, then_bb, else_bb)
        LLVMPositionBuilderAtEnd(b, then_bb)
        idx = 1
        num_hijos = longitud(hijos)
        mientras idx < num_hijos
            stmt = hijos[idx]
            si nodo_tipo(stmt) == 13
                romper
            codegen_statement(estado, stmt)
            idx = idx + 1
        LLVMBuildBr(b, merge_bb)
        LLVMPositionBuilderAtEnd(b, else_bb)
        mientras idx < num_hijos
            codegen_statement(estado, hijos[idx])
            idx = idx + 1
        LLVMBuildBr(b, merge_bb)
        LLVMPositionBuilderAtEnd(b, merge_bb)
        retorna 0
    si tipo == 16
        hijos = nodo.hijos
        main_fn = LLVMGetNamedFunction(mod, "main")
        cond_bb = LLVMAppendBasicBlock(main_fn, "while.cond")
        body_bb = LLVMAppendBasicBlock(main_fn, "while.body")
        end_bb = LLVMAppendBasicBlock(main_fn, "while.end")
        old_end = loop_end_bb
        old_cond = loop_cond_bb
        loop_end_bb = end_bb
        loop_cond_bb = cond_bb
        LLVMBuildBr(b, cond_bb)
        LLVMPositionBuilderAtEnd(b, cond_bb)
        cond = codegen_expresion(estado, hijos[0])
        LLVMBuildCondBr(b, cond, body_bb, end_bb)
        LLVMPositionBuilderAtEnd(b, body_bb)
        idx = 1
        num_hijos = longitud(hijos)
        mientras idx < num_hijos
            codegen_statement(estado, hijos[idx])
            idx = idx + 1
        LLVMBuildBr(b, cond_bb)
        LLVMPositionBuilderAtEnd(b, end_bb)
        loop_end_bb = old_end
        loop_cond_bb = old_cond
        retorna 0
    si tipo == 14
        nombre = nodo_nombre(nodo)
        hijos = nodo.hijos
        desde_val = codegen_expresion(estado, hijos[0])
        hasta_val = codegen_expresion(estado, hijos[1])
        main_fn = LLVMGetNamedFunction(mod, "main")
        loop_var = LLVMBuildAlloca(b, LLVMDoubleType(), nombre)
        LLVMBuildStore(b, desde_val, loop_var)
        cond_bb = LLVMAppendBasicBlock(main_fn, "for.cond")
        body_bb = LLVMAppendBasicBlock(main_fn, "for.body")
        end_bb = LLVMAppendBasicBlock(main_fn, "for.end")
        old_end = loop_end_bb
        old_cond = loop_cond_bb
        loop_end_bb = end_bb
        loop_cond_bb = cond_bb
        LLVMBuildBr(b, cond_bb)
        LLVMPositionBuilderAtEnd(b, cond_bb)
        cur_val = LLVMBuildLoad(b, loop_var, nombre)
        cmp = LLVMBuildFCmp(b, 4, cur_val, hasta_val, "forcmp")
        LLVMBuildCondBr(b, cmp, body_bb, end_bb)
        LLVMPositionBuilderAtEnd(b, body_bb)
        idx = 2
        num_hijos = longitud(hijos)
        mientras idx < num_hijos
            codegen_statement(estado, hijos[idx])
            idx = idx + 1
        next_val = LLVMBuildFAdd(b, cur_val, LLVMConstReal(LLVMDoubleType(), 1), "forinc")
        LLVMBuildStore(b, next_val, loop_var)
        LLVMBuildBr(b, cond_bb)
        LLVMPositionBuilderAtEnd(b, end_bb)
        loop_end_bb = old_end
        loop_cond_bb = old_cond
        retorna 0
    si tipo == 29
        hijos = nodo.hijos
        base = codegen_expresion(estado, hijos[0])
        val = codegen_expresion(estado, hijos[1])
        set_fn = LLVMGetNamedFunction(mod, "__zen_struct_set")
        si set_fn != 0
            field_idx = LLVMConstReal(LLVMDoubleType(), 0)
            args = [base, field_idx, val]
            LLVMBuildCall(b, set_fn, args, 3, "sset")
        retorna 0
    si tipo == 18
        si loop_end_bb != 0
            LLVMBuildBr(b, loop_end_bb)
        retorna 0
    si tipo == 19
        si loop_cond_bb != 0
            LLVMBuildBr(b, loop_cond_bb)
        retorna 0
    si tipo == 30
        retorna 0
    retorna 0

# ============================================================
# Codegen especializado (structs / listas)
# ============================================================

funcion codegen_struct_lit(estado, nodo)
    hijos = nodo.hijos
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    num = longitud(hijos)
    create_fn = LLVMGetNamedFunction(mod, "__zen_struct_create")
    si create_fn == 0
        retorna 0
    # __zen_struct_create espera long (i64)
    cap_i64 = LLVMConstInt(LLVMInt64Type(), num, 0)
    args = [cap_i64]
    Struct = LLVMBuildCall(b, create_fn, args, 1, "newstruct")
    set_fn = LLVMGetNamedFunction(mod, "__zen_struct_set")
    idx = 0
    mientras idx < num
        val = codegen_expresion(estado, hijos[idx])
        si set_fn != 0
            field_idx = LLVMConstInt(LLVMInt64Type(), idx, 0)
            args2 = [Struct, field_idx, val]
            LLVMBuildCall(b, set_fn, args2, 3, "sset")
        idx = idx + 1
    retorna Struct

funcion codegen_member_access(estado, nodo)
    hijos = nodo.hijos
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    base = codegen_expresion(estado, hijos[0])
    # __zen_struct_get espera long (i64)
    field_idx = LLVMConstInt(LLVMInt64Type(), 0, 0)
    get_fn = LLVMGetNamedFunction(mod, "__zen_struct_get")
    si get_fn == 0
        retorna 0
    args = [base, field_idx]
    retorna LLVMBuildCall(b, get_fn, args, 2, "mget")

funcion codegen_list_lit(estado, nodo)
    hijos = nodo.hijos
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    list_fn = LLVMGetNamedFunction(mod, "__zen_list_create")
    si list_fn == 0
        retorna 0
    num = longitud(hijos)
    # __zen_list_create espera long (i64)
    cap_i64 = LLVMConstInt(LLVMInt64Type(), num, 0)
    args = [cap_i64]
    lista = LLVMBuildCall(b, list_fn, args, 1, "newlist")
    idx = 0
    mientras idx < num
        elem = codegen_expresion(estado, hijos[idx])
        push_fn = LLVMGetNamedFunction(mod, "__zen_list_push")
        si push_fn != 0
            args2 = [lista, elem]
            LLVMBuildCall(b, push_fn, args2, 2, "push")
        idx = idx + 1
    retorna lista

funcion codegen_index_access(estado, nodo)
    hijos = nodo.hijos
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    base = codegen_expresion(estado, hijos[0])
    idx_val = codegen_expresion(estado, hijos[1])
    # __zen_list_get espera (ptr, long) - convertir idx_val de i8* a i64
    # via strtod + fptosi
    strtod_fn = LLVMGetNamedFunction(mod, "strtod")
    nullp = LLVMConstPointerNull(LLVMPointerType(i8ptr_type(), 0))
    conv_args = [idx_val, nullp]
    idx_double = LLVMBuildCall(b, strtod_fn, conv_args, 2, "idxd")
    idx_i64 = LLVMBuildFPToSI(b, idx_double, LLVMInt64Type(), "idxi64")
    get_fn = LLVMGetNamedFunction(mod, "__zen_list_get")
    si get_fn == 0
        retorna 0
    args = [base, idx_i64]
    retorna LLVMBuildCall(b, get_fn, args, 2, "lget")

# ============================================================
# Programa / Compilacion / Native emit
# ============================================================

funcion codegen_programa(estado, programa)
    # NOTA: codegen_declarar_externs() esta desactivado porque genera
    # LLVMFunctionType mal (la C API requiere 4 args: ret, paramTypes[],
    # paramCount, isVarArg). El codegen C++ ya declara las externs
    # automaticamente cuando las necesita via getOrDeclareFunction().
    # codegen_declarar_externs(estado)
    i32 = LLVMInt32Type()
    main_type = LLVMFunctionType(i32, 0, 0)
    main_func = LLVMAddFunction(estado_modulo(estado), "main", main_type)
    entry = LLVMAppendBasicBlock(main_func, "entry")
    LLVMPositionBuilderAtEnd(estado_builder(estado), entry)
    para cada stmt en programa
        codegen_statement(estado, stmt)
    LLVMBuildRet(estado_builder(estado), LLVMConstInt(i32, 0, 0))

funcion codegen_compilar(estado, ruta_salida)
    LLVMPrintModuleToFile(estado_modulo(estado), ruta_salida, nada)

funcion codegen_compilar_nativo(estado, ruta_obj)
    LLVMInitializeX86TargetInfo()
    LLVMInitializeX86Target()
    LLVMInitializeX86TargetMC()
    LLVMInitializeX86AsmPrinter()
    triple = LLVMGetDefaultTargetTriple()
    target_ptr = 0
    error_ptr = 0
    LLVMGetTargetFromTriple(triple, 0, 0)
    tm = LLVMCreateTargetMachine(0, triple, "", 0, 0, 0, 0)
    LLVMTargetMachineEmitToFile(tm, estado_modulo(estado), ruta_obj, 0, 0)
    LLVMDisposeTargetMachine(tm)
