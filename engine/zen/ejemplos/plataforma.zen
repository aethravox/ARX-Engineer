#lang es

# Ejemplo de compilacion condicional por plataforma
# Compilar con: zen plataforma.zen --platform linux --run
#            o: zen plataforma.zen --platform windows --run
#            o: zen plataforma.zen --platform macos --run

muestra "Zen Lang - Demo de Plataformas"
muestra ""

plataforma windows
    muestra "[Windows] Hola desde Windows!"
    muestra "[Windows] Usando la API de Windows..."

plataforma linux
    muestra "[Linux] Hola desde Linux!"
    muestra "[Linux] Usando syscalls de Linux..."

plataforma macos
    muestra "[macOS] Hola desde macOS!"
    muestra "[macOS] Usando frameworks de Apple..."

plataforma android
    muestra "[Android] Hola desde Android!"
    muestra "[Android] Usando la API de Android..."

muestra ""
muestra "Esto siempre se ejecuta (codigo comun)"

# Demo de while
contador = 0
mientras contador < 5
    muestra "Contador: " + contador
    contador += 1

# Demo de repetir
repetir 3 veces
    muestra "Zen!"

# Demo de break
para i desde 1 hasta 10
    si i == 5
        romper
    muestra i

# Demo de ternario
x = 10
resultado = x > 5 ? "grande" : "pequeño"
muestra "x es " + resultado
