CodeGenState {modulo, builder}

funcion estado_modulo(e)
    retorna e.modulo
funcion estado_builder(e)
    retorna e.builder
funcion i8ptr_type()
    retorna LLVMPointerType(LLVMInt8Type(), 0)
funcion nodo_tipo(n)
    retorna n.tipo

funcion nodo_valor(n)
    retorna n.valor

funcion nodo_nombre(n)
    retorna n.nombre

funcion nodo_op(n)
    retorna n.op

funcion nodo_linea(n)
    retorna n.linea

funcion codegen_init()
    estado = CodeGenState {modulo: 0, builder: 0}
    estado.modulo = LLVMModuleCreateWithName("zen")
    estado.builder = LLVMCreateBuilder()
    retorna estado
funcion codegen_declarar_externs(estado)
    mod = estado_modulo(estado)
    i8p = i8ptr_type()
    i32 = LLVMInt32Type()
    i64 = LLVMInt64Type()
    printf_type = LLVMFunctionType(i32, i8p, 1)
    LLVMAddFunction(mod, "printf", printf_type)
    malloc_type = LLVMFunctionType(i8p, i64, 0)
    LLVMAddFunction(mod, "malloc", malloc_type)
    strlen_type = LLVMFunctionType(i64, i8p, 0)
    LLVMAddFunction(mod, "strlen", strlen_type)
    sprintf_type = LLVMFunctionType(i32, i8p, 0)
    LLVMAddFunction(mod, "sprintf", sprintf_type)
    strtod_type = LLVMFunctionType(LLVMDoubleType(), i8p, 0)
    LLVMAddFunction(mod, "strtod", strtod_type)
    strcpy_type = LLVMFunctionType(i8p, i8p, 0)
    LLVMAddFunction(mod, "strcpy", strcpy_type)
    strcat_type = LLVMFunctionType(i8p, i8p, 0)
    LLVMAddFunction(mod, "strcat", strcat_type)
funcion codegen_expresion(estado, nodo)
    tipo = nodo_tipo(nodo)
    si tipo == 1
        retorna LLVMConstReal(LLVMDoubleType(), numero(nodo_valor(nodo)))
    si tipo == 2
        str_val = nodo_valor(nodo)
        ret = LLVMConstString(str_val, 0, 0)
        gvar = LLVMAddGlobal(estado_modulo(estado), LLVMInt8Type(), ".str")
        LLVMSetInitializer(gvar, ret)
        LLVMSetGlobalConstant(gvar, 1)
        LLVMSetLinkage(gvar, 0)
        retorna LLVMBuildBitCast(estado_builder(estado), gvar, i8ptr_type(), "strptr")
    si tipo == 3
        val = numero(nodo_valor(nodo))
        si val == 0
            retorna LLVMConstInt(LLVMInt1Type(), 0, 0)
        retorna LLVMConstInt(LLVMInt1Type(), 1, 0)
    si tipo == 4
        retorna LLVMConstPointerNull(i8ptr_type())
    si tipo == 5
        nombre = nodo_valor(nodo)
        func = LLVMGetNamedFunction(estado_modulo(estado), nombre)
        si func != 0
            args = [0]
            retorna LLVMBuildCall(estado_builder(estado), func, args, 0, "call")
        retorna 0
    si tipo == 6
        op = nodo_op(nodo)
        hijos = nodo.hijos
        left = codegen_expresion(estado, hijos[0])
        right = codegen_expresion(estado, hijos[1])
        b = estado_builder(estado)
        si op == "+"
            retorna LLVMBuildFAdd(b, left, right, "add")
        si op == "-"
            retorna LLVMBuildFSub(b, left, right, "sub")
        si op == "*"
            retorna LLVMBuildFMul(b, left, right, "mul")
        si op == "/"
            retorna LLVMBuildFDiv(b, left, right, "div")
        si op == "%"
            retorna LLVMBuildFRem(b, left, right, "mod")
        si op == "=="
            retorna LLVMBuildFCmp(b, 1, left, right, "eq")
        si op == "!="
            retorna LLVMBuildFCmp(b, 4, left, right, "ne")
        si op == "<"
            retorna LLVMBuildFCmp(b, 2, left, right, "lt")
        si op == ">"
            retorna LLVMBuildFCmp(b, 3, left, right, "gt")
        si op == "<="
            retorna LLVMBuildFCmp(b, 6, left, right, "le")
        si op == ">="
            retorna LLVMBuildFCmp(b, 5, left, right, "ge")
        retorna 0
    si tipo == 7
        op = nodo_op(nodo)
        hijos = nodo.hijos
        operand = codegen_expresion(estado, hijos[0])
        b = estado_builder(estado)
        si op == "-"
            retorna LLVMBuildNeg(b, operand, "neg")
        retorna operand
    si tipo == 9
        nombre = nodo_nombre(nodo)
        hijos = nodo.hijos
        b = estado_builder(estado)
        si nombre == "muestra" o nombre == "show" o nombre == "mostrar" o nombre == "imprime"
            arg = codegen_expresion(estado, hijos[0])
            fmt = LLVMConstString("%g\n", 0, 0)
            gvar = LLVMAddGlobal(estado_modulo(estado), LLVMInt8Type(), ".fmt")
            LLVMSetInitializer(gvar, fmt)
            LLVMSetGlobalConstant(gvar, 1)
            LLVMSetLinkage(gvar, 0)
            fmt_ptr = LLVMBuildBitCast(b, gvar, i8ptr_type(), "fmtptr")
            printf_fn = LLVMGetNamedFunction(estado_modulo(estado), "printf")
            args = [fmt_ptr, arg]
            retorna LLVMBuildCall(b, printf_fn, args, 2, "print")
        si nombre == "longitud" o nombre == "length" o nombre == "len"
            arg = codegen_expresion(estado, hijos[0])
            strlen_fn = LLVMGetNamedFunction(estado_modulo(estado), "strlen")
            args = [arg]
            ret = LLVMBuildCall(b, strlen_fn, args, 1, "len")
            retorna LLVMBuildUIToFP(b, ret, LLVMDoubleType(), "lend")
        si nombre == "numero" o nombre == "number" o nombre == "num"
            arg = codegen_expresion(estado, hijos[0])
            strtod_fn = LLVMGetNamedFunction(estado_modulo(estado), "strtod")
            nullp = LLVMConstPointerNull(LLVMPointerType(i8ptr_type(), 0))
            args = [arg, nullp]
            retorna LLVMBuildCall(b, strtod_fn, args, 2, "num")
        retorna 0
    retorna 0
funcion codegen_statement(estado, nodo)
    tipo = nodo_tipo(nodo)
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    si tipo == 12
        hijos = nodo.hijos
        codegen_expresion(estado, hijos[0])
        retorna 0
    si tipo == 10
        hijos = nodo.hijos
        val = codegen_expresion(estado, hijos[0])
        nombre = nodo_nombre(nodo)
        alloca = LLVMBuildAlloca(b, LLVMDoubleType(), nombre)
        LLVMBuildStore(b, val, alloca)
        retorna 0
    si tipo == 21
        hijos = nodo.hijos
        val = codegen_expresion(estado, hijos[0])
        LLVMBuildRet(b, val)
        retorna 0
    si tipo == 20
        nombre = nodo_nombre(nodo)
        hijos = nodo.hijos
        num_hijos = longitud(hijos)
        num_params = 0
        idx = 0
        mientras idx < num_hijos
            si nodo_tipo(hijos[idx]) == 5
                num_params = num_params + 1
                idx = idx + 1
            sino
                romper
        double_ty = LLVMDoubleType()
        func_type = LLVMFunctionType(double_ty, 0, 0)
        func = LLVMAddFunction(mod, nombre, func_type)
        entry_bb = LLVMAppendBasicBlock(func, "entry")
        LLVMPositionBuilderAtEnd(b, entry_bb)
        body_idx = num_params
        mientras body_idx < num_hijos
            codegen_statement(estado, hijos[body_idx])
            body_idx = body_idx + 1
        LLVMPositionBuilderAtEnd(b, LLVMAppendBasicBlock(LLVMGetNamedFunction(mod, "main"), "resume"))
        retorna 0
    si tipo == 22
        hijos = nodo.hijos
        codegen_expresion(estado, hijos[0])
        retorna 0
    si tipo == 13
        hijos = nodo.hijos
        cond = codegen_expresion(estado, hijos[0])
        main_fn = LLVMGetNamedFunction(mod, "main")
        then_bb = LLVMAppendBasicBlock(main_fn, "then")
        else_bb = LLVMAppendBasicBlock(main_fn, "else")
        merge_bb = LLVMAppendBasicBlock(main_fn, "merge")
        LLVMBuildCondBr(b, cond, then_bb, else_bb)
        LLVMPositionBuilderAtEnd(b, then_bb)
        idx = 1
        num_hijos = longitud(hijos)
        mientras idx < num_hijos
            stmt = hijos[idx]
            si nodo_tipo(stmt) == 13
                romper
            codegen_statement(estado, stmt)
            idx = idx + 1
        LLVMBuildBr(b, merge_bb)
        LLVMPositionBuilderAtEnd(b, else_bb)
        mientras idx < num_hijos
            codegen_statement(estado, hijos[idx])
            idx = idx + 1
        LLVMBuildBr(b, merge_bb)
        LLVMPositionBuilderAtEnd(b, merge_bb)
        retorna 0
    si tipo == 16
        hijos = nodo.hijos
        main_fn = LLVMGetNamedFunction(mod, "main")
        cond_bb = LLVMAppendBasicBlock(main_fn, "while.cond")
        body_bb = LLVMAppendBasicBlock(main_fn, "while.body")
        end_bb = LLVMAppendBasicBlock(main_fn, "while.end")
        LLVMBuildBr(b, cond_bb)
        LLVMPositionBuilderAtEnd(b, cond_bb)
        cond = codegen_expresion(estado, hijos[0])
        LLVMBuildCondBr(b, cond, body_bb, end_bb)
        LLVMPositionBuilderAtEnd(b, body_bb)
        idx = 1
        num_hijos = longitud(hijos)
        mientras idx < num_hijos
            codegen_statement(estado, hijos[idx])
            idx = idx + 1
        LLVMBuildBr(b, cond_bb)
        LLVMPositionBuilderAtEnd(b, end_bb)
        retorna 0
    si tipo == 14
        nombre = nodo_nombre(nodo)
        hijos = nodo.hijos
        desde_val = codegen_expresion(estado, hijos[0])
        hasta_val = codegen_expresion(estado, hijos[1])
        main_fn = LLVMGetNamedFunction(mod, "main")
        loop_var = LLVMBuildAlloca(b, LLVMDoubleType(), nombre)
        LLVMBuildStore(b, desde_val, loop_var)
        cond_bb = LLVMAppendBasicBlock(main_fn, "for.cond")
        body_bb = LLVMAppendBasicBlock(main_fn, "for.body")
        end_bb = LLVMAppendBasicBlock(main_fn, "for.end")
        LLVMBuildBr(b, cond_bb)
        LLVMPositionBuilderAtEnd(b, cond_bb)
        cur_val = LLVMBuildLoad(b, loop_var, nombre)
        cmp = LLVMBuildFCmp(b, 4, cur_val, hasta_val, "forcmp")
        LLVMBuildCondBr(b, cmp, body_bb, end_bb)
        LLVMPositionBuilderAtEnd(b, body_bb)
        idx = 2
        num_hijos = longitud(hijos)
        mientras idx < num_hijos
            codegen_statement(estado, hijos[idx])
            idx = idx + 1
        next_val = LLVMBuildFAdd(b, cur_val, LLVMConstReal(LLVMDoubleType(), 1), "forinc")
        LLVMBuildStore(b, next_val, loop_var)
        LLVMBuildBr(b, cond_bb)
        LLVMPositionBuilderAtEnd(b, end_bb)
        retorna 0
    si tipo == 18
        retorna 0
    si tipo == 19
        retorna 0
    retorna 0
funcion codegen_list_lit(estado, nodo)
    hijos = nodo.hijos
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    list_fn = LLVMGetNamedFunction(mod, "__zen_list_create")
    si list_fn == 0
        retorna 0
    lista = LLVMBuildCall(b, list_fn, [0], 0, "newlist")
    idx = 0
    num = longitud(hijos)
    mientras idx < num
        elem = codegen_expresion(estado, hijos[idx])
        push_fn = LLVMGetNamedFunction(mod, "__zen_list_push")
        si push_fn != 0
            args = [lista, elem]
            LLVMBuildCall(b, push_fn, args, 2, "push")
        idx = idx + 1
    retorna lista
funcion codegen_index_access(estado, nodo)
    hijos = nodo.hijos
    b = estado_builder(estado)
    mod = estado_modulo(estado)
    base = codegen_expresion(estado, hijos[0])
    idx_val = codegen_expresion(estado, hijos[1])
    get_fn = LLVMGetNamedFunction(mod, "__zen_list_get")
    si get_fn == 0
        retorna 0
    args = [base, idx_val]
    retorna LLVMBuildCall(b, get_fn, args, 2, "lget")
funcion codegen_programa(estado, programa)
    codegen_declarar_externs(estado)
    i32 = LLVMInt32Type()
    main_type = LLVMFunctionType(i32, 0, 0)
    main_func = LLVMAddFunction(estado_modulo(estado), "main", main_type)
    entry = LLVMAppendBasicBlock(main_func, "entry")
    LLVMPositionBuilderAtEnd(estado_builder(estado), entry)
    para cada stmt en programa
        codegen_statement(estado, stmt)
    LLVMBuildRet(estado_builder(estado), LLVMConstInt(i32, 0, 0))
funcion codegen_compilar(estado, ruta_salida)
    LLVMPrintModuleToFile(estado_modulo(estado), ruta_salida, nada)
funcion codegen_finalize(estado)
    LLVMDisposeBuilder(estado_builder(estado))
    LLVMDisposeModule(estado_modulo(estado))
muestra "=== Codegen de Zen escrito en Zen ==="
muestra "Nodos: NumberLit, StringLit, BoolLit, NullLit, BinaryOp, UnaryOp"
muestra "       FuncCall(muestra/longitud/numero/texto/concat), Print, Assign, Return"
muestra "       FuncDecl(crear+body), ExprStmt, IfStmt(COND BR), WhileStmt(LOOP)"
muestra "FFI: 50+ funciones LLVM-C"
