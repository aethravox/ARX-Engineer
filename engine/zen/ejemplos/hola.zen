# hola.zen - Test basico para Zen
# Sin 'fin' — los bloques se cierran por indentacion como Python

muestra "Hola, mundo!"
muestra 42
muestra 3.14

x = 10
y = 20
muestra x + y

funcion saludar(nombre)
    muestra "Hola " + nombre

saludar("aethravox")

si x < y
    muestra "x es menor"
sino
    muestra "x es mayor"

para i desde 0 hasta 3
    muestra i
