# juego.zen - Adivina el numero secreto (con multiples intentos)

muestra "=========================================="
muestra "       ADIVINA EL NUMERO SECRETO          "
muestra "=========================================="
muestra "He pensado un numero entre 0 y 99."
muestra "Tienes 10 intentos. ¡Suerte!"
muestra ""

secreto = azar(100)

acertado = falso

para i desde 1 hasta 10
    muestra "=== Intento " + i + " de 10 ==="
    muestra "Introduce tu intento:"
    entrada = leer_linea()
    intento = numero(entrada)
    
    si intento == secreto
        muestra "¡INCREIBLE! ¡Le atinaste en " + i + " intentos!"
        acertado = verdad
        romper
    
    si intento < secreto
        muestra "  Muy bajo. El numero es mayor."
    sino
        muestra "  Muy alto. El numero es menor."
    muestra ""

si no acertado
    muestra ""
    muestra "=========================================="
    muestra "  GAME OVER - Se acaban tus intentos!"
    muestra "  El numero secreto era: " + secreto
    muestra "=========================================="

muestra ""
muestra "Gracias por jugar!"
