# match.zen - Demo de match/caso

# ---- Match con numeros ----
muestra "Dia de la semana:"
dia = 3
coincidir dia
    caso 1
        muestra "Lunes"
    caso 2
        muestra "Martes"
    caso 3
        muestra "Miercoles"
    caso 4
        muestra "Jueves"
    caso 5
        muestra "Viernes"
    caso 6
        muestra "Sabado"
    caso 7
        muestra "Domingo"
    por_defecto
        muestra "Dia invalido"

# ---- Match con strings ----
muestra ""
muestra "Saludo segun idioma:"
idioma = "en"
coincidir idioma
    caso "es"
        muestra "Hola!"
    caso "en"
        muestra "Hello!"
    caso "fr"
        muestra "Bonjour!"
    caso "de"
        muestra "Hallo!"
    por_defecto
        muestra "No entiendo ese idioma"

# ---- Match con calculo ----
muestra ""
muestra "Operacion:"
op = "+"
a = 10
b = 5
coincidir op
    caso "+"
        muestra a + b
    caso "-"
        muestra a - b
    caso "*"
        muestra a * b
    caso "/"
        muestra a / b
    por_defecto
        muestra "Operacion no soportada"

# ---- Match sin por_defecto ----
muestra ""
muestra "Match sin default:"
x = 5
coincidir x
    caso 1
        muestra "es uno"
    caso 5
        muestra "es cinco"

muestra "Fin del match"

# ---- Match con romper (aunque no es necesario porque no hay fallthrough) ----
muestra ""
muestra "Notas:"
nota = 85
coincidir nota
    caso 100
        muestra "Perfecto"
    caso 90
        muestra "Excelente"
    caso 80
        muestra "Muy bien"
    caso 70
        muestra "Bien"
    por_defecto
        muestra "Sigue esforzandote"

# ---- Match en ingles ----
muestra ""
muestra "Match in English:"
color = "red"
match color
    case "red"
        show "Rojo"
    case "blue"
        show "Azul"
    case "green"
        show "Verde"
    default
        show "Otro color"
