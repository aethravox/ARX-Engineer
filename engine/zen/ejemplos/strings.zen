# strings.zen — Demo de strings completos (Fase 1, Feature #1)

# ---- Comparación con == y != ----
saludo = "hola"
si saludo == "hola"
    muestra "Saludaste bien"
sino
    muestra "No saludaste"

si saludo != "chau"
    muestra "No es chau"

# ---- longitud() ----
s = "hola mundo"
muestra "Longitud de '" + s + "': " + longitud(s)

# ---- subtexto() ----
muestra "Sub [0:4]: " + subtexto(s, 0, 4)
muestra "Sub [5:10]: " + subtexto(s, 5, 10)

# ---- buscar() ----
muestra "Buscar 'mundo': " + buscar(s, "mundo")
muestra "Buscar 'xyz': " + buscar(s, "xyz")

# ---- reemplazar() ----
r = reemplazar(s, "mundo", "zen")
muestra "Reemplazo: " + r

# ---- mayusculas() / minusculas() ----
muestra "Mayus: " + mayusculas(s)
muestra "Minus: " + minusculas("HOLA Mundo")

# ---- recortar() ----
espacios = "   hola   "
muestra "Recortado: '" + recortar(espacios) + "'"

# ---- numero() — string a número ----
n = numero("42.5")
muestra "Numero + 1: " + (n + 1)

# ---- texto() — número a string ----
t = texto(3.14159)
muestra "Texto: " + t

# ---- Combinar todo ----
frase = "El gato es gris"
palabras_idx = buscar(frase, "gato")
muestra "Palabra encontrada en: " + palabras_idx
nueva_frase = reemplazar(frase, "gato", "perro")
muestra "Nueva frase: " + nueva_frase
muestra "Mayus: " + mayusculas(nueva_frase)
