#lang en

# Platform-conditional compilation example
# Build with: zen platform_en.zen --platform linux --run

show "Zen Lang - Platform Demo"
show ""

platform windows
    show "[Windows] Hello from Windows!"

platform linux
    show "[Linux] Hello from Linux!"

platform macos
    show "[macOS] Hello from macOS!"

platform android
    show "[Android] Hello from Android!"

show ""
show "This always runs (common code)"

# While loop demo
counter = 0
while counter < 5
    show "Counter: " + counter
    counter += 1

# Repeat demo
repeat 3 times
    show "Zen!"

# Break demo
for i from 1 to 10
    if i == 5
        break
    show i

# Ternary demo
x = 10
result = x > 5 ? "big" : "small"
show "x is " + result
