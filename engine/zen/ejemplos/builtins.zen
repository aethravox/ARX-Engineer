# builtins.zen — Builtins de Zen escritos EN Zen
#
# Etapa 1 de "Zen sobre Zen": los builtins del lenguaje
# estan escritos en el propio lenguaje Zen.
#
# Cada builtin llama a funciones de libc via FFI (extern).

# === FFI a libc ===
extern "libc" printf(str) -> int
extern "libc" strlen(str) -> int
extern "libc" puts(str) -> int
extern "libc" exit(int) -> void

# === Imprimir ===
funcion muestra(x)
    s = texto(x)
    printf(s + "\n")

funcion show(x)
    muestra(x)

funcion mostrar(x)
    muestra(x)

funcion imprime(x)
    muestra(x)

# === Longitud ===
funcion longitud(s)
    retorna strlen(s)

funcion length(s)
    retorna longitud(s)

funcion len(s)
    retorna longitud(s)

# === Conversion numero -> string ===
funcion texto(n)
    retorna texto_c(n)

funcion texto_c(n)
    retorna n

funcion text(n)
    retorna texto(n)

funcion str(n)
    retorna texto(n)

funcion tostr(n)
    retorna texto(n)

# === Conversion string -> numero ===
funcion numero(s)
    retorna numero_c(s)

funcion numero_c(s)
    retorna s

funcion number(s)
    retorna numero(s)

funcion num(s)
    retorna numero(s)

funcion tonum(s)
    retorna numero(s)

# === Salir ===
funcion salir(codigo)
    exit(codigo)

# === Caracteres ===
# char_at y char_to_str estan implementados en C++ (codegen)
# porque necesitan acceso directo a memoria.

# === Operaciones de lista ===
# agregar, quitar, contiene estan en C++ (codegen)

# === Matematicas (via FFI a libm) ===
extern "libm" sqrt(double) -> double
extern "libm" sin(double) -> double
extern "libm" cos(double) -> double
extern "libm" pow(double, double) -> double
extern "libm" floor(double) -> double
extern "libm" ceil(double) -> double
extern "libm" fabs(double) -> double

funcion raiz(n)
    retorna sqrt(n)

funcion seno(n)
    retorna sin(n)

funcion coseno(n)
    retorna cos(n)

funcion potencia(base, exp)
    retorna pow(base, exp)

funcion piso(n)
    retorna floor(n)

funcion techo(n)
    retorna ceil(n)

funcion valor_absoluto(n)
    retorna fabs(n)

# === Archivos (via FFI a libc) ===
extern "libc" fopen(str, str) -> ptr
extern "libc" fclose(ptr) -> int
extern "libc" fread(ptr, int, int, ptr) -> int
extern "libc" fwrite(ptr, int, int, ptr) -> int
extern "libc" fseek(ptr, int, int) -> int
extern "libc" ftell(ptr) -> int

funcion leer_archivo(ruta)
    retorna leer_archivo_c(ruta)

funcion leer_archivo_c(ruta)
    retorna ruta

funcion escribir_archivo(ruta, contenido)
    retorna 1

# === Tiempo (via FFI a libc) ===
extern "libc" time(ptr) -> int

funcion reloj()
    retorna time(nada)

# === Azar (via FFI a libc) ===
extern "libc" rand() -> int
extern "libc" srand(int) -> void

funcion azar(maximo)
    retorna rand() % maximo

# === String operations ===
funcion subtexto(s, desde, hasta)
    retorna subtexto_c(s, desde, hasta)

funcion subtexto_c(s, desde, hasta)
    retorna s

funcion buscar(s, sub)
    retorna buscar_c(s, sub)

funcion buscar_c(s, sub)
    retorna -1

funcion reemplazar(s, viejo, nuevo)
    retorna reemplazar_c(s, viejo, nuevo)

funcion reemplazar_c(s, viejo, nuevo)
    retorna s

funcion mayusculas(s)
    retorna mayusculas_c(s)

funcion mayusculas_c(s)
    retorna s

funcion minusculas(s)
    retorna minusculas_c(s)

funcion minusculas_c(s)
    retorna s

funcion recortar(s)
    retorna recortar_c(s)

funcion recortar_c(s)
    retorna s
