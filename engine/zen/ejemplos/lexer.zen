
Token {tipo, valor, linea, col}

extern "libc" printf(str) -> int
extern "libc" strlen(str) -> int

funcion es_digito(c)
    retorna c >= 48 y c <= 57
funcion es_letra(c)
    retorna (c >= 97 y c <= 122) o (c >= 65 y c <= 90) o c == 95
funcion es_alfa_num(c)
    retorna es_letra(c) o es_digito(c)
funcion tipo_keyword(palabra)
    si palabra == "si" o palabra == "if"
        retorna 4
    si palabra == "sino" o palabra == "else"
        retorna 5
    si palabra == "mientras" o palabra == "while"
        retorna 10
    si palabra == "para" o palabra == "for"
        retorna 7
    si palabra == "funcion" o palabra == "function"
        retorna 17
    si palabra == "retorna" o palabra == "return"
        retorna 18
    si palabra == "muestra" o palabra == "show" o palabra == "print"
        retorna 19
    si palabra == "verdad" o palabra == "yes"
        retorna 34
    si palabra == "falso"
        retorna 35
    si palabra == "nada" o palabra == "nothing"
        retorna 36
    retorna 3
funcion tokenizar(codigo)
    tokens = []
    len = longitud(codigo)
    pos = 0
    linea = 1
    mientras pos < len
        c = char_at(codigo, pos)
        si c == 32 o c == 9
            pos = pos + 1
            continuar
        si c == 10
            agregar(tokens, Token {tipo: 67, valor: "NEWLINE", linea: linea, col: pos})
            pos = pos + 1
            linea = linea + 1
            continuar
        si c == 35
            mientras pos < len y char_at(codigo, pos) != 10
                pos = pos + 1
            continuar
        si c == 34 o c == 39
            comilla = c
            pos = pos + 1
            valor = ""
            mientras pos < len
                ch = char_at(codigo, pos)
                si ch == comilla
                    pos = pos + 1
                    romper
                valor = valor + char_to_str(ch)
                pos = pos + 1
            agregar(tokens, Token {tipo: 2, valor: valor, linea: linea, col: pos})
            continuar
        si es_digito(c)
            valor = ""
            mientras pos < len
                ch = char_at(codigo, pos)
                si es_digito(ch) o ch == 46
                    valor = valor + char_to_str(ch)
                    pos = pos + 1
                sino
                    romper
            agregar(tokens, Token {tipo: 1, valor: valor, linea: linea, col: pos})
            continuar
        si es_letra(c)
            valor = ""
            mientras pos < len
                ch = char_at(codigo, pos)
                si es_alfa_num(ch)
                    valor = valor + char_to_str(ch)
                    pos = pos + 1
                sino
                    romper
            tipo = tipo_keyword(valor)
            agregar(tokens, Token {tipo: tipo, valor: valor, linea: linea, col: pos})
            continuar
        si pos + 1 < len
            c2 = char_at(codigo, pos + 1)
            si c == 61 y c2 == 61
                agregar(tokens, Token {tipo: 43, valor: "==", linea: linea, col: pos})
                pos = pos + 2
                continuar
            si c == 33 y c2 == 61
                agregar(tokens, Token {tipo: 44, valor: "!=", linea: linea, col: pos})
                pos = pos + 2
                continuar
            si c == 60 y c2 == 61
                agregar(tokens, Token {tipo: 47, valor: "<=", linea: linea, col: pos})
                pos = pos + 2
                continuar
            si c == 62 y c2 == 61
                agregar(tokens, Token {tipo: 48, valor: ">=", linea: linea, col: pos})
                pos = pos + 2
                continuar
            si c == 45 y c2 == 62
                agregar(tokens, Token {tipo: 56, valor: "->", linea: linea, col: pos})
                pos = pos + 2
                continuar
        si c == 43
            agregar(tokens, Token {tipo: 37, valor: "+", linea: linea, col: pos})
        sino
            si c == 45
                agregar(tokens, Token {tipo: 38, valor: "-", linea: linea, col: pos})
            sino
                si c == 42
                    agregar(tokens, Token {tipo: 39, valor: "*", linea: linea, col: pos})
                sino
                    si c == 47
                        agregar(tokens, Token {tipo: 40, valor: "/", linea: linea, col: pos})
                    sino
                        si c == 61
                            agregar(tokens, Token {tipo: 49, valor: "=", linea: linea, col: pos})
                        sino
                            si c == 60
                                agregar(tokens, Token {tipo: 45, valor: "<", linea: linea, col: pos})
                            sino
                                si c == 62
                                    agregar(tokens, Token {tipo: 46, valor: ">", linea: linea, col: pos})
                                sino
                                    si c == 40
                                        agregar(tokens, Token {tipo: 57, valor: "(", linea: linea, col: pos})
                                    sino
                                        si c == 41
                                            agregar(tokens, Token {tipo: 58, valor: ")", linea: linea, col: pos})
                                        sino
                                            si c == 44
                                                agregar(tokens, Token {tipo: 63, valor: ",", linea: linea, col: pos})
                                            sino
                                                si c == 46
                                                    agregar(tokens, Token {tipo: 64, valor: ".", linea: linea, col: pos})
                                                sino
                                                    si c == 58
                                                        agregar(tokens, Token {tipo: 65, valor: ":", linea: linea, col: pos})
                                                    sino
                                                        si c == 91
                                                            agregar(tokens, Token {tipo: 59, valor: "[", linea: linea, col: pos})
                                                        sino
                                                            si c == 93
                                                                agregar(tokens, Token {tipo: 60, valor: "]", linea: linea, col: pos})
                                                            sino
                                                                si c == 123
                                                                    agregar(tokens, Token {tipo: 61, valor: "{", linea: linea, col: pos})
                                                                sino
                                                                    si c == 125
                                                                        agregar(tokens, Token {tipo: 62, valor: "}", linea: linea, col: pos})
        pos = pos + 1
    agregar(tokens, Token {tipo: 0, valor: "EOF", linea: linea, col: pos})
    retorna tokens
muestra "=== Lexer de Zen escrito en Zen ==="

codigo = "muestra 42"
muestra "Tokenizando: " + codigo
tokens = tokenizar(codigo)
muestra "Tokens generados: " + longitud(tokens)
muestra "Lexer en Zen funcionando!"