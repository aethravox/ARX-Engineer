extern "libc" printf(str) -> int

ESC = char_to_str(27)
czl_archivos = 0
czl_codigo = 0
czl_comentarios = 0
czl_vacias = 0
czl_total = 0

funcion contar_archivo(ruta)
    codigo = leer_archivo(ruta)
    si longitud(codigo) == 0
        retorna 0
    len = longitud(codigo)
    pos = 0
    linicio = verdad
    es_com = falso
    tiene_cod = falso
    mientras pos < len
        c = char_at(codigo, pos)
        si linicio == verdad
            es_com = falso
            tiene_cod = falso
            linicio = falso
        si c == 35
            es_com = verdad
        si c == 10
            czl_total = czl_total + 1
            si es_com == verdad
                czl_comentarios = czl_comentarios + 1
            sino
                si tiene_cod == falso
                    czl_vacias = czl_vacias + 1
                sino
                    czl_codigo = czl_codigo + 1
            linicio = verdad
            es_com = falso
            tiene_cod = falso
        sino
            si c != 32
                si c != 9
                    si es_com == falso
                        tiene_cod = verdad
        pos = pos + 1
    czl_total = czl_total + 1
    si es_com == verdad
        czl_comentarios = czl_comentarios + 1
    sino
        si tiene_cod == falso
            czl_vacias = czl_vacias + 1
        sino
            czl_codigo = czl_codigo + 1
    czl_archivos = czl_archivos + 1

header = ESC + "[1;36m========================================" + ESC + "[0m"
title = ESC + "[1;36m CZL - Counting Zen Lines" + ESC + "[0m"
sep = ESC + "[0;37m----------------------------------------" + ESC + "[0m"
lang_hdr = ESC + "[1;33m Lang        Files      Lines       Code   Comments    Blanks" + ESC + "[0m"
reset = ESC + "[0m"
green = ESC + "[1;32m"
cyan = ESC + "[1;36m"
muestra header
muestra title
muestra header
muestra ""
contar_archivo("src/ast.zen")
contar_archivo("src/builtins.zen")
contar_archivo("src/codegen.zen")
contar_archivo("src/lexer.zen")
contar_archivo("src/main.zen")
contar_archivo("src/parser.zen")
muestra lang_hdr
muestra sep
muestra green + " Zen            " + czl_archivos + "        " + czl_total + "       " + czl_codigo + "       " + czl_comentarios + "        " + czl_vacias + reset
muestra sep
muestra cyan + " Total          " + czl_archivos + "        " + czl_total + "       " + czl_codigo + "       " + czl_comentarios + "        " + czl_vacias + reset
muestra header
