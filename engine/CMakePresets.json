{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (auto platform)",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ARX_BUILD_EDITOR": "ON",
                "ARX_BUILD_RUNTIME": "ON",
                "ARX_BUILD_TOOLS": "ON"
            }
        },
        {
            "name": "windows-x64",
            "displayName": "Windows x64 (MSVC)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-x64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ARX_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "linux-x64",
            "displayName": "Linux x64 (GCC/Clang)",
            "binaryDir": "${sourceDir}/build/linux-x64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "ARX_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (ASan)",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_INIT":   "-fsanitize=address -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS_INIT": "-fsanitize=address -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS_INIT": "-fsanitize=address"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android arm64-v8a (NDK)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/android-arm64",
            "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-24",
                "CMAKE_BUILD_TYPE": "Release",
                "ARX_BUILD_EDITOR": "OFF",
                "ARX_BUILD_RUNTIME": "ON"
            }
        },
        {
            "name": "web-html5",
            "displayName": "Web/HTML5 (Emscripten)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/web-html5",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ARX_BUILD_EDITOR": "OFF",
                "ARX_BUILD_RUNTIME": "ON",
                "CMAKE_EXECUTABLE_SUFFIX": ".html"
            }
        }
    ],
    "buildPresets": [
        { "name": "default",    "configurePreset": "default" },
        { "name": "windows-x64","configurePreset": "windows-x64", "configuration": "Release" },
        { "name": "linux-x64",  "configurePreset": "linux-x64" },
        { "name": "linux-debug","configurePreset": "linux-debug" },
        { "name": "android-arm64","configurePreset": "android-arm64" },
        { "name": "web-html5",  "configurePreset": "web-html5" }
    ]
}
