import os

# =============================================================
# ARX ENGINE - CLIENTE (Visor) - Windows
# Compilar: scons
# Librerias: raylib, assimp, imgui, Jolt, glm, zlib
# Todas desde third_Party (no requiere instalacion externa)
# =============================================================

env = Environment(tools=['mingw', 'g++', 'gnulink', 'ar'])

# Rutas base
base_dir = Dir('#').abspath
third_party = os.path.join(base_dir, '..', '..', '..', 'third_Party')
common_dir  = os.path.join(base_dir, '..', '..', '..', 'common')
motor_path  = os.path.join(base_dir, '..', '..', '..', 'Motor', 'platform', 'windows')

# Incluir todas las cabeceras
# Nota: raylib, imgui se incluyen SIN prefijo; Jolt/assimp/glm CON prefijo
env.Append(CPPPATH=[
    os.path.join(third_party, 'Include', 'raylib'),
    os.path.join(third_party, 'Include'),          # assimp, glm, Jolt (se incluyen con prefijo)
    os.path.join(third_party, 'Include', 'imgui'),
    common_dir,
    '#',
    motor_path,
    motor_path + '/core'
])

# Ruta de librerias estaticas (Windows)
env.Append(LIBPATH=[os.path.join(third_party, 'Windows')])

# Librerias estaticas de third_Party + sistema
env.Append(LIBS=[
    'raylib',
    'imgui',
    'Jolt',
    'assimp',
    'zlibstatic',
    'opengl32',
    'gdi32',
    'winmm',
    'shell32',
])

env.Append(CXXFLAGS=['-std=c++17', '-O2', '-Wall'])

# Enlace estatico para Windows (sin -mwindows para Cliente)
env.Append(LINKFLAGS=[
    '-Wl,-e,mainCRTStartup',
    '-static-libgcc',
    '-static-libstdc++',
    '-static'
])

env.Program(
    target='bin/windows/ARX_Cliente',
    source=['main.cpp', os.path.join(common_dir, 'ARX_PlatformImpl.cpp')]
)

print("\n[ARX Engine] Cliente (Windows) configurado.")
print("[!] Librerias: raylib, imgui, Jolt Physics, Assimp, GLM, zlib")
print("[!] Ejecutable: bin/windows/ARX_Cliente.exe")
print("[!] Coloca el .asx junto al ejecutable o en bin/windows/")
